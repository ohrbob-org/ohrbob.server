@model Ohrbob.Server.Shared.Data.Profile

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="page-head">
    <div class="page-head__text">
        <p class="metro-kicker" aria-hidden="true">profiles</p>
        <h1 class="metro-title metro-title--compact">edit profile</h1>
    </div>
</div>

<form asp-action="Edit" class="profile-form profile-form--wide">
    <div class="profile-form__col">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="AccountId" />

        <div class="form-group">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        @await Html.PartialAsync("_ColorPicker", Model)

        <div class="form-group">
            <label class="form-label">Stream Token</label>
            <input type="text" class="form-control profile-token" value="@Model.StreamToken" readonly />
            <p class="metro-hint">Stream tokens are generated automatically and cannot be changed.</p>
        </div>
    </div>

    <div class="profile-form__col profile-form__col--stations">
        @{ var stationsList = ViewBag.Stations as IEnumerable<Ohrbob.Server.Shared.Requests.StationWithFeedsDto>; }
        <fieldset class="profile-stations">
            <legend class="form-label">Allowed Stations</legend>
            @if (stationsList != null && stationsList.Any())
            {
                var allowed = Model.AllowedStationIds?.ToList() ?? new List<string>();
                <div class="profile-station-grid">
                    @foreach (var station in stationsList)
                    {
                        var isChecked = allowed.Contains(station.Station.Id) ? "checked" : "";
                        var feedCount = station.Feeds?.Count ?? 0;
                        string gridClass = "collage-grid-1";
                        if (feedCount > 1 && feedCount <= 4) gridClass = "collage-grid-2";
                        else if (feedCount > 4 && feedCount <= 9) gridClass = "collage-grid-3";
                        else if (feedCount > 9) gridClass = "collage-grid-4";

                        var displayFeeds = station.Feeds?.Take(16).ToList() ?? new List<Ohrbob.Server.Shared.Requests.FeedStatsDto>();

                        <div class="profile-station-tile">
                            <input type="checkbox" class="btn-check" name="selectedStations" value="@station.Station.Id" id="station_@station.Station.Id" @isChecked autocomplete="off">
                            <label class="profile-station-tile__label" for="station_@station.Station.Id">
                                <span class="profile-station-tile__art collage-container @gridClass">
                                    @if (!displayFeeds.Any())
                                    {
                                        <span class="collage-fallback">?</span>
                                    }
                                    else
                                    {
                                        @foreach (var feed in displayFeeds)
                                        {
                                            var feedInitial = (feed.Title.Length > 0 ? feed.Title[0].ToString() : "?").ToUpper();
                                            if (!string.IsNullOrEmpty(feed.ImageUrl))
                                            {
                                                <img src="@feed.ImageUrl" class="collage-item" alt="@feed.Title" onerror="this.outerHTML='<span class=\'collage-fallback\'>@feedInitial</span>'" />
                                            }
                                            else
                                            {
                                                <span class="collage-fallback">@feedInitial</span>
                                            }
                                        }
                                    }
                                </span>
                                <span class="station-check-overlay" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                                <span class="profile-station-tile__body">
                                    <span class="profile-station-tile__name" title="@station.Station.Name">@station.Station.Name</span>
                                    <span class="profile-station-tile__meta">@feedCount @(feedCount == 1 ? "feed" : "feeds")</span>
                                </span>
                            </label>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="profile-stations__empty">
                    You don't have any stations assigned to this profile yet.
                    Go to <a asp-controller="Stations" asp-action="Index">Stations</a> to create some, or use the Discover tab.
                </p>
            }
        </fieldset>
    </div>

    <div class="profile-form__actions form-actions">
        <input type="submit" value="Save" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-ghost">Back to List</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
