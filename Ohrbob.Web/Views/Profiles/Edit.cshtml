@model Ohrbob.Server.Shared.Data.Profile

@{
    ViewData["Title"] = "Edit Profile";
}

<h1>Edit Profile</h1>

<h4>Profile</h4>
<hr />
<div class="row">
    <div class="col-12">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="AccountId" />
            
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label class="control-label">Stream Token</label>
                <input type="text" class="form-control" value="@Model.StreamToken" readonly />
                <small class="text-muted">Stream tokens are generated automatically and cannot be changed.</small>
            </div>

            <div class="form-group mb-4">
                <label class="control-label fw-bold">Allowed Stations</label>
                <div class="border rounded p-3">
                @{ var stationsList = ViewBag.Stations as IEnumerable<Ohrbob.Server.Shared.Requests.StationWithFeedsDto>; }
                @if (stationsList != null && stationsList.Any())
                {
                    var allowed = Model.AllowedStationIds?.ToList() ?? new List<string>();
                    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-6 g-3 mt-1">
                    @foreach (var station in stationsList)
                    {
                        var isChecked = allowed.Contains(station.Station.Id) ? "checked" : "";
                        var feedCount = station.Feeds?.Count ?? 0;
                        string gridClass = "collage-grid-1";
                        if (feedCount > 1 && feedCount <= 4) gridClass = "collage-grid-2";
                        else if (feedCount > 4 && feedCount <= 9) gridClass = "collage-grid-3";
                        else if (feedCount > 9) gridClass = "collage-grid-4";
                        
                        var displayFeeds = station.Feeds?.Take(16).ToList() ?? new List<Ohrbob.Server.Shared.Requests.FeedStatsDto>();

                        <div class="col">
                            <input type="checkbox" class="btn-check" name="selectedStations" value="@station.Station.Id" id="station_@station.Station.Id" @isChecked autocomplete="off">
                            <label class="w-100 p-0 text-start h-100 overflow-hidden d-block cursor-pointer" for="station_@station.Station.Id">
                                <div class="card h-100 border-0 bg-transparent position-relative">
                                    <div class="station-check-overlay">
                                        <i class="bi bi-check-circle-fill"></i>
                                    </div>
                                    <div class="collage-container @gridClass card-img-top">
                                        @if (!displayFeeds.Any())
                                        {
                                            <div class="collage-fallback">?</div>
                                        }
                                        else
                                        {
                                            @foreach (var feed in displayFeeds)
                                            {
                                                if (!string.IsNullOrEmpty(feed.ImageUrl))
                                                {
                                                    <img src="@feed.ImageUrl" class="collage-item" alt="@feed.Title" onerror="this.outerHTML='<div class=\'collage-fallback\'>@((feed.Title.Length > 0 ? feed.Title[0].ToString() : "?").ToUpper())</div>'" />
                                                }
                                                else
                                                {
                                                    <div class="collage-fallback">@((feed.Title.Length > 0 ? feed.Title[0].ToString() : "?").ToUpper())</div>
                                                }
                                            }
                                        }
                                    </div>
                                    <div class="card-body p-2">
                                        <h6 class="card-title text-truncate mb-0" title="@station.Station.Name">@station.Station.Name</h6>
                                        <small>@feedCount feeds</small>
                                    </div>
                                </div>
                            </label>
                        </div>
                    }
                    </div>
                }
                else
                {
                    <div class="alert alert-info mb-0">
                        You don't have any stations assigned to this profile yet. 
                        Go to <a asp-controller="Stations" asp-action="Index">Stations</a> to create some, or use the Discover tab.
                    </div>
                }
                </div>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
