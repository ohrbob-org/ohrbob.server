@model IEnumerable<Ohrbob.Server.Shared.Data.Profile>

@{
    ViewData["Title"] = "Profiles";
    var activeProfileId = Context.Request.Cookies["Ohrbob_ActiveProfileId"];
}

<h1>Profiles</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Profile</a>
</p>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
    @foreach (var item in Model)
    {
        var gradientIndex = Math.Abs(item.Id.GetHashCode()) % 16;
        var initial = string.IsNullOrEmpty(item.Name) ? "?" : item.Name[0].ToString().ToUpper();
        
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="profile-avatar profile-gradient-@gradientIndex card-img-top">
                    @initial
                </div>
                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text">
                        <small class="text-muted d-block text-truncate" title="@item.StreamToken">
                            Token: <code>@item.StreamToken</code>
                        </small>
                        <small class="text-muted d-block mt-1">
                            <i class="bi bi-broadcast"></i> @(item.AllowedStationIds?.Length ?? 0) allowed stations
                        </small>
                    </p>
                </div>
                <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Are you sure you want to delete this profile?');">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
