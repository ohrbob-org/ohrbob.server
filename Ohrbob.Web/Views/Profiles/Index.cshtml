@model IEnumerable<Ohrbob.Server.Shared.Data.Profile>
@using Ohrbob.Server.Shared.Data

@{
    ViewData["Title"] = "Profiles";
    var activeProfileId = Context.Request.Cookies["Ohrbob_ActiveProfileId"];
    var profiles = Model.ToList();
}

<div class="page-head">
    <div class="page-head__text">
        <p class="metro-kicker">your profiles</p>
        <h1 class="metro-title metro-title--compact">profiles</h1>
    </div>
    <a asp-action="Create" class="page-head__action">
        <i class="bi bi-plus-lg" aria-hidden="true"></i> new profile
    </a>
</div>

<div class="profile-grid">
    @foreach (var item in profiles)
    {
        var initial = string.IsNullOrEmpty(item.Name) ? "?" : item.Name[0].ToString().ToUpper();
        var isActive = item.Id == activeProfileId;
        var color = ProfileColors.Resolve(item);
        var avatarInk = ProfileColorInk.For(color);

        <article class="profile-card @(isActive ? "is-active" : "")">
            <div class="profile-card__head">
                <div class="profile-avatar" data-profile-id="@item.Id" style="background-color: @color; color: @avatarInk" aria-hidden="true">@initial</div>
                <div class="profile-card__identity">
                    <h2 class="profile-card__name" title="@item.Name">@item.Name</h2>
                    @if (isActive)
                    {
                        <p class="profile-active">active</p>
                    }
                </div>
            </div>

            <div class="profile-card__meta">
                <p class="profile-card__token" title="@item.StreamToken">
                    <span class="profile-card__label">token</span>
                    <code>@item.StreamToken</code>
                </p>
                <p class="profile-card__stations">
                    <i class="bi bi-broadcast" aria-hidden="true"></i>
                    @(item.AllowedStationIds?.Length ?? 0) allowed stations
                </p>
            </div>

            <div class="profile-card__actions">
                <a asp-action="Edit" asp-route-id="@item.Id" class="profile-card__action">Edit</a>
                <div class="profile-card__actions-group">
                    @if (!isActive)
                    {
                        <form asp-action="Select" method="post">
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <button type="submit" class="profile-card__action is-primary">Listen</button>
                        </form>
                    }
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" hx-target="#main-content" hx-swap="innerHTML" id="delete-profile-form-@item.Id">
                        <button type="button" class="profile-card__action is-danger"
                                onclick="window.showConfirmationModal('Are you sure you want to delete this profile?', () => { document.getElementById('delete-profile-form-@item.Id').requestSubmit(); });"
                                @(profiles.Count <= 1 ? "disabled" : "")>Delete</button>
                    </form>
                </div>
            </div>
        </article>
    }
</div>
