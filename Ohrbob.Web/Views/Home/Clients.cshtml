@{
    ViewData["Title"] = "Clients";
}

<div class="editorial">
    <header class="editorial-head editorial-head--center">
        <p class="metro-kicker">everywhere</p>
        <h1 class="metro-title metro-title--compact">Ohrbob Clients</h1>
        <p class="editorial-lede">Ohrbob is available on multiple platforms. Choose the client that fits your device to keep your podcasts synced everywhere.</p>
    </header>

    <div class="client-grid">
        <article class="client-tile">
            <span class="client-tile__icon"><i class="bi bi-browser-chrome" aria-hidden="true"></i></span>
            <div class="client-tile__body">
                <h2 class="client-tile__name">Web</h2>
                <p class="client-tile__copy">No installation needed. Simply log-in in your browser to listen and manage your stations on any device.</p>
                <div class="client-tile__action-row">
                    <a asp-controller="Home" asp-action="Login" class="client-tile__action" hx-boost="false">Open Web App</a>
                </div>
            </div>
        </article>

        <article class="client-tile">
            <span class="client-tile__icon"><i class="bi bi-android2" aria-hidden="true"></i></span>
            <div class="client-tile__body">
                <h2 class="client-tile__name">Android</h2>
                <p class="client-tile__copy">Take your podcasts on the go with Android Auto support.</p>
                <div class="client-tile__action-row">
                    <a href="https://play.google.com/store/apps/details?id=org.ohrbob.App" target="_blank" rel="noopener" class="client-tile__action"><i class="bi bi-google-play" aria-hidden="true"></i> Google Play</a>
                    <a href="https://www.amazon.de/gp/product/B0HQXV564X" target="_blank" rel="noopener" class="client-tile__action client-tile__action--ghost"><i class="bi bi-amazon" aria-hidden="true"></i> Amazon</a>
                </div>
            </div>
        </article>

        <article class="client-tile">
            <span class="client-tile__icon"><i class="bi bi-ubuntu" aria-hidden="true"></i></span>
            <div class="client-tile__body">
                <h2 class="client-tile__name">AppImage <span class="client-tile__variant">(Linux)</span></h2>
                <p class="client-tile__copy">A standalone application format for Linux. Download and run it directly.</p>
                <div class="client-tile__action-row">
                    <a href="https://github.com/ohrbob-org/ohrbob.app/releases" target="_blank" rel="noopener" class="client-tile__action"><i class="bi bi-download" aria-hidden="true"></i> Download AppImage</a>
                </div>
            </div>
        </article>

        <article class="client-tile">
            <span class="client-tile__icon"><i class="bi bi-windows" aria-hidden="true"></i></span>
            <div class="client-tile__body">
                <h2 class="client-tile__name">Windows</h2>
                <p class="client-tile__copy">Native Windows application. Download the installer executable.</p>
                <div class="client-tile__action-row">
                    <a href="https://github.com/ohrbob-org/ohrbob.app/releases" target="_blank" rel="noopener" class="client-tile__action"><i class="bi bi-download" aria-hidden="true"></i> Download Installer</a>
                </div>
            </div>
        </article>

        <article class="client-tile">
            <span class="client-tile__icon"><i class="bi bi-box" aria-hidden="true"></i></span>
            <div class="client-tile__body">
                <h2 class="client-tile__name">Flatpak <span class="client-tile__variant">(Linux)</span></h2>
                <p class="client-tile__copy">Run Ohrbob securely on any Linux distribution using Flatpak.</p>
                <span class="client-tile__soon">Coming soon</span>
            </div>
        </article>

        <article class="client-tile">
            <span class="client-tile__icon"><i class="bi bi-apple" aria-hidden="true"></i></span>
            <div class="client-tile__body">
                <h2 class="client-tile__name">macOS</h2>
                <p class="client-tile__copy">Native macOS application.</p>
                <span class="client-tile__soon">Coming soon</span>
            </div>
        </article>

        <article class="client-tile">
            <span class="client-tile__icon"><i class="bi bi-phone" aria-hidden="true"></i></span>
            <div class="client-tile__body">
                <h2 class="client-tile__name">iOS</h2>
                <p class="client-tile__copy">Take your podcasts on the go with your iPhone.</p>
                <span class="client-tile__soon">Coming soon</span>
            </div>
        </article>
    </div>
</div>
