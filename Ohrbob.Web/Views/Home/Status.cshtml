@model Ohrbob.Web.Models.AboutViewModel
@{
    ViewData["Title"] = "System Status";
}

<div class="editorial">
    <header class="editorial-head">
        <div class="ohrbob-logo ohrbob-logo-left status-logo">
            <span class="ohrbob-logo-icon"><img src="~/images/ohrbob-logo.svg" alt="ohrbob" /></span>
            <span class="ohrbob-logo-text">
                <span class="char-1">o</span><span class="char-2">h</span><span class="char-3">r</span><span class="char-4">b</span><span class="char-5">o</span><span class="char-6">b</span>
            </span>
        </div>
        <p class="metro-kicker">live</p>
        <h1 class="metro-title metro-title--compact">System Status</h1>
        <p class="editorial-lede">Real-time health overview of the Ohrbob infrastructure and ecosystem.</p>
    </header>

    <div id="about-status" hx-get="/Home/AboutStatus" hx-target="#about-status" hx-trigger="every 5s" hx-swap="innerHTML" hx-boost="false">
        @await Html.PartialAsync("_AboutStatus", Model)
    </div>

    <div class="status-facts">
        <div class="status-fact">
            <i class="bi bi-collection-play" aria-hidden="true"></i>
            <h2 class="status-fact__title">Stations</h2>
            <p class="status-fact__copy">Group feeds with random or chronological strategies.</p>
        </div>
        <div class="status-fact">
            <i class="bi bi-people" aria-hidden="true"></i>
            <h2 class="status-fact__title">Profiles</h2>
            <p class="status-fact__copy">Separate listen state per person, per device.</p>
        </div>
        <div class="status-fact">
            <i class="bi bi-code-slash" aria-hidden="true"></i>
            <h2 class="status-fact__title">Open source</h2>
            <p class="status-fact__copy">Host it yourself or contribute on GitHub.</p>
        </div>
    </div>

    <p class="status-footnote">Web &rarr; Api &rarr; Player &rarr; MongoDB &middot; Built with ASP.NET Core (.NET 10) &amp; Bootstrap 5</p>
</div>
