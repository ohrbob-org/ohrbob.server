@{
    ViewData["Title"] = "Service Unavailable";
    Layout = "_Layout_Minimal";
}

<div class="metro-error">
    <div class="metro-panel metro-panel--danger">
        <div class="metro-panel__icon"><i class="bi bi-hdd-network" aria-hidden="true"></i></div>
        <h1 class="metro-panel__title">Service Unavailable</h1>
        <p class="metro-panel__body">
            Ohrbob is currently unable to connect to its backend services.
            Please ensure the API and database are running.
        </p>
        <button type="button" class="metro-panel__action" onclick="history.back();">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Try Again
        </button>
    </div>
</div>
