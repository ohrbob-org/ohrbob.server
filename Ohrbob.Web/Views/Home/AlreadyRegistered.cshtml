@{
    ViewData["Title"] = "Already registered";
    Layout = "_Layout_Minimal";
}

<div class="metro-error">
    <div class="metro-panel metro-panel--warning">
        <div class="metro-panel__icon"><i class="bi bi-person-exclamation" aria-hidden="true"></i></div>
        <h1 class="metro-panel__title">Already registered</h1>
        <p class="metro-panel__body">
            You are already registered with another identity provider.
            Please sign in with the provider you used the first time.
        </p>
        <a asp-controller="Home" asp-action="Login" class="metro-panel__action" hx-boost="false">
            <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i> Back to sign in
        </a>
    </div>
</div>
