        <div class="d-grid gap-3">
            @if (ViewBag.NextcloudEnabled == true)
            {
                <a asp-controller="Home" asp-action="Login" asp-route-provider="Nextcloud" asp-route-returnUrl="@ViewBag.ReturnUrl" class="btn btn-outline-primary btn-lg rounded-pill login-btn" hx-boost="false">
                    <i class="bi bi-cloud-fill me-2"></i> Continue with Nextcloud
                </a>
            }
            @if (ViewBag.GoogleEnabled == true)
            {
                <a asp-controller="Home" asp-action="Login" asp-route-provider="Google" asp-route-returnUrl="@ViewBag.ReturnUrl" class="btn btn-outline-danger btn-lg rounded-pill login-btn" hx-boost="false">
                    <i class="bi bi-google me-2"></i> Continue with Google
                </a>
            }
            @if (ViewBag.AmazonEnabled == true)
            {
                <div class="dropdown d-grid">
                    <button class="btn btn-outline-dark btn-lg rounded-pill dropdown-toggle w-100" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-amazon me-2"></i> Continue with Amazon
                    </button>
                    <ul class="dropdown-menu w-100 shadow">
                        @foreach (var region in OidcProviderConfig.AmazonRegions)
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="Home" asp-action="Login" asp-route-provider="Amazon" asp-route-region="@region.Code" asp-route-returnUrl="@ViewBag.ReturnUrl" hx-boost="false">
                                    @region.Name <span class="text-muted small">(@region.Domain)</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
            @if (ViewBag.GitHubEnabled == true)
            {
                <a asp-controller="Home" asp-action="Login" asp-route-provider="GitHub" asp-route-returnUrl="@ViewBag.ReturnUrl" class="btn btn-outline-dark btn-lg rounded-pill login-btn" hx-boost="false">
                    <i class="bi bi-github me-2"></i> Continue with GitHub
                </a>
            }
        </div>
    </div>
</div>

@section Scripts {
    <style>
        #lynx-head {
            transform-origin: center center;
            transition: transform 0.1s ease-out;
        }
        #lynx-head.is-nodding {
            animation: nod 0.5s ease-in-out forwards;
        }
        @@keyframes nod {
            0% { transform: translateY(0) scaleY(1); }
            40% { transform: translateY(0.15px) scaleY(0.95); }
            100% { transform: translateY(0) scaleY(1); }
        }
    </style>
    
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const eyeL = document.getElementById("Eye");
            const eyeR = document.getElementById("Eye_mirrored");
            
            // Eye tracking
            document.addEventListener("mousemove", (e) => {
                if (!eyeL || !eyeR) return;
                
                const maxMovement = 0.22; // Increased for more vivid eye rolling

                // Calculate center of screen
                const centerX = window.innerWidth / 2;
                const centerY = window.innerHeight / 4 ;

                // Delta from center
                const deltaX = Math.max(-1,Math.min((e.clientX - centerX) / centerX,1));
                const deltaY = Math.max(0,Math.min((e.clientY - centerY) / centerY,1));

                // Apply clamped transform
                const moveX = deltaX * maxMovement;
                const moveY = deltaY * maxMovement;
                
                eyeL.setAttribute("transform", `translate(${moveX}, ${moveY})`);
                eyeR.setAttribute("transform", `translate(${moveX}, ${moveY})`);
            });

            // Nodding animation
            const lynxHead = document.getElementById("lynx-head");
            const loginBtns = document.querySelectorAll(".login-btn");

            loginBtns.forEach(btn => {
                btn.addEventListener("click", (e) => {
                    if (e.ctrlKey || e.metaKey || e.shiftKey || e.button !== 0) {
                        return;
                    }
                    e.preventDefault();
                    if (!lynxHead) {
                        window.location.href = btn.href;
                        return;
                    }
                    
                    lynxHead.classList.add("is-nodding");
                    
                    // Wait for animation, then redirect
                    setTimeout(() => {
                        window.location.href = btn.href;
                    }, 500); 
                });
            });
        });
    </script>
}
