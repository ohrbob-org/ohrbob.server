@{
    ViewData["Title"] = "Log in";
}

<div class="container d-flex justify-content-center align-items-center mt-5">
    <div class="card shadow-sm p-4 text-center" style="max-width: 400px; width: 100%; border-radius: 1rem;">
        <h2 class="mb-4">Log in to ohrbob</h2>
        <div class="d-grid gap-3">
            <a asp-controller="Home" asp-action="Login" asp-route-provider="Nextcloud" class="btn btn-outline-primary btn-lg rounded-pill" hx-boost="false">
                <i class="bi bi-cloud-fill me-2"></i> Continue with Nextcloud
            </a>
            <a asp-controller="Home" asp-action="Login" asp-route-provider="Google" class="btn btn-outline-danger btn-lg rounded-pill" hx-boost="false">
                <i class="bi bi-google me-2"></i> Continue with Google
            </a>
        </div>
    </div>
</div>
