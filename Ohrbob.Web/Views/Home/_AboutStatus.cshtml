@model Ohrbob.Web.Models.AboutViewModel
@{
    string lastChecked = Model.LastCheckedUtc == DateTime.MinValue ? "never" : Model.LastCheckedUtc.ToString("u");
    int reachableCount = (Model.ApiReachable ? 1 : 0) + (Model.PlayerReachable ? 1 : 0) + 1;
}
<div class="status-block">
    <div class="status-head">
        <h2 class="status-head__title"><i class="bi bi-activity" aria-hidden="true"></i> Live system status</h2>
        <div class="status-head__meta">
            <span class="status-count">@reachableCount/3 up</span>
            <span class="status-checked">Last checked: @lastChecked &middot; auto-refreshes every 5s</span>
        </div>
    </div>

    <div class="status-grid">
        <article class="status-card">
            <div class="status-card__head">
                <span class="status-dot" aria-hidden="true"></span>
                <i class="bi bi-globe" aria-hidden="true"></i>
                <strong class="status-card__name">ohrbob.web</strong>
                <span class="status-label">running</span>
            </div>
            <p class="status-card__version"><code>@Model.WebVersion</code> @if (!string.IsNullOrEmpty(Model.WebTag)) { <span class="status-card__tag">@Model.WebTag</span> }</p>
            <p class="status-card__note">This portal. If you see this, it's up.</p>
        </article>

        <article class="status-card @(Model.ApiReachable ? string.Empty : "is-error")">
            <div class="status-card__head">
                <span class="status-dot @(Model.ApiReachable ? string.Empty : "is-error")" aria-hidden="true"></span>
                <i class="bi bi-hdd-network" aria-hidden="true"></i>
                <strong class="status-card__name">ohrbob.api</strong>
                <span class="status-label @(Model.ApiReachable ? string.Empty : "is-error")">@(Model.ApiReachable ? "reachable" : "unreachable")</span>
            </div>
            <p class="status-card__version"><code>@(Model.ApiReachable ? Model.ApiVersion : "unknown")</code> @if (!string.IsNullOrEmpty(Model.ApiTag)) { <span class="status-card__tag">@Model.ApiTag</span> }</p>
            <p class="status-card__note">Manages stations, feeds &amp; background polling.</p>
        </article>

        <article class="status-card @(Model.PlayerReachable ? string.Empty : "is-error")">
            <div class="status-card__head">
                <span class="status-dot @(Model.PlayerReachable ? string.Empty : "is-error")" aria-hidden="true"></span>
                <i class="bi bi-broadcast" aria-hidden="true"></i>
                <strong class="status-card__name">ohrbob.player</strong>
                <span class="status-label @(Model.PlayerReachable ? string.Empty : "is-error")">@(Model.PlayerReachable ? "reachable" : "unreachable")</span>
            </div>
            <p class="status-card__version"><code>@(Model.PlayerReachable ? Model.PlayerVersion : "unknown")</code> @if (!string.IsNullOrEmpty(Model.PlayerTag)) { <span class="status-card__tag">@Model.PlayerTag</span> }</p>
            <p class="status-card__note">Streams audio &amp; syncs playhead position.</p>
        </article>
    </div>
</div>
