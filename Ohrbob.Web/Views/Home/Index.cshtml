@using Ohrbob.Server.Shared.Requests
@model List<StationWithFeedsDto>
@{
    ViewData["Title"] = "Listen";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <h2 class="mb-4">Listen</h2>
    
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You don't have any stations assigned to this profile yet. 
            Go to <a asp-controller="Stations" asp-action="Index">Manage Stations</a> to create some, or use the Discover tab.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var dto in Model)
            {
                var feedCount = dto.Feeds?.Count ?? 0;
                string gridClass = "collage-grid-1";
                if (feedCount > 1 && feedCount <= 4) gridClass = "collage-grid-2";
                else if (feedCount > 4 && feedCount <= 9) gridClass = "collage-grid-3";
                else if (feedCount > 9) gridClass = "collage-grid-4";
                
                var displayFeeds = dto.Feeds?.Take(16).ToList() ?? new List<FeedStatsDto>();
                
                var isActive = ViewBag.ActiveStationId == dto.Station.Id;
                var cardClass = isActive ? "border-primary border-3 shadow" : "shadow-sm";

                <div class="col">
                    <div class="card h-100 @cardClass active-station-card" data-station-id="@dto.Station.Id" style="cursor: pointer;" onclick="document.querySelector('#ohrbob-player').playStation('@dto.Station.Id')">
                        <div class="collage-container @gridClass card-img-top">
                            @if (!displayFeeds.Any())
                            {
                                <div class="collage-fallback">?</div>
                            }
                            else
                            {
                                foreach (var feed in displayFeeds)
                                {
                                    if (!string.IsNullOrEmpty(feed.ImageUrl))
                                    {
                                        <img src="@feed.ImageUrl" class="collage-item" alt="@feed.Title" onerror="this.outerHTML='<div class=\'collage-fallback\'>@((feed.Title.Length > 0 ? feed.Title[0].ToString() : "?").ToUpper())</div>'" />
                                    }
                                    else
                                    {
                                        <div class="collage-fallback">@((feed.Title.Length > 0 ? feed.Title[0].ToString() : "?").ToUpper())</div>
                                    }
                                }
                            }
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title text-truncate mb-0" title="@dto.Station.Name">@dto.Station.Name</h5>
                                <a asp-controller="Stations" asp-action="Edit" asp-route-id="@dto.Station.Id" class="text-secondary ms-2" onclick="event.stopPropagation();" title="Manage Station">
                                    <i class="bi bi-gear"></i>
                                </a>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 mb-0">
                                <p class="card-text mb-0">
                                    <small class="text-muted">@feedCount podcasts</small>
                                </p>
                                @if (dto.IsUpdating)
                                {
                                    <span class="badge bg-warning text-dark" title="We are fetching the latest episodes for your station.">
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true" style="width: 0.7rem; height: 0.7rem; border-width: 0.15em;"></span>Compiling...
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    <div class="full-width-escape">
        <div class="landing-wrapper">
            <div class="landing-pinned-container">
                <div class="landing-left">
                    <div class="step-text step-1" style="opacity: 1;">
                        <h2>Build radio stations</h2>
                        <p>From your podcasts.</p>
                    </div>
                    <div class="step-text step-2">
                        <h2>Multiple profiles</h2>
                        <p>Keep listening separated.</p>
                    </div>
                    <div class="step-text step-3">
                        <h2>Listening position</h2>
                        <p>Remembered for each profile.</p>
                    </div>
                    <div class="step-text step-4">
                        <h2>Listen anywhere</h2>
                        <p>Your personalized radio, always ready.</p>
                    </div>
                </div>
                <div class="landing-right">
                    <div class="wheel-arc">
                        <!-- Placeholders for actual screenshots later -->
                        <div class="wheel-card card-1">Stations View</div>
                        <div class="wheel-card card-2">Profiles View</div>
                        <div class="wheel-card card-3">Listening Progress</div>
                        <div class="wheel-card card-4">Web Player</div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="landing-footer">
            <h1 class="display-4 fw-bold text-primary mb-3" style="display:none">Ohrbob</h1>
            <div style="font-size: 4rem;">
                <div class="ohrbob-logo ohrbob-logo-above">
                    <span class="ohrbob-logo-icon">
                        <img src="~/images/ohrbob-logo.svg" alt="Icon">
                    </span>
                    <span class="ohrbob-logo-text">
                        <span class="char-1">o</span><span class="char-2">h</span><span class="char-3">r</span><span class="char-4">b</span><span class="char-5">o</span><span class="char-6">b</span>
                    </span>
                </div>
            </div>
            <p class="lead text-muted mb-4">Start your journey.</p>
            
            <div class="d-flex justify-content-center gap-3 mt-4" hx-boost="false">
                <a asp-controller="Home" asp-action="Login" asp-route-provider="Nextcloud" class="btn btn-outline-primary btn-lg px-4 rounded-pill">
                    <i class="bi bi-cloud-check me-2"></i> Nextcloud
                </a>
                <a asp-controller="Home" asp-action="Login" asp-route-provider="Google" class="btn btn-outline-danger btn-lg px-4 rounded-pill">
                    <i class="bi bi-google me-2"></i> Google
                </a>
            </div>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            if (typeof gsap === 'undefined') return;
            
            gsap.registerPlugin(ScrollTrigger);

            const radius = 400;
            const cards = document.querySelectorAll('.wheel-card');
            
            // Angles in degrees. Left edge is 180.
            const startAngles = [180, 215, 250, 285]; 
            
            cards.forEach((card, i) => {
                const angleRad = startAngles[i] * (Math.PI / 180);
                const x = radius * Math.cos(angleRad);
                const y = radius * Math.sin(angleRad);
                const rotation = startAngles[i] - 180; 
                gsap.set(card, { x: x, y: y, rotation: rotation });
            });

            const tl = gsap.timeline({
                scrollTrigger: {
                    trigger: ".landing-wrapper",
                    start: "top top",
                    end: "bottom bottom",
                    scrub: 1, 
                    pin: ".landing-pinned-container"
                }
            });

            // Step 1 to 2
            tl.to(".step-1", { opacity: 0, y: -20, duration: 1 })
              .to(".step-2", { opacity: 1, y: 0, duration: 1 }, "<")
              .to(".wheel-arc", { rotation: 35, duration: 1 }, "<");

            // Step 2 to 3
            tl.to(".step-2", { opacity: 0, y: -20, duration: 1 })
              .to(".step-3", { opacity: 1, y: 0, duration: 1 }, "<")
              .to(".wheel-arc", { rotation: 70, duration: 1 }, "<");

            // Step 3 to 4
            tl.to(".step-3", { opacity: 0, y: -20, duration: 1 })
              .to(".step-4", { opacity: 1, y: 0, duration: 1 }, "<")
              .to(".wheel-arc", { rotation: 105, duration: 1 }, "<");
              
            tl.to({}, { duration: 0.5 });
        });
    </script>
}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var cards = document.querySelectorAll(".active-station-card");
        cards.forEach(function(card) {
            card.addEventListener("click", function() {
                cards.forEach(function(c) {
                    c.classList.remove("border-primary", "border-3", "shadow");
                    c.classList.add("shadow-sm");
                });
                this.classList.remove("shadow-sm");
                this.classList.add("border-primary", "border-3", "shadow");
            });
        });
    });
</script>
