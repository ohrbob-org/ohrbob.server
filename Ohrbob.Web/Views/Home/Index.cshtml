@using Ohrbob.Server.Shared.Requests
@model List<StationWithFeedsDto>
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Listen";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <h2 class="mb-4">Listen</h2>
    
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
        @if (Model != null)
        {
            @foreach (var dto in Model)
            {
                var feedCount = dto.Feeds?.Count ?? 0;
                string gridClass = "collage-grid-1";
                if (feedCount > 1 && feedCount <= 4) gridClass = "collage-grid-2";
                else if (feedCount > 4 && feedCount <= 9) gridClass = "collage-grid-3";
                else if (feedCount > 9) gridClass = "collage-grid-4";
                
                var displayFeeds = dto.Feeds?.Take(16).ToList() ?? new List<FeedStatsDto>();
                
                var isActive = ViewBag.ActiveStationId == dto.Station.Id;
                var cardClass = isActive ? "border-primary border-3 shadow" : "shadow-sm";
                var subscribedIds = ViewBag.SubscribedStationIds as HashSet<string> ?? new HashSet<string>();
                var isSubscribed = subscribedIds.Contains(dto.Station.Id);

                <div class="col">
                    <div class="card h-100 @cardClass active-station-card" data-station-id="@dto.Station.Id" style="cursor: pointer;" onclick="if (!event.target.closest('a, button, form')) document.querySelector('#ohrbob-player').playStation('@dto.Station.Id')">
                        <div class="collage-container @gridClass card-img-top">
                            @if (!displayFeeds.Any())
                            {
                                <div class="collage-fallback">?</div>
                            }
                            else
                            {
                                foreach (var feed in displayFeeds)
                                {
                                    if (!string.IsNullOrEmpty(feed.ImageUrl))
                                    {
                                        <img src="@feed.ImageUrl" class="collage-item" alt="@feed.Title" onerror="this.outerHTML='<div class=\'collage-fallback\'>@((feed.Title.Length > 0 ? feed.Title[0].ToString() : "?").ToUpper())</div>'" />
                                    }
                                    else
                                    {
                                        <div class="collage-fallback">@((feed.Title.Length > 0 ? feed.Title[0].ToString() : "?").ToUpper())</div>
                                    }
                                }
                            }
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title text-truncate mb-0" title="@dto.Station.Name">@dto.Station.Name</h5>
                                @if (isSubscribed)
                                {
                                    <div class="d-flex align-items-center ms-2">
                                        <span class="badge bg-info text-white">Subscribed</span>
                                        <form asp-controller="Stations" asp-action="Unsubscribe" asp-route-id="@dto.Station.Id"
                                              method="post" hx-target="#main-content" hx-swap="innerHTML" class="ms-2 mb-0">
                                            <button type="button" class="btn btn-link p-0 text-secondary" title="Unsubscribe"
                                                    onclick="window.showConfirmationModal('Unsubscribe from this station?', () => this.closest('form').requestSubmit());">
                                                <i class="bi bi-x-circle"></i>
                                            </button>
                                        </form>
                                    </div>
                                }
                                else
                                {
                                    <a asp-controller="Stations" asp-action="Edit" asp-route-id="@dto.Station.Id" class="text-secondary ms-2"  title="Manage Station">
                                        <i class="bi bi-gear"></i>
                                    </a>
                                }
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 mb-0">
                                <p class="card-text mb-0 d-flex align-items-center gap-2">
                                    <small class="text-muted">@feedCount podcasts</small>
                                    @if (dto.Station.HostPaceEnabled)
                                    {
                                        <span class="badge bg-info text-white" title="Only episodes the host has completed are available">Host Pace</span>
                                    }
                                </p>
                                @{
                                    var totalEpisodes = dto.Feeds?.Sum(f => f.EpisodeCount) ?? 0;
                                }
                                @if (dto.IsUpdating)
                                {
                                    <span class="badge bg-warning text-dark" title="We are fetching the latest episodes for your station.">
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true" style="width: 0.7rem; height: 0.7rem; border-width: 0.15em;"></span>Compiling...
                                    </span>
                                }
                                else if (dto.UnplayedEpisodeCount is 0 || (dto.UnplayedEpisodeCount is null && totalEpisodes == 0))
                                {
                                    <span class="badge bg-danger" title="There are no episodes left to play in this station: it either has no episodes yet, or you have already completed every episode.">
                                        Empty
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        <!-- Big friendly plus symbol inside a grey circle -->
        <div class="col d-flex align-items-center justify-content-center">
            <a asp-controller="Discover" asp-action="Index" class="text-decoration-none d-flex align-items-center justify-content-center w-100 h-100" title="Discover Stations" style="min-height: 250px;">
                <div class="discover-plus-circle d-flex align-items-center justify-content-center rounded-circle shadow-sm">
                    <i class="bi bi-plus-lg"></i>
                </div>
            </a>
        </div>
    </div>
}
else
{
    var landingSteps = new[] {
        new { Title = "Build your own radio stations", Desc = "<p>Combine your favorite podcasts into personalized radio stations that you can tune into whenever you want.</p><p>The best part? Your stations are made just for you—they pause when you leave and wait for your return, so you never miss a moment.</p>", 
            Card = "images/screenshots/stations.png", Badge = "" },
        new { Title = "Tune the rotation", Desc = "<p>Open the rotation editor and decide exactly which episodes play in each station: reorder them, skip what you have already heard and keep the queue in your hands.</p><p>News content is supported too, so time-sensitive shows age out on their own and your station always sounds current. Your listening experience, fully personalized.</p>", 
            Card = "images/screenshots/rotation.png", Badge = "" },
        new { Title = "Profiles for everyone", Desc = "<p>Got a unique taste in podcasts? Create different profiles to keep your listening habits separate from your family and friends.</p><p>With ohrbob Profiles, everyone gets their own personalized listening state without mixing up episodes.</p>", 
            Card = "images/screenshots/profiles.png", Badge = "" },
        new { Title = "Listen together", Desc = "<p>Share your favorite stations and listen to the same episodes with your friends. Say goodbye to unwanted true crime spoilers!</p>", 
            Card = "images/screenshots/together.png", Badge = "" },
        new { Title = "Stream anywhere", Desc = "<p>Take your stations wherever you go. Whether you're on the move or relaxing at home, stream directly to your Wi-Fi radio or any web-enabled device.</p>", 
            Card = "images/screenshots/radio.png", Badge = "morebob" },
        new { Title = "Proudly Open Source", Desc = "<p>We believe in full transparency. Enjoy our hosted service, or take control and host it yourself.</p><p>Missing a feature? Our community is always growing, and we'd love for you to join us as a contributor! Check us out on <a href=\"https://github.com/ohrbob-org/\" target=\"_blank\" rel=\"noopener\">GitHub</a>.</p>", 
            Card = "images/screenshots/opensource.png", Badge = "" }
    };


    <div class="full-width-escape">
        <section class="landing-hero text-center" aria-labelledby="landing-title">
            <div class="ohrbob-logo ohrbob-logo-above landing-hero-logo" aria-hidden="true">
                <span class="ohrbob-logo-icon">
                    <img src="~/images/ohrbob-logo.svg" alt="" />
                </span>
                <span class="ohrbob-logo-text">
                    <span class="char-1">o</span><span class="char-2">h</span><span class="char-3">r</span><span class="char-4">b</span><span class="char-5">o</span><span class="char-6">b</span>
                </span>
            </div>

            <h1 id="landing-title" class="display-4 fw-bold">Your own radio station,<br class="d-none d-sm-block" /> built from the podcasts you love.</h1>
            <p class="lead text-body-secondary mx-auto landing-hero-lead">
                Bundle your favorite podcasts into stations, press play, and let ohrbob pick up exactly where you left off &mdash; on any device, for everyone in your household.
            </p>

            <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 mt-4" hx-boost="false">
                <a asp-controller="Home" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" class="btn btn-primary btn-lg px-4 rounded-pill" hx-boost="false">
                    Sign-Up for free!
                </a>
                <a href="#features" class="btn btn-outline-secondary btn-lg px-4 rounded-pill" hx-boost="false">See how it works</a>
            </div>
        </section>

        <div class="radio-landing-container" id="features">
            @for (int i = 0; i < landingSteps.Length; i++)
            {
                var isEven = i % 2 == 0;
                var card = landingSteps[i].Card;
                // The screenshot is optional: a step still renders as text until its image exists.
                var hasCard = !string.IsNullOrEmpty(card) && System.IO.File.Exists(System.IO.Path.Combine(Env.WebRootPath ?? "", card));
                <section class="radio-step @(isEven ? "step-left" : "step-right")" aria-labelledby="feature-title-@i">
                    <div class="step-content @(hasCard ? "" : "text-only")">
                        <div class="step-text-box">
                            <span class="step-index" aria-hidden="true">@(i + 1)</span>
                            <h2 id="feature-title-@i" class="display-6 fw-bold">@landingSteps[i].Title</h2>
                            <div class="lead text-body-secondary">@Html.Raw(landingSteps[i].Desc)</div>
                            @if (!string.IsNullOrEmpty(landingSteps[i].Badge))
                            {
                                <p class="mt-3 mb-0"><span class="badge tier-badge-premium">@landingSteps[i].Badge tier</span></p>
                            }
                        </div>
                        @if (hasCard)
                        {
                            <div class="step-card-box">
                                <div class="screenshot-card shadow-sm">
                                    <img src="@Url.Content($"~/{card}")" asp-append-version="true" loading="lazy" decoding="async" alt="Screenshot: @landingSteps[i].Title" />
                                </div>
                            </div>
                        }
                    </div>
                </section>
            }
        </div>

        <section class="landing-footer text-center" aria-labelledby="start-heading">
            <div class="landing-logo-wrapper" aria-hidden="true">
                <div class="ohrbob-logo ohrbob-logo-above">
                    <span class="ohrbob-logo-icon">
                        <img src="~/images/ohrbob-logo.svg" alt="" />
                    </span>
                    <span class="ohrbob-logo-text">
                        <span class="char-1">o</span><span class="char-2">h</span><span class="char-3">r</span><span class="char-4">b</span><span class="char-5">o</span><span class="char-6">b</span>
                    </span>
                </div>
            </div>
            <h2 id="start-heading" class="h3 fw-bold mt-4 mb-2">Start your journey.</h2>
            <p class="text-body-secondary mb-4">Free to use. No credit card required.</p>

            <div class="d-flex flex-column flex-sm-row justify-content-center gap-3" hx-boost="false">
                <a asp-controller="Home" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl" class="btn btn-primary btn-lg px-4 rounded-pill" hx-boost="false">
                    Sign-Up for free!
                </a>
                <a href="https://github.com/ohrbob-org/" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-lg px-4 rounded-pill" title="ohrbob on GitHub">
                    <i class="bi bi-github me-2"></i>GitHub
                </a>
            </div>
        </section>

        @* shortcut: the tier numbers below mirror SubscriptionTiersOptions; move them to configuration if they change often. *@
        <section class="landing-tiers" aria-labelledby="tiers-heading">
            <h2 id="tiers-heading" class="display-6 fw-bold text-center">Free or morebob?</h2>
            <p class="lead text-body-secondary text-center mb-4">
                Start for free. Move to morebob when you want more stations, more profiles and streaming.
            </p>

            <div class="landing-tier-card">
                <table class="table landing-tier-table align-middle">
                    <caption class="visually-hidden">Comparison of the Free and morebob subscription tiers.</caption>
                    <thead>
                        <tr>
                            <th scope="col">What you get</th>
                            <th scope="col">Free</th>
                            <th scope="col" class="landing-tier-premium">morebob</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th scope="row">Radio stations</th>
                            <td>2</td>
                            <td><strong>Unlimited</strong></td>
                        </tr>
                        <tr>
                            <th scope="row">Podcasts &amp; feeds per station</th>
                            <td>10</td>
                            <td><strong>Unlimited</strong></td>
                        </tr>
                        <tr>
                            <th scope="row">Listening profiles</th>
                            <td>1</td>
                            <td><strong>Up to 5</strong></td>
                        </tr>
                        <tr>
                            <th scope="row">Streaming to Wi-Fi radios &amp; other devices</th>
                            <td><span aria-hidden="true" class="text-body-tertiary">&mdash;</span><span class="visually-hidden">Not included</span></td>
                            <td><i class="bi bi-check-lg text-success" aria-hidden="true"></i><span class="visually-hidden">Included</span></td>
                        </tr>
                        <tr>
                            <th scope="row">App support</th>
                            <td colspan="2" class="text-center">Android Auto, Linux, Windows, Mac</td>
                        </tr>
                        <tr>
                            <th scope="row">Your own listening progress per profile</th>
                            <td><i class="bi bi-check-lg text-success" aria-hidden="true"></i><span class="visually-hidden">Included</span></td>
                            <td><i class="bi bi-check-lg text-success" aria-hidden="true"></i><span class="visually-hidden">Included</span></td>
                        </tr>
                        <tr>
                            <th scope="row">Share stations with family &amp; friends</th>
                            <td><i class="bi bi-check-lg text-success" aria-hidden="true"></i><span class="visually-hidden">Included</span></td>
                            <td><i class="bi bi-check-lg text-success" aria-hidden="true"></i><span class="visually-hidden">Included</span></td>
                        </tr>
                        <tr>
                            <th scope="row">Open source &amp; self-hostable</th>
                            <td><i class="bi bi-check-lg text-success" aria-hidden="true"></i><span class="visually-hidden">Included</span></td>
                            <td><i class="bi bi-check-lg text-success" aria-hidden="true"></i><span class="visually-hidden">Included</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
}
