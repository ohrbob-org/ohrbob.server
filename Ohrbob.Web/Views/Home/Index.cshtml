@using Ohrbob.Server.Shared.Requests
@model List<StationWithFeedsDto>
@{
    ViewData["Title"] = "Listen";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <h2 class="mb-4">Listen</h2>
    
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You don't have any stations assigned to this profile yet. 
            Go to <a asp-controller="Stations" asp-action="Index">Manage Stations</a> to create some, or use the Discover tab.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var dto in Model)
            {
                var feedCount = dto.Feeds?.Count ?? 0;
                string gridClass = "collage-grid-1";
                if (feedCount > 1 && feedCount <= 4) gridClass = "collage-grid-2";
                else if (feedCount > 4 && feedCount <= 9) gridClass = "collage-grid-3";
                else if (feedCount > 9) gridClass = "collage-grid-4";
                
                var displayFeeds = dto.Feeds?.Take(16).ToList() ?? new List<FeedStatsDto>();
                
                var isActive = ViewBag.ActiveStationId == dto.Station.Id;
                var cardClass = isActive ? "border-primary border-3 shadow" : "shadow-sm";

                <div class="col">
                    <div class="card h-100 @cardClass active-station-card" data-station-id="@dto.Station.Id" style="cursor: pointer;" onclick="document.querySelector('#ohrbob-player').playStation('@dto.Station.Id')">
                        <div class="collage-container @gridClass card-img-top">
                            @if (!displayFeeds.Any())
                            {
                                <div class="collage-fallback">?</div>
                            }
                            else
                            {
                                foreach (var feed in displayFeeds)
                                {
                                    if (!string.IsNullOrEmpty(feed.ImageUrl))
                                    {
                                        <img src="@feed.ImageUrl" class="collage-item" alt="@feed.Title" onerror="this.outerHTML='<div class=\'collage-fallback\'>@((feed.Title.Length > 0 ? feed.Title[0].ToString() : "?").ToUpper())</div>'" />
                                    }
                                    else
                                    {
                                        <div class="collage-fallback">@((feed.Title.Length > 0 ? feed.Title[0].ToString() : "?").ToUpper())</div>
                                    }
                                }
                            }
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="card-title text-truncate mb-0" title="@dto.Station.Name">@dto.Station.Name</h5>
                                <a asp-controller="Stations" asp-action="Edit" asp-route-id="@dto.Station.Id" class="text-secondary ms-2" onclick="event.stopPropagation();" title="Manage Station">
                                    <i class="bi bi-gear"></i>
                                </a>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 mb-0">
                                <p class="card-text mb-0">
                                    <small class="text-muted">@feedCount podcasts</small>
                                </p>
                                @if (dto.IsUpdating)
                                {
                                    <span class="badge bg-warning text-dark" title="We are fetching the latest episodes for your station.">
                                        <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true" style="width: 0.7rem; height: 0.7rem; border-width: 0.15em;"></span>Compiling...
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    <style>
        /* Landing page specific layout: 
           Make header fixed so it doesn't take up space, eliminating the white bar above the landing container.
           Also set the body background to match the landing page color. */
        header { 
            position: fixed !important; 
            width: 100%; 
            left: 0; 
        }
        body { 
            background-color: #f8f9fa; 
        }
        .broadcast-node {
            z-index: 1; /* Below the logo image */
        }
        .broadcast-ring {
            clip-path: inset(0 0 50% 0); /* Cuts off bottom half, creating an arch */
            border-color: rgba(var(--bs-primary-rgb), 0.3) !important; /* 30% alpha */
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%) scale(0.5); /* Centered default */
            opacity: 0;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            border: 2px solid;
            pointer-events: none;
        }
    </style>
    var landingSteps = new[] {
        new { Title = "Build radio stations", Desc = "From your podcasts.", Card = "Stations View" },
        new { Title = "Multiple profiles", Desc = "Keep listening separated.", Card = "Profiles View" },
        new { Title = "Listening position", Desc = "Remembered for each profile.", Card = "Listening Progress" },
        new { Title = "Listen anywhere", Desc = "Your personalized radio, always ready.", Card = "Web Player" },
        new { Title = "Open Source", Desc = "Fully transparent, host it yourself.", Card = "Open-Source" }
    };

    <div class="full-width-escape" style="position: relative;">
        <div class="radio-axis">
            <div class="radio-dial"></div>
        </div>
        <div class="radio-landing-container">

            @for (int i = 0; i < landingSteps.Length; i++)
            {
                var isEven = i % 2 == 0;
                <div class="radio-step @(isEven ? "step-left" : "step-right")">
                    <div class="wave-node">
                        <div class="wave-ring ring-1"></div>
                        <div class="wave-ring ring-2"></div>
                        <div class="wave-ring ring-3"></div>
                    </div>
                    <div class="step-content">
                        <div class="step-text-box">
                            <h2 class="display-5 fw-bold">@landingSteps[i].Title</h2>
                            <p class="lead text-muted">@landingSteps[i].Desc</p>
                        </div>
                        <div class="step-card-box">
                            <div class="screenshot-card shadow-lg">@landingSteps[i].Card</div>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <div class="landing-footer">
            <h1 class="display-4 fw-bold text-primary mb-3" style="display:none">Ohrbob</h1>
            <div class="landing-logo-wrapper">
                <div class="ohrbob-logo landing-dynamic-logo">
                    <span class="ohrbob-logo-icon">
                        <div class="wave-node logo-wave-node">
                            <div class="wave-ring logo-ring-1"></div>
                            <div class="wave-ring logo-ring-2"></div>
                            <div class="wave-ring logo-ring-3"></div>
                        </div>
                        <div class="wave-node broadcast-node">
                            <!-- Rings dynamically generated by JS for pooling -->
                        </div>
                        <img src="~/images/ohrbob-logo.svg" alt="Icon" style="position: relative; z-index: 2;">
                    </span>
                    <span class="ohrbob-logo-text">
                        <span class="char-1">o</span><span class="char-2">h</span><span class="char-3">r</span><span class="char-4">b</span><span class="char-5">o</span><span class="char-6">b</span>
                    </span>
                </div>
            </div>
            <p class="lead text-muted mb-4">Start your journey.</p>
            
            <div class="d-flex justify-content-center gap-3 mt-4" hx-boost="false">
                <a asp-controller="Home" asp-action="Login" asp-route-provider="Nextcloud" class="btn btn-outline-primary btn-lg px-4 rounded-pill" hx-boost="false">
                    <i class="bi bi-cloud-check me-2"></i> Nextcloud
                </a>
                <a asp-controller="Home" asp-action="Login" asp-route-provider="Google" class="btn btn-outline-danger btn-lg px-4 rounded-pill" hx-boost="false">
                    <i class="bi bi-google me-2"></i> Google
                </a>
            </div>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            if (typeof gsap === 'undefined') return;
            
            gsap.registerPlugin(ScrollTrigger);

            // Calculate dynamic axis height to end exactly at the logo icon center
            function updateAxisHeight() {
                const axis = document.querySelector('.radio-axis');
                const logoIcon = document.querySelector('.landing-dynamic-logo .ohrbob-logo-icon');
                const container = document.querySelector('.full-width-escape');
                
                if (axis && logoIcon && container) {
                    const containerRect = container.getBoundingClientRect();
                    const logoRect = logoIcon.getBoundingClientRect();
                    // Distance from top of container to center of logo icon
                    const logoCenterY = (logoRect.top - containerRect.top) + (logoRect.height / 2);
                    axis.style.height = logoCenterY + 'px';
                    
                    // Refresh ScrollTrigger to recalculate heights
                    ScrollTrigger.refresh();
                }
            }
            
            // Run on load, and shortly after (images loading), and resize
            updateAxisHeight();
            setTimeout(updateAxisHeight, 500);
            window.addEventListener('resize', updateAxisHeight);

            // Animate the radio dial moving down the axis
            gsap.to(".radio-dial", {
                top: "100%",
                ease: "none",
                scrollTrigger: {
                    trigger: ".radio-axis",
                    start: "top center",
                    end: "bottom center",
                    scrub: true
                }
            });

            // Ping animation when dial hits the logo
            const logoRings = document.querySelectorAll('.logo-wave-node .wave-ring');
            if (logoRings.length > 0) {
                gsap.timeline({
                    scrollTrigger: {
                        trigger: ".radio-axis",
                        start: "bottom center", // Fires exactly when the dial hits the end of the line
                        toggleActions: "play none none reverse"
                    }
                })
                .to(logoRings, {
                    scale: 12,
                    opacity: 0,
                    duration: 3,
                    stagger: 0.3,
                    ease: "power2.out",
                    startAt: { opacity: 0.8, scale: 0.5 }
                });
            }

            // New continuous directional broadcast animation (Pooling System)
            const broadcastNode = document.querySelector('.broadcast-node');
            if (broadcastNode) {
                // Create a pool of 6 rings (enough to cover 3s intervals over ~15s travel time)
                const poolSize = 6;
                const ringPool = [];
                for (let i = 0; i < poolSize; i++) {
                    const ring = document.createElement('div');
                    ring.className = 'wave-ring broadcast-ring';
                    broadcastNode.appendChild(ring);
                    ringPool.push({ el: ring, active: false });
                }

                let broadcastTimer;

                function emitRing() {
                    // Find an inactive ring
                    const ringObj = ringPool.find(r => !r.active);
                    if (!ringObj) return; // Pool exhausted, though 6 should be plenty for 3s interval

                    ringObj.active = true;
                    const ring = ringObj.el;

                    // Travel distance: well above the screen
                    const travelDistance = -(window.innerHeight + 1000); 

                    gsap.fromTo(ring, 
                        { 
                            y: 0, 
                            scale: 0.5, 
                            opacity: 1 // Alpha is handled by CSS border-color
                        }, 
                        {
                            y: travelDistance,
                            scale: 4, // Widen as it goes
                            opacity: 0, // Fade out entirely near the end
                            duration: 15, // Travel time
                            ease: "none",
                            onComplete: () => {
                                ringObj.active = false; // Return to pool
                            }
                        }
                    );
                }

                ScrollTrigger.create({
                    trigger: ".landing-dynamic-logo",
                    start: "top 95%",
                    once: true,
                    onEnter: () => {
                        emitRing(); // Emit first immediately
                        broadcastTimer = setInterval(emitRing, 3000); // Then every 3s
                    },
                    onLeaveBack: () => {
                        // Optional: pause if scrolling way back up, but spec says continuous once triggered
                    }
                });
            }

            // Animate each step's waves and content reveal
            const steps = document.querySelectorAll('.radio-step');
            
            steps.forEach((step) => {
                const rings = step.querySelectorAll('.wave-ring');
                const text = step.querySelector('.step-text-box');
                const card = step.querySelector('.step-card-box');
                
                const tl = gsap.timeline({
                    scrollTrigger: {
                        trigger: step,
                        start: "top 65%", // Trigger when step is 65% down the viewport
                        toggleActions: "play none none reverse"
                    }
                });

                // Wave pulse effect
                tl.to(rings, {
                    scale: 6,
                    opacity: 0,
                    duration: 2.5,
                    stagger: 0.2,
                    ease: "power2.out",
                    startAt: { opacity: 0.6, scale: 0.5 }
                }, 0);

                // Content reveal
                tl.to([text, card], {
                    opacity: 1,
                    y: 0,
                    duration: 0.8,
                    stagger: 0.2,
                    ease: "back.out(1.2)"
                }, 0.3); // Start slightly after waves begin
            });
        });
    </script>
}
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var cards = document.querySelectorAll(".active-station-card");
        cards.forEach(function(card) {
            card.addEventListener("click", function() {
                cards.forEach(function(c) {
                    c.classList.remove("border-primary", "border-3", "shadow");
                    c.classList.add("shadow-sm");
                });
                this.classList.remove("shadow-sm");
                this.classList.add("border-primary", "border-3", "shadow");
            });
        });
    });
</script>
