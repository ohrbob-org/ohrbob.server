@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    
    @if (User.Identity?.IsAuthenticated == true)
    {
        var picture = User.FindFirst("picture")?.Value;
        var email = User.FindFirst("email")?.Value ?? User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value;

        if (!string.IsNullOrEmpty(picture))
        {
            <img src="@picture" alt="Profile Picture" class="rounded-circle mb-3" width="100" height="100" />
        }

        <p>Hello, @User.Identity.Name!</p>

        if (!string.IsNullOrEmpty(email))
        {
            <p>Email: @email</p>
        }

        <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
    }
    else
    {
        <p>Please log in to continue.</p>
        <div class="d-flex justify-content-center gap-3 mt-4" hx-boost="false">
            <a asp-controller="Home" asp-action="Login" asp-route-provider="Nextcloud" class="btn btn-primary btn-lg">Login with Nextcloud</a>
            <a asp-controller="Home" asp-action="Login" asp-route-provider="Google" class="btn btn-danger btn-lg">Login with Google</a>
        </div>
    }
</div>
