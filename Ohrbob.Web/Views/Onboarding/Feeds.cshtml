@model List<Ohrbob.Web.Models.PodcastSearchResult>
@{
    ViewData["Title"] = "Add Podcasts";
    ViewData["BodyClass"] = "metro-night";
    Layout = "_Layout_Minimal";
}

<div class="onboarding-page onboarding-page--wide onboarding-page--feeds metro-night">
    <div class="onboarding-intro">
        <p class="onboarding-kicker">step 3 · podcasts</p>
        <h2 class="onboarding-subtitle">Fill "@ViewBag.StationName"</h2>
        <p class="onboarding-hint">Search for your favorite podcasts and add them to your station.</p>
    </div>

    <div class="onboarding-card onboarding-card--wide">
        <div class="onboarding-search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search"
                   class="form-control"
                   placeholder="Search podcasts by name..."
                   aria-label="Search podcasts by name"
                   name="query"
                   hx-get="/Onboarding/SearchFeeds"
                   hx-target="#search-results"
                   hx-trigger="keyup changed delay:500ms, search" />
        </div>

        <div id="search-results" class="row row-cols-1 row-cols-sm-2 g-2">
            @if (Model != null && Model.Any())
            {
                <partial name="_FeedSearchResults" model="Model" />
            }
        </div>
    </div>
</div>

<!-- Floating Finish Button -->
<div class="onboarding-finishbar" id="finish-bar" style="display: none;">
    <div class="onboarding-finishbar__inner">
        <div class="onboarding-finishbar__count">
            <span id="selected-count" class="onboarding-count">0</span> <span>podcasts added</span>
        </div>
        <form asp-action="Finish" method="post" id="finish-form" class="onboarding-finishbar__form">
            <input type="hidden" name="profileId" value="@ViewBag.ProfileId" />
            <input type="hidden" name="stationName" value="@ViewBag.StationName" />
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <!-- Hidden inputs added dynamically -->
            <button type="submit" class="btn btn-primary onboarding-finishbar__button">Complete Setup <i class="bi bi-check-circle ms-2"></i></button>
        </form>
    </div>
</div>

<script>
    var selectedFeeds = new Set();

    @if (Model != null && Model.Any())
    {
        foreach(var feed in Model)
        {
            <text>selectedFeeds.add("@Html.Raw(feed.Url)");</text>
        }
    }

    window.applyButtonStates = function() {
        document.querySelectorAll('.add-feed-btn').forEach(btn => {
            const url = btn.getAttribute('data-url');
            if (selectedFeeds.has(url)) {
                btn.classList.remove('btn-outline-primary');
                btn.classList.add('btn-success');
                btn.innerHTML = '<i class="bi bi-check-circle"></i> Added';
            }
        });
    };

    window.updateFinishBar = function() {
        const bar = document.getElementById('finish-bar');
        const count = document.getElementById('selected-count');
        const form = document.getElementById('finish-form');

        if (!bar || !count || !form) return;

        count.innerText = selectedFeeds.size;

        // Update hidden inputs
        form.querySelectorAll('input[name="selectedFeeds"]').forEach(el => el.remove());
        selectedFeeds.forEach(url => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'selectedFeeds';
            input.value = url;
            form.appendChild(input);
        });

        if (selectedFeeds.size > 0) {
            bar.style.display = 'block';
        } else {
            bar.style.display = 'none';
        }
    };

    if (typeof window.onboardingFeedsInitialized === 'undefined') {
        window.onboardingFeedsInitialized = true;

        document.addEventListener("DOMContentLoaded", function() {
            window.applyButtonStates();
            window.updateFinishBar();
        });

        document.body.addEventListener('htmx:afterSwap', function(evt) {
            if (evt.detail.target && evt.detail.target.id === 'search-results') {
                window.applyButtonStates();
            }
        });

        document.addEventListener("click", function(e) {
            if (e.target && e.target.closest('.add-feed-btn')) {
                const btn = e.target.closest('.add-feed-btn');
                const url = btn.getAttribute('data-url');

                if (selectedFeeds.has(url)) {
                    selectedFeeds.delete(url);
                    btn.classList.remove('btn-success');
                    btn.classList.add('btn-outline-primary');
                    btn.innerHTML = '<i class="bi bi-plus-circle"></i> Add';
                } else {
                    selectedFeeds.add(url);
                    btn.classList.remove('btn-outline-primary');
                    btn.classList.add('btn-success');
                    btn.innerHTML = '<i class="bi bi-check-circle"></i> Added';
                }

                window.updateFinishBar();
            }
        });
    }

    // Call on script execution (e.g. HTMX swap)
    window.applyButtonStates();
    window.updateFinishBar();
</script>
