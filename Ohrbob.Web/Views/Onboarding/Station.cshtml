@{
    ViewData["Title"] = "Create Station";
    ViewData["BodyClass"] = "metro-night";
    Layout = "_Layout_Minimal";
}

<div class="onboarding-page">
    <div class="onboarding-intro">
        <p class="onboarding-kicker">step 2 · station</p>
        <h2 class="onboarding-subtitle">Create Your First Station</h2>
        <p class="onboarding-hint">
            A Station is like a personalized radio channel. You fill it with podcasts, and Ohrbob plays them back continuously.
            What do you want to listen to?
        </p>
    </div>

    <div class="onboarding-card">
        <form asp-action="CreateStation" method="post">
            <input type="hidden" name="profileId" value="@ViewBag.ProfileId" />
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div class="onboarding-field">
                <label for="stationName" class="form-label">Station name</label>
                <input type="text" class="form-control form-control-lg" id="stationName" name="stationName" placeholder="e.g. My Awesome Mix" required>
            </div>

            <div class="onboarding-suggestions">
                <p class="onboarding-card__kicker">Need inspiration?</p>
                <div class="onboarding-chips">
                    @foreach (var suggestion in ViewBag.Suggestions)
                    {
                        <button type="button" class="btn btn-outline-secondary suggestion-btn">@suggestion</button>
                    }
                </div>
            </div>

            <button type="submit" class="btn btn-primary onboarding-submit">Next Step <i class="bi bi-arrow-right ms-2"></i></button>
        </form>
    </div>
</div>

<script>
    document.addEventListener("click", function (e) {
        if (e.target && e.target.classList.contains("suggestion-btn")) {
            var input = document.getElementById("stationName");
            if (input) {
                input.value = e.target.innerText;
                input.focus();

                // Remove active styling from all buttons, apply to the clicked one
                var btns = document.querySelectorAll(".suggestion-btn");
                btns.forEach(b => {
                    b.classList.remove("btn-primary", "text-white");
                    b.classList.add("btn-outline-secondary");
                });
                e.target.classList.remove("btn-outline-secondary");
                e.target.classList.add("btn-primary", "text-white");
            }
        }
    });

    document.addEventListener("input", function (e) {
        if (e.target && e.target.id === "stationName") {
            var btns = document.querySelectorAll(".suggestion-btn");
            btns.forEach(b => {
                b.classList.remove("btn-primary", "text-white");
                b.classList.add("btn-outline-secondary");
            });
        }
    });
</script>
