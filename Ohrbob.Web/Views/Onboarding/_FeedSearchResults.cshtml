@model List<Ohrbob.Web.Models.PodcastSearchResult>

@if (Model == null || !Model.Any())
{
    <div class="col-12 text-center text-muted py-4">
        <p>No podcasts found.</p>
    </div>
}
else
{
    @foreach (var podcast in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="row g-0">
                    <div class="col-4">
                        @if (!string.IsNullOrEmpty(podcast.Image))
                        {
                            <img src="@podcast.Image" class="img-fluid rounded-start h-100" alt="Cover" style="object-fit: cover;">
                        }
                    </div>
                    <div class="col-8">
                        <div class="card-body p-2 d-flex flex-column h-100">
                            <h6 class="card-title text-truncate mb-1" title="@podcast.Title" style="font-size: 0.9rem;">@podcast.Title</h6>
                            <p class="card-text text-muted small text-truncate mb-2" style="font-size: 0.75rem;">@podcast.Author</p>
                            <div class="mt-auto">
                                <button type="button" class="btn btn-outline-primary btn-sm w-100 add-feed-btn" data-url="@podcast.Url">
                                    <i class="bi bi-plus-circle"></i> Add
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
}