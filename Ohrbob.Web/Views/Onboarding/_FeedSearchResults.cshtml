@model List<Ohrbob.Web.Models.PodcastSearchResult>

@if (Model == null || !Model.Any())
{
    <div class="col-12 onboarding-empty">
        <p>No podcasts found.</p>
    </div>
}
else
{
    @foreach (var podcast in Model)
    {
        <div class="col">
            <article class="onboarding-result">
                <div class="onboarding-result__cover">
                    @if (!string.IsNullOrEmpty(podcast.Image))
                    {
                        <img src="@podcast.Image" alt="Cover" loading="lazy">
                    }
                    else
                    {
                        <span class="onboarding-result__placeholder" aria-hidden="true"><i class="bi bi-mic"></i></span>
                    }
                </div>
                <div class="onboarding-result__body">
                    <h3 class="onboarding-result__title" title="@podcast.Title">@podcast.Title</h3>
                    <p class="onboarding-result__author">@podcast.Author</p>
                    <button type="button" class="btn btn-outline-primary onboarding-result__add add-feed-btn" data-url="@podcast.Url">
                        <i class="bi bi-plus-circle"></i> Add
                    </button>
                </div>
            </article>
        </div>
    }
}
