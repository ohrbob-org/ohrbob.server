@model Ohrbob.Server.Shared.Data.Account
@{
    ViewData["Title"] = "Delete Account";
}

<div class="page-head">
    <div class="page-head__text">
        <p class="metro-kicker" aria-hidden="true">your account</p>
        <h1 class="metro-title metro-title--compact">Delete account</h1>
    </div>
</div>

<div class="danger-panel">
    <h2 class="danger-panel__title">This cannot be undone.</h2>
    <p>Deleting the account for <strong>@Model.Email</strong> permanently removes:</p>
    <ul>
        <li>All of your profiles and their listening history</li>
        <li>All of your stations, including their share links</li>
        <li>All API keys and device connections</li>
        <li>Your subscriptions to shared stations</li>
    </ul>
    <p class="mb-0">Stations you shared with others will stop working immediately. You can sign in again later, but you will start with a brand-new empty account.</p>
</div>

<form asp-action="Delete" method="post" class="danger-actions" hx-boost="false">
    @Html.AntiForgeryToken()
    <button type="submit" class="account-action is-danger">
        <i class="bi bi-trash3" aria-hidden="true"></i>Delete my account
    </button>
    <a asp-action="Index" class="account-action">Cancel</a>
</form>
