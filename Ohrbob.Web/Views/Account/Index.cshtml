@model Ohrbob.Web.Models.ManageAccountViewModel
@{
    ViewData["Title"] = "Manage Account";
    string Limit(int v) => v < 0 ? "Unlimited" : v.ToString();
}
<h1>Manage Account</h1>
@if (TempData["Notice"] != null) { <div class="alert alert-success">@TempData["Notice"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<p><span class="badge @(Model.Tier == Ohrbob.Server.Shared.Data.SubscriptionTier.Morebob ? "bg-success" : "bg-secondary")">@Model.Tier</span></p>
<table class="table">
    <tr><th>Stations</th><td>@Model.StationCount / @Limit(Model.Limits.MaxStations)</td></tr>
    <tr><th>Profiles</th><td>@Model.ProfileCount / @Limit(Model.Limits.MaxProfiles)</td></tr>
    <tr><th>Max feeds per station</th><td>@Limit(Model.Limits.MaxFeedsPerStation) (most used: @Model.MaxFeedsPerStationUsed)</td></tr>
    <tr><th>Streaming</th><td>@(Model.Limits.StreamEnabled ? "On" : "Off")</td></tr>
</table>
@if (Model.Tier != Ohrbob.Server.Shared.Data.SubscriptionTier.Morebob)
{
    <div class="upgrade-card shadow-sm mb-4">
        <div class="card-content-wrapper">
            <span class="card-badge">More</span>
            <h3 class="card-title-premium">morebob</h3>
            <p class="card-desc-premium">
                Build your ultimate personalized audio space with zero limits.
            </p>
            
            <!-- Feature Grid (The Claim) -->
            <div class="feature-grid-premium">
                <div class="feature-item-premium">
                    <span class="feature-icon-premium">✓</span>
                    <div>
                        <div class="feature-title-premium">Unlimited Stations</div>
                        <div class="feature-desc-premium">Create as many customized stations as you want (versus 1).</div>
                    </div>
                </div>
                <div class="feature-item-premium">
                    <span class="feature-icon-premium">✓</span>
                    <div>
                        <div class="feature-title-premium">Unlimited Feeds</div>
                        <div class="feature-desc-premium">Add any number of RSS, podcast, and news sources per station.</div>
                    </div>
                </div>
                <div class="feature-item-premium">
                    <span class="feature-icon-premium">✓</span>
                    <div>
                        <div class="feature-title-premium">Up to 5 Profiles</div>
                        <div class="feature-desc-premium">Separate by moods or easily share with your family.</div>
                    </div>
                </div>
                <div class="feature-item-premium">
                    <span class="feature-icon-premium">✓</span>
                    <div>
                        <div class="feature-title-premium">Full Audio Streaming</div>
                        <div class="feature-desc-premium">Enjoy instant background audio streams without interruption.</div>
                    </div>
                </div>
            </div>

            <!-- Upgrade Button Form -->
            <form asp-action="Upgrade" method="post">
                @Html.AntiForgeryToken()
                <button class="btn-upgrade-morebob" type="submit">
                    <span class="button-text">Upgrade to Morebob</span>
                    <img src="~/images/ohrbob-logo.svg" alt="Morebob Logo" class="watermark" />
                    
                </button>
            </form>

            <!-- Prominent Coming Soon Alert -->
            <div class="coming-soon-banner">
                <span class="banner-icon-premium">💳</span>
                <div>
                    <div class="banner-title-premium">Stripe Card Billing Integration Coming Soon!</div>
                    <div class="banner-desc-premium">We are actively preparing standard Stripe subscription payments.</div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <p class="text-success">You are on Morebob. Manage billing via Stripe portal (coming soon).</p>
}

<!-- Appearance / theme settings -->
@{
    var themeMode = Context.Request.Cookies["ohrbob_theme"];
    if (!string.IsNullOrEmpty(themeMode)) { themeMode = Uri.UnescapeDataString(themeMode); }
    if (themeMode != "light" && themeMode != "dark") { themeMode = "system"; }
}
<div class="card mt-4" id="appearanceCard">
    <div class="card-header d-flex justify-content-between align-items-center bg-transparent">
        <h4 class="mb-0">Appearance</h4>
    </div>
    <div class="card-body">
        <p class="text-muted mb-3">Choose how ohrbob looks on this device. <strong>System</strong> follows your browser or operating system setting.</p>
        <div role="group" aria-label="Theme">
            <input type="radio" class="btn-check" name="theme" id="themeSystem" value="system" autocomplete="off" @(themeMode == "system" ? "checked" : "")>
            <label class="btn btn-outline-primary" for="themeSystem"><i class="bi bi-circle-half me-1"></i> System</label>

            <input type="radio" class="btn-check" name="theme" id="themeLight" value="light" autocomplete="off" @(themeMode == "light" ? "checked" : "")>
            <label class="btn btn-outline-primary" for="themeLight"><i class="bi bi-sun me-1"></i> Light</label>

            <input type="radio" class="btn-check" name="theme" id="themeDark" value="dark" autocomplete="off" @(themeMode == "dark" ? "checked" : "")>
            <label class="btn btn-outline-primary" for="themeDark"><i class="bi bi-moon-stars me-1"></i> Dark</label>
        </div>
    </div>
</div>

@inject Microsoft.Extensions.Options.IOptions<Ohrbob.Web.Configuration.OhrbobApiOptions> ApiOptions

<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center bg-transparent">
        <h4 class="mb-0">Device Connectivity & API Keys</h4>
    </div>
    <div class="card-body text-body">
        <p class="text-muted">Generate API keys to connect external devices and players. Connect via the generated QR code.</p>

        @if (Model.ApiKeys == null || !Model.ApiKeys.Any())
        {
            <div class="text-center py-4 text-muted border rounded mb-3 bg-body-secondary">
                <i class="bi bi-key-fill" style="font-size: 2rem;"></i>
                <p class="mt-2 mb-0">No active API keys found. Create one below to connect your devices.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle text-body">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Profile</th>
                            <th>Token</th>
                            <th>Connection</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var key in Model.ApiKeys)
                        {
                            var profileName = Model.Profiles.FirstOrDefault(p => p.Id == key.ProfileId)?.Name ?? "All Profiles (Account level)";
                            var abbrevToken = key.Token.Length > 9 
                                ? key.Token.Substring(0, 5) + "..." + key.Token.Substring(key.Token.Length - 4) 
                                : key.Token;
                            var deepLink = $"ohrbob://connect?server={Uri.EscapeDataString(ApiOptions.Value.FrontendPlayerUrl)}&token={Uri.EscapeDataString(key.Token)}";

                            <tr>
                                <td><strong>@key.Name</strong></td>
                                <td><span class="badge bg-body-secondary text-body border">@profileName</span></td>
                                <td><code>@abbrevToken</code></td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" type="button" 
                                            onclick="showConnectionQr('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(key.Name))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(deepLink))')">
                                        <i class="bi bi-qr-code"></i> Show QR
                                    </button>
                                </td>
                                <td class="text-end">
                                    <form asp-action="RevokeApiKey" method="post" style="display:inline;" onsubmit="return confirm('Are you sure you want to revoke this API key? This will instantly disconnect any connected devices.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@key.Id" />
                                        <button class="btn btn-sm btn-outline-danger" type="submit">
                                            <i class="bi bi-trash"></i> Revoke
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Create New Key Form -->
        <div class="border rounded p-3 mt-4 bg-body-secondary text-body">
            <h5>Generate New API Key</h5>
            <form asp-action="AddApiKey" method="post" class="row g-3 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-5">
                    <label for="keyName" class="form-label small text-muted">Device or Key Name</label>
                    <input type="text" class="form-control form-control-sm text-body bg-body" id="keyName" name="name" placeholder="e.g. My Smart Speaker, Living Room Tablet" required />
                </div>
                <div class="col-md-5">
                    <label for="profileId" class="form-label small text-muted">Profile Scope</label>
                    <select class="form-select form-select-sm text-body bg-body" id="profileId" name="profileId">
                        <option value="">All Profiles (Account level)</option>
                        @foreach (var p in Model.Profiles)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <button type="submit" class="btn btn-sm btn-primary w-100">
                        <i class="bi bi-plus-circle"></i> Generate
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- QR Code Modal -->
<div class="modal fade" id="qrCodeModal" tabindex="-1" aria-labelledby="qrCodeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="qrCodeModalLabel">Connect Device</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center text-body">
                <p>Scan this QR code with your Ohrbob app/device to connect <strong class="text-body"><span id="qrKeyName"></span></strong>.</p>
                <div id="qrcode-container" class="d-flex justify-content-center my-3 p-3 bg-white rounded border" style="width: fit-content; margin: 0 auto;"></div>
                <div class="mt-2 text-body text-start">
                    <span class="small text-muted d-block mb-1">Deep link:</span>
                    <code class="d-block text-break small p-2 bg-body-secondary border rounded text-body mb-3" id="qrDeepLink"></code>

                    <label class="form-label small text-muted mb-1 d-block">Server URL</label>
                    <div class="input-group mb-3">
                        <input type="text" class="form-control text-body bg-body-secondary" id="qrServerUrl" readonly />
                        <button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('qrServerUrl').value); alert('Server URL copied to clipboard!');">Copy</button>
                    </div>

                    <label class="form-label small text-muted mb-1 d-block">API Token</label>
                    <div class="input-group">
                        <input type="text" class="form-control text-body bg-body-secondary" id="qrToken" readonly />
                        <button class="btn btn-outline-secondary" type="button" onclick="navigator.clipboard.writeText(document.getElementById('qrToken').value); alert('Token copied to clipboard!');">Copy</button>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" referrerpolicy="no-referrer"></script>
<script>
    window.showConnectionQr = function(keyName, deepLink) {
        document.getElementById('qrKeyName').textContent = keyName;
        document.getElementById('qrDeepLink').textContent = deepLink;

        let serverUrl = "";
        let token = "";
        try {
            const queryStr = deepLink.split('?')[1];
            if (queryStr) {
                const pairs = queryStr.split('&');
                for (const pair of pairs) {
                    const parts = pair.split('=');
                    if (parts[0] === 'server') serverUrl = decodeURIComponent(parts[1] || "");
                    if (parts[0] === 'token') token = decodeURIComponent(parts[1] || "");
                }
            }
        } catch (e) {
            console.error("Failed to parse deep link parameters:", e);
        }

        document.getElementById('qrServerUrl').value = serverUrl;
        document.getElementById('qrToken').value = token;
        
        const container = document.getElementById('qrcode-container');
        container.innerHTML = '';
        
        new QRCode(container, {
            text: deepLink,
            width: 200,
            height: 200,
            colorDark: "#000000",
            colorLight: "#ffffff",
            correctLevel: QRCode.CorrectLevel.M
        });

        const modal = new bootstrap.Modal(document.getElementById('qrCodeModal'));
        modal.show();
    };

    @if (TempData["NewApiKeyName"] != null && TempData["NewApiKeyToken"] != null)
    {
        var newKeyName = TempData["NewApiKeyName"]?.ToString();
        var newToken = TempData["NewApiKeyToken"]?.ToString();
        var autoDeepLink = $"ohrbob://connect?server={Uri.EscapeDataString(ApiOptions.Value.FrontendPlayerUrl)}&token={Uri.EscapeDataString(newToken ?? "")}";
        <text>
        // Use timeout to ensure the DOM and bootstrap are fully ready
        setTimeout(function() {
            window.showConnectionQr('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(newKeyName))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(autoDeepLink))');
        }, 100);
        </text>
    }
</script>
