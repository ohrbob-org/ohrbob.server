@model Ohrbob.Server.Shared.Data.Station

@{
    ViewData["Title"] = "Create Station";
}

<h1>Create Station</h1>

<h4>Station</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="IsPublic">
                    <label class="form-check-label" asp-for="IsPublic">
                        Public Station
                    </label>
                </div>
            </div>

            <!-- Basic input for a single feed for now, could be expanded to multiple with JS -->
            <div class="form-group mb-3">
                <label for="feedUrl" class="control-label">Feed URL (add one initially)</label>
                <input type="url" id="feedUrl" name="Feeds[0]" class="form-control" />
            </div>
            
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
