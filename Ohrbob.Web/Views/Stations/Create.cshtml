@model Ohrbob.Server.Shared.Data.Station

@{
    ViewData["Title"] = "Create Station";
}

<div class="page-head">
    <div class="page-head__text">
        <p class="metro-kicker">stations</p>
        <h1 class="metro-title metro-title--compact">new station</h1>
    </div>
</div>

<form asp-action="Create" hx-boost="false" class="form-narrow">
    <div class="form-group">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" asp-for="IsPublic">
            <label class="form-check-label" asp-for="IsPublic">
                Public Station
            </label>
        </div>
    </div>

    <fieldset class="feed-fieldset">
        <legend class="form-label">Feeds</legend>
        <div id="feedsContainer">
            <div class="feed-item">
                <input type="url" name="Feeds" class="form-control" placeholder="https://..." required aria-label="Feed URL" />
                <button type="button" class="btn btn-ghost remove-feed">Remove</button>
            </div>
        </div>
        <button type="button" id="addFeedBtn" class="btn btn-ghost form-add-feed">Add Feed</button>
    </fieldset>

    <div class="form-actions">
        <input type="submit" value="Create" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-ghost">Back to List</a>
    </div>
</form>

@* Loaded with the view content so htmx re-executes it after a boosted navigation. *@
<script src="~/js/station-create.js" asp-append-version="true"></script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
