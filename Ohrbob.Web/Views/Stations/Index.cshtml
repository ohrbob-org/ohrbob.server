@model List<Ohrbob.Server.Shared.Requests.StationWithFeedsDto>

@{
    ViewData["Title"] = "My Stations";
}

<h1>My Stations</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Station</a>
</p>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
    @foreach (var dto in Model)
    {
        var feedCount = dto.Feeds?.Count ?? 0;
        string gridClass = "collage-grid-1";
        if (feedCount > 1 && feedCount <= 4) gridClass = "collage-grid-2";
        else if (feedCount > 4 && feedCount <= 9) gridClass = "collage-grid-3";
        else if (feedCount > 9) gridClass = "collage-grid-4";
        
        var displayFeeds = dto.Feeds?.Take(16).ToList() ?? new List<Ohrbob.Server.Shared.Requests.FeedStatsDto>();

        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="collage-container @gridClass card-img-top">
                    @if (!displayFeeds.Any())
                    {
                        <div class="collage-fallback">?</div>
                    }
                    else
                    {
                        foreach (var feed in displayFeeds)
                        {
                            if (!string.IsNullOrEmpty(feed.ImageUrl))
                            {
                                <img src="@feed.ImageUrl" class="collage-item" alt="@feed.Title" onerror="this.outerHTML='<div class=\'collage-fallback\'>@((feed.Title.Length > 0 ? feed.Title[0].ToString() : "?").ToUpper())</div>'" />
                            }
                            else
                            {
                                <div class="collage-fallback">@((feed.Title.Length > 0 ? feed.Title[0].ToString() : "?").ToUpper())</div>
                            }
                        }
                    }
                </div>
                <div class="card-body">
                    <h5 class="card-title d-flex align-items-center">
                        @dto.Station.Name
                        @if (dto.IsUpdating)
                        {
                            <div class="spinner-border spinner-border-sm text-primary ms-2" role="status" title="Updating feeds...">
                                <span class="visually-hidden">Updating...</span>
                            </div>
                        }
                    </h5>
                    <p class="card-text">
                        <span class="badge @(dto.Station.IsPublic ? "bg-success" : "bg-secondary")">
                            @(dto.Station.IsPublic ? "Public" : "Private")
                        </span>
                        <small class="text-muted ms-2">@feedCount feeds</small>
                    </p>
                </div>
                <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between">
                    <a asp-action="Edit" asp-route-id="@dto.Station.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                    <form asp-action="Delete" asp-route-id="@dto.Station.Id" method="post">
                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this station?');">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
