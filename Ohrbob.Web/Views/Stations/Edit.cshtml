@model Ohrbob.Server.Shared.Requests.StationWithFeedsDto

@{
    ViewData["Title"] = "Edit Station";
}

<h1>Edit Station - @Model.Station.Name</h1>

<style>
.pill-nav {
    display: flex;
    background: #e9ecef;
    border-radius: 50px;
    padding: 5px;
    margin-bottom: 20px;
}
.pill-nav .nav-item {
    flex: 1;
    text-align: center;
}
.pill-nav .nav-link {
    border-radius: 50px;
    color: #495057;
    font-weight: 500;
}
.pill-nav .nav-link.active {
    background: #cce5ff;
    color: #004085;
}
</style>

<ul class="nav pill-nav" id="stationTabs" role="tablist">
  <li class="nav-item">
    <a class="nav-link active" id="feeds-tab" data-bs-toggle="tab" href="#feeds" role="tab">Feeds</a>
  </li>
  <li class="nav-item">
    <a class="nav-link" id="blueprint-tab" data-bs-toggle="tab" href="#blueprint" role="tab">Blueprint Rules</a>
  </li>
  <li class="nav-item">
    <a class="nav-link" id="resolved-tab" data-bs-toggle="tab" href="#resolved" role="tab">Resolved Episodes</a>
  </li>
</ul>

<div class="tab-content" id="stationTabsContent">
  <div class="tab-pane fade show active" id="feeds" role="tabpanel">
    <div id="feedsContainer">
        @foreach (var feed in Model.Feeds)
        {
            var scheduleFeed = Model.Station.Schedule.Feeds.FirstOrDefault(f => f.Url == feed.Url) ?? new Ohrbob.Server.Shared.Data.StationFeedSchedule { Url = feed.Url };
            
            <div class="card mb-3 feed-card" data-url="@feed.Url">
                <div class="card-body d-flex align-items-center">
                    <img src="@feed.ImageUrl" width="64" height="64" class="me-3 rounded" />
                    <div class="flex-grow-1">
                        <h5 class="card-title">@feed.Title</h5>
                        <p class="card-text text-muted mb-1">Episodes: @feed.EpisodeCount | Last Updated: @feed.LastUpdated</p>
                        <select class="form-select form-select-sm sort-order-select" style="width: auto;">
                            <option value="0" selected="@(scheduleFeed.SortOrder == Ohrbob.Server.Shared.Data.FeedSortOrder.OldestToNewest)">Oldest to Newest</option>
                            <option value="1" selected="@(scheduleFeed.SortOrder == Ohrbob.Server.Shared.Data.FeedSortOrder.NewestToOldest)">Newest to Oldest</option>
                        </select>
                    </div>
                    <button type="button" class="btn btn-outline-danger remove-feed">Remove</button>
                </div>
            </div>
        }
    </div>
    <div class="input-group mt-3">
        <input type="url" id="newFeedUrl" class="form-control" placeholder="https://..." />
        <button type="button" id="addFeedBtn" class="btn btn-primary">Add Feed</button>
    </div>
  </div>
  <div class="tab-pane fade" id="blueprint" role="tabpanel">
    <div class="d-flex flex-row overflow-auto py-3" id="blueprintContainer" style="gap: 10px;">
        @foreach(var feedSchedule in Model.Station.Schedule.Feeds)
        {
            var feedData = Model.Feeds.FirstOrDefault(f => f.Url == feedSchedule.Url);
            if (feedData != null)
            {
                <div class="blueprint-item border rounded p-2" draggable="true" data-url="@feedSchedule.Url" style="cursor: grab; min-width: 120px; text-align: center; background: #fff;">
                    <img src="@feedData.ImageUrl" width="64" height="64" class="mb-2" />
                    <div class="small text-truncate" style="max-width: 100px;" title="@feedData.Title">@feedData.Title</div>
                </div>
            }
        }
    </div>
  </div>
  <div class="tab-pane fade" id="resolved" role="tabpanel">
    @if (ViewBag.Playlist != null)
    {
        var playlist = (List<Ohrbob.Server.Shared.Requests.EpisodePlayStateDto>)ViewBag.Playlist;
        <div class="mt-3">
            <h4>Upcoming Playlist (Active Profile)</h4>
            <ul class="list-group" id="resolvedList">
                @foreach (var item in playlist)
                {
                    var activeClass = item.IsActive ? "list-group-item-primary" : "";
                    <li class="list-group-item @activeClass d-flex justify-content-between align-items-center resolved-item" data-episode-id="@item.Episode.Id">
                        <div>
                            <strong>@item.Episode.Title</strong><br/>
                            <small>
                                @if(item.IsActive) {
                                    <span class="badge bg-primary">Playing</span>
                                }
                                Position: @(item.PositionSeconds)s / Published: @(item.Episode.PublishedAt?.ToString("g"))
                            </small>
                        </div>
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-success mark-completed-btn">
                                Mark Completed
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-warning mark-completed-until-btn">
                                Mark All Until Here Completed
                            </button>
                        </div>
                    </li>
                }
                @if (!playlist.Any())
                {
                    <li class="list-group-item text-muted">No unplayed episodes found.</li>
                }
            </ul>
        </div>
    }
  </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const getVerificationToken = () => document.querySelector('input[name="__RequestVerificationToken"]').value;

            function updateSchedule(shouldReload = false) {
                const feedCards = document.querySelectorAll('.feed-card');
                const feeds = Array.from(feedCards).map(card => {
                    const url = card.getAttribute('data-url');
                    const sortOrderStr = card.querySelector('.sort-order-select').value;
                    return {
                        Url: url,
                        SortOrder: parseInt(sortOrderStr, 10)
                    };
                });

                const schedule = {
                    Feeds: feeds
                };

                fetch(`/Stations/UpdateSchedule/${"@Model.Station.Id"}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getVerificationToken()
                    },
                    body: JSON.stringify(schedule)
                })
                .then(response => {
                    if (response.ok) {
                        return fetch(window.location.href, { cache: 'no-store', headers: { 'Pragma': 'no-cache' } });
                    } else {
                        throw new Error('Server returned ' + response.status);
                    }
                })
                .then(res => res.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    
                    const newFeeds = doc.getElementById('feedsContainer');
                    if (newFeeds) document.getElementById('feedsContainer').innerHTML = newFeeds.innerHTML;

                    const newBlueprint = doc.getElementById('blueprintContainer');
                    if (newBlueprint) document.getElementById('blueprintContainer').innerHTML = newBlueprint.innerHTML;

                    const newResolved = doc.getElementById('resolved');
                    if (newResolved) document.getElementById('resolved').innerHTML = newResolved.innerHTML;
                })
                .catch(err => {
                    console.error('Error:', err);
                    alert('Error updating schedule');
                });
            }

            document.getElementById('feedsContainer').addEventListener('change', function (e) {
                if (e.target.classList.contains('sort-order-select')) {
                    updateSchedule();
                }
            });

            document.getElementById('feedsContainer').addEventListener('click', function (e) {
                if (e.target.classList.contains('remove-feed')) {
                    const card = e.target.closest('.feed-card');
                    if (confirm('Are you sure you want to remove this feed?')) {
                        card.remove();
                        updateSchedule();
                    }
                }
            });

            document.getElementById('addFeedBtn').addEventListener('click', function () {
                const input = document.getElementById('newFeedUrl');
                const url = input.value.trim();
                if (!url) return;

                // For a new feed, we simply append it to our in-memory list (via the DOM) and call updateSchedule.
                // The server will handle fetching its details and the reload will show the rich card.
                
                // create a temporary card or just simulate it and submit
                const container = document.getElementById('feedsContainer');
                const newCard = document.createElement('div');
                newCard.className = 'card mb-3 feed-card';
                newCard.setAttribute('data-url', url);
                newCard.innerHTML = `
                    <div class="card-body d-flex align-items-center">
                        <div class="flex-grow-1">
                            <select class="form-select form-select-sm sort-order-select d-none" style="width: auto;">
                                <option value="0" selected>Oldest to Newest</option>
                            </select>
                        </div>
                    </div>
                `;
                container.appendChild(newCard);
                input.value = '';
                updateSchedule();
            });

            // Blueprint Drag & Drop Logic
            const blueprintContainer = document.getElementById('blueprintContainer');
            if (blueprintContainer) {
                let draggedItem = null;

                blueprintContainer.addEventListener('dragstart', function (e) {
                    const item = e.target.closest('.blueprint-item');
                    if (item) {
                        draggedItem = item;
                        e.dataTransfer.effectAllowed = 'move';
                        setTimeout(() => item.style.opacity = '0.5', 0);
                    }
                });

                blueprintContainer.addEventListener('dragend', function (e) {
                    const item = e.target.closest('.blueprint-item');
                    if (item) {
                        item.style.opacity = '1';
                        draggedItem = null;
                        
                        // Sync feedsContainer order and update
                        syncFeedsOrderAndUpdate();
                    }
                });

                blueprintContainer.addEventListener('dragover', function (e) {
                    e.preventDefault();
                    e.dataTransfer.dropEffect = 'move';
                    const targetItem = e.target.closest('.blueprint-item');
                    
                    if (targetItem && targetItem !== draggedItem && draggedItem) {
                        const bounding = targetItem.getBoundingClientRect();
                        const offset = bounding.x + (bounding.width / 2);
                        
                        if (e.clientX - offset > 0) {
                            targetItem.after(draggedItem);
                        } else {
                            targetItem.before(draggedItem);
                        }
                    }
                });

                function syncFeedsOrderAndUpdate() {
                    const feedsContainer = document.getElementById('feedsContainer');
                    const blueprintItems = blueprintContainer.querySelectorAll('.blueprint-item');
                    
                    blueprintItems.forEach(bpItem => {
                        const url = bpItem.getAttribute('data-url');
                        const cards = Array.from(feedsContainer.querySelectorAll('.feed-card'));
                        const correspondingFeedCard = cards.find(card => card.getAttribute('data-url') === url);
                        if (correspondingFeedCard) {
                            feedsContainer.appendChild(correspondingFeedCard);
                        }
                    });
                    
                    updateSchedule();
                }
            }
            
            // Resolved List Buttons
            const resolvedTabPane = document.getElementById('resolved');
            if (resolvedTabPane) {
                resolvedTabPane.addEventListener('click', function(e) {
                    const btnCompleted = e.target.closest('.mark-completed-btn');
                    const btnUntil = e.target.closest('.mark-completed-until-btn');
                    
                    if (btnCompleted || btnUntil) {
                        const li = e.target.closest('.resolved-item');
                        if (!li) return;
                        const episodeId = li.getAttribute('data-episode-id');
                        
                        if (btnCompleted) {
                            if (confirm('Mark this episode as completed?')) {
                                fetch(`/Stations/MarkCompleted?id=${"@Model.Station.Id"}&episodeId=${episodeId}`, {
                                    method: 'POST',
                                    headers: {
                                        'RequestVerificationToken': getVerificationToken()
                                    }
                                })
                                .then(res => {
                                    if (res.ok || res.redirected) {
                                        li.remove();
                                    } else {
                                        alert('Error marking completed');
                                    }
                                })
                                .catch(err => alert('Error marking completed'));
                            }
                        } else if (btnUntil) {
                            if (confirm('Mark all episodes up to and including this one as completed?')) {
                                fetch(`/Stations/MarkCompletedUntil?id=${"@Model.Station.Id"}&episodeId=${episodeId}`, {
                                    method: 'POST',
                                    headers: {
                                        'RequestVerificationToken': getVerificationToken()
                                    }
                                })
                                .then(res => {
                                    if (res.ok || res.redirected) {
                                        // Remove this one and all preceding siblings
                                        let current = li;
                                        while(current) {
                                            const prev = current.previousElementSibling;
                                            current.remove();
                                            current = prev;
                                        }
                                    } else {
                                        alert('Error marking completed');
                                    }
                                })
                                .catch(err => alert('Error marking completed'));
                            }
                        }
                    }
                });
            }
        });
    </script>
}