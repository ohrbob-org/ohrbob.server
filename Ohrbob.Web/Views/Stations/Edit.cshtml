@model Ohrbob.Server.Shared.Data.Station

@{
    ViewData["Title"] = "Edit Station";
}

<h1>Edit Station</h1>

<h4>Station</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="AccountId" />

            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" asp-for="IsPublic">
                    <label class="form-check-label" asp-for="IsPublic">
                        Public Station
                    </label>
                </div>
            </div>

            <!-- Display existing feeds. Complex handling requires JS, but here's a basic array binding setup -->
            <div class="form-group mb-3" id="feedsContainer">
                <label class="control-label">Feeds</label>
                @if (Model.Feeds != null)
                {
                    for (int i = 0; i < Model.Feeds.Length; i++)
                    {
                        <input type="url" name="Feeds[@i]" class="form-control mb-2" value="@Model.Feeds[i]" />
                    }
                }
            </div>
            
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
