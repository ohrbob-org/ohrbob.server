@model Ohrbob.Server.Shared.Requests.StationWithFeedsDto

@{
    ViewData["Title"] = "Edit Station";
}

<h1 class="d-flex align-items-center">
    <span>Edit Station - </span>
    <span id="stationNameDisplay" class="ms-1">@Model.Station.Name</span>
    <button type="button" class="btn btn-link text-decoration-none p-0 ms-2 lh-1" id="renameStationBtn" title="Rename Station" style="font-size: 1.5rem; color: #6c757d;">
        <i class="bi bi-pencil-square"></i>
    </button>
</h1>

<style>
.pill-nav {
    display: flex;
    background: #e9ecef;
    border-radius: 50px;
    padding: 5px;
    margin-bottom: 20px;
}
.pill-nav .nav-item {
    flex: 1;
    text-align: center;
}
.pill-nav .nav-link {
    border-radius: 50px;
    color: #495057;
    font-weight: 500;
}
.pill-nav .nav-link.active {
    background: #cce5ff;
    color: #004085;
}

@@media (min-width: 992px) {
    #stationTabs {
        display: none !important;
    }
    #stationTabsContent {
        display: flex !important;
        flex-wrap: wrap !important;
    }
    #stationTabsContent .tab-pane {
        display: block !important;
        opacity: 1 !important;
        flex: 0 0 50% !important;
        max-width: 50% !important;
    }
}
</style>

<ul class="nav pill-nav d-lg-none" id="stationTabs" role="tablist">
  <li class="nav-item">
    <a class="nav-link active" id="rotation-tab" data-bs-toggle="tab" href="#rotation" role="tab">Rotation & Feeds</a>
  </li>
  <li class="nav-item">
    <a class="nav-link" id="resolved-tab" data-bs-toggle="tab" href="#resolved" role="tab">Resolved Episodes</a>
  </li>
</ul>

<div class="tab-content row" id="stationTabsContent">
  <div class="tab-pane fade show active col-12 col-lg-6" id="rotation" role="tabpanel">
    <h3>Rotation & Feeds</h3>
    <div class="list-group py-3" id="rotationContainer" style="max-width: 100%;">
        @{ var feedScheduleIndex = 0; }
        @foreach(var feedSchedule in Model.Station.Schedule.Feeds)
        {
            var feedData = Model.Feeds.FirstOrDefault(f => f.Url == feedSchedule.Url);
            if (feedData != null)
            {
                var currentFeedIndex = feedScheduleIndex++;
                <div class="list-group-item rotation-item border rounded mb-2 d-flex align-items-stretch" draggable="true" data-url="@feedSchedule.Url" style="cursor: grab; border-left: 4px solid @(string.IsNullOrEmpty(feedSchedule.Color) ? "#ccc" : feedSchedule.Color) !important; background-color: @(string.IsNullOrEmpty(feedSchedule.Color) ? "#fff" : feedSchedule.Color + "26") !important; padding: 0; overflow: hidden; height: 90px; max-height: 90px;">
                    <img src="@feedData.ImageUrl" style="width: 90px; height: 90px; object-fit: cover; flex-shrink: 0;" />
                    <div class="p-3 d-flex flex-wrap align-items-center justify-content-between flex-grow-1" style="gap: 15px;">
                        <div class="text-truncate" style="max-width: 250px;">
                            <strong class="text-dark">@feedData.Title</strong>
                            <span class="text-muted d-block" style="font-size: 10px; margin-top: 2px;">Episodes: @feedData.EpisodeCount | Last Updated: @feedData.LastUpdated</span>
                        </div>
                        
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <!-- 3-State Sliding Playback Order Toggle Control -->
                            @{
                                var activeValue = (int)feedSchedule.SortOrder;
                                var thumbLeft = activeValue == 1 ? "3px" : (activeValue == 2 ? "50%" : "calc(100% - 3px)");
                                var thumbTransform = activeValue == 1 ? "translateX(0)" : (activeValue == 2 ? "translateX(-50%)" : "translateX(-100%)");
                            }
                            <div class="playback-order-toggle-container d-inline-flex flex-column align-items-center" style="width: 200px;">
                                <!-- Capsule Slider Track -->
                                <div class="position-relative bg-light border rounded-pill d-flex align-items-center justify-content-between user-select-none"
                                     style="width: 100%; height: 32px; padding: 4px; background-color:#e8ebee !important; border: 1px solid #ced4da; cursor: pointer;"
                                     id="sliderTrack-@currentFeedIndex" role="slider" aria-valuemin="0" aria-valuemax="2" aria-valuenow="@activeValue">
                                     
                                     <!-- Sliding circular thumb -->
                                     <div class="slider-thumb-container bg-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                                          style="position: absolute; top: 3px; left: @thumbLeft; width: 24px; height: 24px; border: 1px solid rgba(255, 255, 255, 0.3); pointer-events: none; z-index: 20; transform: @thumbTransform; transition: left 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);">
                                          <i class="bi @(activeValue == 1 ? "bi-sort-down" : (activeValue == 2 ? "bi-shuffle" : "bi-sort-up")) text-white" style="font-size: 0.8rem;"></i>
                                     </div>

                                     <!-- Nodes -->
                                     <button type="button" onclick="window.setPlaybackOrder('@currentFeedIndex', 1)" class="playback-node-btn position-relative" style="z-index: 10; width: 33.333%; height: 100%; border: none; background: none; color: #6c757d;" title="Backwards">
                                         <i class="bi bi-sort-down" style="position: absolute; left: 3px; top: 0; width: 24px; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem;"></i>
                                     </button>
                                     <button type="button" onclick="window.setPlaybackOrder('@currentFeedIndex', 2)" class="playback-node-btn position-relative" style="z-index: 10; width: 33.333%; height: 100%; border: none; background: none; color: #6c757d; display: flex; align-items: center; justify-content: center;" title="Random">
                                         <i class="bi bi-shuffle" style="font-size: 0.75rem;"></i>
                                     </button>
                                     <button type="button" onclick="window.setPlaybackOrder('@currentFeedIndex', 0)" class="playback-node-btn position-relative" style="z-index: 10; width: 33.333%; height: 100%; border: none; background: none; color: #6c757d;" title="Forwards">
                                         <i class="bi bi-sort-up" style="position: absolute; right: 3px; top: 0; width: 24px; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem;"></i>
                                     </button>
                                </div>

                                <!-- Labels below -->
                                <div class="d-flex w-100 justify-content-between mt-1 text-center" style="font-size: 9px; line-height: 1;">
                                    <button type="button" onclick="window.setPlaybackOrder('@currentFeedIndex', 1)" id="label-1-@currentFeedIndex" class="flex-fill d-flex flex-column align-items-center border-0 bg-transparent py-0 px-0" style="outline: none;">
                                        <span class="fw-bold @(activeValue == 1 ? "text-primary" : "text-muted")">Backwards</span>
                                    </button>
                                    <button type="button" onclick="window.setPlaybackOrder('@currentFeedIndex', 2)" id="label-2-@currentFeedIndex" class="flex-fill d-flex flex-column align-items-center border-0 bg-transparent py-0 px-0" style="outline: none;">
                                        <span class="fw-bold @(activeValue == 2 ? "text-primary" : "text-muted")">Random</span>
                                    </button>
                                    <button type="button" onclick="window.setPlaybackOrder('@currentFeedIndex', 0)" id="label-0-@currentFeedIndex" class="flex-fill d-flex flex-column align-items-center border-0 bg-transparent py-0 px-0" style="outline: none;">
                                        <span class="fw-bold @(activeValue == 0 ? "text-primary" : "text-muted")">Forwards</span>
                                    </button>
                                </div>

                                <!-- Hidden value input -->
                                <input type="hidden" class="playback-order-value" value="@activeValue" />
                            </div>

                            <div class="d-flex align-items-center" style="width: 140px;">
                                <span class="small text-muted me-1" style="font-size: 11px; white-space: nowrap;">
                                    Eps/turn
                                    <i class="bi bi-question-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top" title="How many unplayed episodes this feed contributes on its turn before rotating to the next." style="cursor: help; font-size: 0.85rem;"></i>:
                                </span>
                                <input type="number" class="form-control form-control-sm episodes-input" min="1" max="99" value="@(feedSchedule.EpisodesToPlay < 1 ? 1 : feedSchedule.EpisodesToPlay)" style="width: 60px;" />
                            </div>

                            <button type="button" class="btn btn-link text-danger remove-feed p-0" title="Remove Feed" style="font-size: 1.2rem; line-height: 1;">
                                <i class="bi bi-trash3-fill"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
    <div class="input-group mt-3">
        <input type="url" id="newFeedUrl" class="form-control" placeholder="https://..." />
        <button type="button" id="addFeedBtn" class="btn btn-primary">Add Feed</button>
    </div>
  </div>
  <div class="tab-pane fade col-12 col-lg-6" id="resolved" role="tabpanel">
    @if (ViewBag.Playlist != null)
    {
        var playlist = (List<Ohrbob.Server.Shared.Requests.EpisodePlayStateDto>)ViewBag.Playlist;
        <div class="mt-3">
            <h4>Upcoming Playlist (Active Profile)</h4>
            <ul class="list-group" id="resolvedList">
                @foreach (var item in playlist)
                {
                    var activeClass = item.IsActive ? "list-group-item-primary" : "";
                    var feedColor = Model.Station.Schedule.Feeds.FirstOrDefault(f => f.Url == item.Episode.FeedUrl)?.Color ?? "#ccc";
                    <li class="list-group-item @activeClass d-flex justify-content-between align-items-center resolved-item" data-episode-id="@item.Episode.Id" style="border-left: 4px solid @(feedColor) !important; background-color: @(feedColor + "26") !important;">
                        <div>
                            <strong>@item.Episode.Title</strong><br/>
                            <small>
                                @if(item.IsActive) {
                                    <span class="badge bg-primary">Playing</span>
                                }
                                Position: @(item.PositionSeconds)s / Published: @(item.Episode.PublishedAt?.ToString("g"))
                            </small>
                        </div>
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-success mark-completed-btn">
                                Mark Completed
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-warning mark-completed-until-btn">
                                Mark All Until Here Completed
                            </button>
                        </div>
                    </li>
                }

                @if (!playlist.Any())
                {
                    <li class="list-group-item text-muted">No unplayed episodes found.</li>
                }
            </ul>
        </div>
    }
  </div>
</div>

<!-- Rename Station Modal -->
<div class="modal fade" id="renameStationModal" tabindex="-1" aria-labelledby="renameStationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="renameStationModalLabel">Rename Station</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-dark">
                <div class="mb-3">
                    <label for="newStationNameInput" class="form-label">New Station Name</label>
                    <input type="text" class="form-control" id="newStationNameInput" placeholder="Enter station name" required />
                    <div class="invalid-feedback d-none" id="renameErrorMsg">
                        Station name cannot be empty.
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveStationNameBtn">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<script>
        (function () {
            console.log("IIFE EXECUTED");
            const getVerificationToken = () => document.querySelector('input[name="__RequestVerificationToken"]').value;

            let activeTooltips = [];
            function initTooltips() {
                activeTooltips.forEach(t => { if (typeof t.dispose === 'function') t.dispose(); });
                activeTooltips = [];

                const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                activeTooltips = tooltipTriggerList.map(function (tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl);
                });
            }

            function updateSchedule(shouldReload = false) {
                console.log("UPDATE SCHEDULE CALLED");
                const rotationItems = document.querySelectorAll('#rotationContainer .rotation-item');
                const feeds = Array.from(rotationItems).map(item => {
                    const url = item.getAttribute('data-url');
                    const sortOrderStr = item.querySelector('.playback-order-value').value;
                    const epsInput = item.querySelector('.episodes-input');
                    let epsToPlay = 1;
                    if (epsInput) {
                        epsToPlay = parseInt(epsInput.value, 10);
                        if (isNaN(epsToPlay)) epsToPlay = 1;
                        if (epsToPlay < 1) epsToPlay = 1;
                        if (epsToPlay > 99) epsToPlay = 99;
                    }

                    return {
                        Url: url,
                        SortOrder: parseInt(sortOrderStr, 10),
                        EpisodesToPlay: epsToPlay
                    };
                });

                const schedule = {
                    Feeds: feeds
                };

                fetch(`/Stations/UpdateSchedule/${"@Model.Station.Id"}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getVerificationToken()
                    },
                    body: JSON.stringify(schedule)
                })
                .then(response => {
                    if (response.ok) {
                        return fetch(window.location.href, { cache: 'no-store', headers: { 'Pragma': 'no-cache' } });
                    } else {
                        throw new Error('Server returned ' + response.status);
                    }
                })
                .then(res => res.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');

                    const newRotation = doc.getElementById('rotationContainer');
                    if (newRotation) {
                        document.getElementById('rotationContainer').innerHTML = newRotation.innerHTML;
                        bindRotationListeners();
                    }

                    const newResolved = doc.getElementById('resolved');
                    if (newResolved) document.getElementById('resolved').innerHTML = newResolved.innerHTML;
                })
                .catch(err => {
                    console.error('Error:', err);
                    document.body.dispatchEvent(new CustomEvent('showToast', {
                        detail: { message: 'Error updating schedule.', type: 'danger' }
                    }));
                });
            }

            document.getElementById('rotationContainer').addEventListener('click', function (e) {
                if (e.target.classList.contains('remove-feed')) {
                    const item = e.target.closest('.rotation-item');
                    if (confirm('Are you sure you want to remove this feed?')) {
                        item.remove();
                        updateSchedule();
                    }
                }
            });

            document.getElementById('addFeedBtn').addEventListener('click', function () {
                console.log("ADD FEED CLICKED");
                const input = document.getElementById('newFeedUrl');
                const url = input.value.trim();
                if (!url) return;

                const container = document.getElementById('rotationContainer');
                const newItem = document.createElement('div');
                newItem.className = 'list-group-item rotation-item border rounded p-3 mb-2';
                newItem.setAttribute('data-url', url);
                newItem.innerHTML = `
                    <input type="hidden" class="playback-order-value" value="0" />
                    <input type="number" class="episodes-input" value="1" style="display:none;" />
                `;
                container.appendChild(newItem);
                input.value = '';
                updateSchedule();
            });

            function handleEpisodesChange(e) {
                if (e.target.classList.contains('episodes-input')) {
                    let val = parseInt(e.target.value, 10);
                    if (isNaN(val)) val = 1;
                    if (val < 1) val = 1;
                    if (val > 99) val = 99;
                    e.target.value = val;
                    updateSchedule();
                }
            }

            function bindRotationListeners() {
                const container = document.getElementById('rotationContainer');
                if (container) {
                    container.removeEventListener('change', handleEpisodesChange);
                    container.addEventListener('change', handleEpisodesChange);
                }
                initTooltips();
            }

            // Rotation Drag & Drop Logic
            const rotationContainer = document.getElementById('rotationContainer');
            if (rotationContainer) {
                let draggedItem = null;

                rotationContainer.addEventListener('dragstart', function (e) {
                    const item = e.target.closest('.rotation-item');
                    if (item) {
                        draggedItem = item;
                        e.dataTransfer.effectAllowed = 'move';
                        setTimeout(() => item.style.opacity = '0.5', 0);
                    }
                });

                rotationContainer.addEventListener('dragend', function (e) {
                    const item = e.target.closest('.rotation-item');
                    if (item) {
                        item.style.opacity = '1';
                        draggedItem = null;
                        
                        updateSchedule();
                    }
                });

                rotationContainer.addEventListener('dragover', function (e) {
                    e.preventDefault();
                    e.dataTransfer.dropEffect = 'move';
                    const targetItem = e.target.closest('.rotation-item');
                    
                    if (targetItem && targetItem !== draggedItem && draggedItem) {
                        const bounding = targetItem.getBoundingClientRect();
                        const offset = bounding.y + (bounding.height / 2);
                        
                        if (e.clientY - offset > 0) {
                            targetItem.after(draggedItem);
                        } else {
                            targetItem.before(draggedItem);
                        }
                    }
                });
            }
            
            // Resolved List Buttons
            const resolvedTabPane = document.getElementById('resolved');
            if (resolvedTabPane) {
                resolvedTabPane.addEventListener('click', function(e) {
                    const btnCompleted = e.target.closest('.mark-completed-btn');
                    const btnUntil = e.target.closest('.mark-completed-until-btn');
                    
                    if (btnCompleted || btnUntil) {
                        const li = e.target.closest('.resolved-item');
                        console.log("MARK COMPLETED CLICKED", li);
                        if (!li) return;
                        const episodeId = li.getAttribute('data-episode-id');
                        
                        if (btnCompleted) {
                            if (confirm('Mark this episode as completed?')) {
                                fetch(`/Stations/MarkCompleted?id=${"@Model.Station.Id"}&episodeId=${episodeId}`, {
                                    method: 'POST',
                                    headers: {
                                        'RequestVerificationToken': getVerificationToken()
                                    }
                                })
                                .then(res => {
                                    if (res.ok || res.redirected) {
                                        console.log("MARK COMPLETED SUCCESS", li);
                                        li.remove();
                                    } else {
                                        alert('Error marking completed');
                                    }
                                })
                                .catch(err => alert('Error marking completed'));
                            }
                        } else if (btnUntil) {
                            if (confirm('Mark all episodes up to and including this one as completed?')) {
                                fetch(`/Stations/MarkCompletedUntil?id=${"@Model.Station.Id"}&episodeId=${episodeId}`, {
                                    method: 'POST',
                                    headers: {
                                        'RequestVerificationToken': getVerificationToken()
                                    }
                                })
                                .then(res => {
                                    if (res.ok || res.redirected) {
                                        // Remove this one and all preceding siblings
                                        let current = li;
                                        while(current) {
                                            const prev = current.previousElementSibling;
                                            current.remove();
                                            current = prev;
                                        }
                                    } else {
                                        alert('Error marking completed');
                                    }
                                })
                                .catch(err => alert('Error marking completed'));
                            }
                        }
                    }
                });
            }
            window.setPlaybackOrder = function (hashId, value) {
                const track = document.getElementById(`sliderTrack-${hashId}`);
                if (!track) return;

                const container = track.closest('.playback-order-toggle-container');
                const thumb = container.querySelector('.slider-thumb-container');
                const input = container.querySelector('.playback-order-value');
                const icon = thumb.querySelector('i');

                // Update value
                input.value = value;
                track.setAttribute('aria-valuenow', value);

                // Update thumb position and transform dynamically
                const left = value === 1 ? '3px' : (value === 2 ? '50%' : 'calc(100% - 3px)');
                const transform = value === 1 ? 'translateX(0)' : (value === 2 ? 'translateX(-50%)' : 'translateX(-100%)');
                thumb.style.left = left;
                thumb.style.transform = transform;

                // Update icon
                icon.className = `bi ${value === 1 ? 'bi-sort-down' : (value === 2 ? 'bi-shuffle' : 'bi-sort-up')} text-white`;

                // Highlight text labels
                const values = [1, 2, 0];
                values.forEach(v => {
                    const label = document.getElementById(`label-${v}-${hashId}`);
                    if (label) {
                        const span = label.querySelector('span:first-child');
                        if (v === value) {
                            span.className = 'fw-bold text-primary';
                        } else {
                            span.className = 'fw-bold text-muted';
                        }
                    }
                });

                // Trigger saving the schedule change asynchronously
                updateSchedule();
            };

            bindRotationListeners();
            initTooltips();

            // Initialize rename station functionality
            window.initRenameStation("@Model.Station.Id");
        })();
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
