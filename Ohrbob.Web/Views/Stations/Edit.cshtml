@model Ohrbob.Server.Shared.Requests.StationWithFeedsDto
@using Ohrbob.Server.Shared.Text

@{
    ViewData["Title"] = "Edit Station";
}

<div id="dock-sentinel" style="height: 1px; margin-top: -1px;"></div>
<div id="dockable-header">
    <h1 class="d-flex align-items-center justify-content-between mb-1">
        <span class="d-flex align-items-center">
            <span>Edit Station - </span>
            <span id="stationNameDisplay" class="ms-1">@Model.Station.Name</span>
            @if (Model.Station.HostPaceEnabled)
            {
                <span class="badge bg-info text-white ms-2 fs-6" title="Only episodes the host has completed are available">Host Pace</span>
            }
        </span>
        <button type="button" class="btn btn-link text-decoration-none p-0 lh-1" id="renameStationBtn" title="Station Settings" style="font-size: 1.5rem; color: #6c757d;">
            <i class="bi bi-gear-fill"></i>
        </button>
    </h1>

    <ul class="nav pill-nav d-lg-none" id="stationTabs" role="tablist" style="margin-bottom: 0;">
      <li class="nav-item">
        <a class="nav-link active" id="rotation-tab" data-bs-toggle="tab" href="#rotation" role="tab">Rotation & Feeds</a>
      </li>
      <li class="nav-item">
        <a class="nav-link" id="resolved-tab" data-bs-toggle="tab" href="#resolved" role="tab">Resolved Episodes</a>
      </li>
    </ul>
</div>

<style>
#dockable-header {
    position: sticky;
    top: 90px;
    z-index: 1040;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    background: transparent;
    padding: 10px 0;
    margin-bottom: 20px;
}
#dockable-header.docked {
    top: 62px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 12px 12px;
    border-radius: 0 0 30px 30px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.04);
    border-top: none;
    margin-top: -24px;
}
#dockable-header h1 {
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    margin: 0;
}
#dockable-header.docked h1 {
    font-size: 1.5rem;
    margin-bottom: 2px !important;
}
.pill-nav {
    display: flex;
    background: var(--bs-secondary-bg);
    border-radius: 50px;
    padding: 5px;
    margin-bottom: 20px;
}
.pill-nav .nav-item {
    flex: 1;
    text-align: center;
}
.pill-nav .nav-link {
    border-radius: 50px;
    color: #495057;
    font-weight: 500;
}
.pill-nav .nav-link.active {
    background: #cce5ff;
    color: #004085;
}
.rotation-item {
    flex-shrink: 0;
}

@@media (min-width: 992px) {
    #stationTabs {
        display: none !important;
    }
    #stationTabsContent {
        display: flex !important;
        flex-wrap: wrap !important;
    }
    #stationTabsContent .tab-pane {
        display: block !important;
        opacity: 1 !important;
        flex: 0 0 50% !important;
        max-width: 50% !important;
    }
    #rotationContainer, #resolvedList {
        height: calc(100vh - 380px);
        min-height: 300px;
        overflow-y: auto;
        padding-right: 5px;
        position: relative;
    }
}
</style>


<div class="tab-content row" id="stationTabsContent">
  <div class="tab-pane fade show active col-12 col-lg-6" id="rotation" role="tabpanel">
    <h3>Rotation & Feeds</h3>
    <div class="list-group py-3" id="rotationContainer" style="max-width: 100%;">
        @{ var feedScheduleIndex = 0; }
        @foreach(var feedSchedule in Model.Station.Schedule.Feeds)
        {
            var feedData = Model.Feeds.FirstOrDefault(f => f.Url == feedSchedule.Url);
            if (feedData != null)
            {
                var currentFeedIndex = feedScheduleIndex++;
                var activeValue = (int)feedSchedule.SortOrder;
                var feedAccent = string.IsNullOrEmpty(feedSchedule.Color) ? "#ff9a00" : feedSchedule.Color;
                <div class="list-group-item rotation-item card-station-feed mb-2" draggable="true" data-url="@feedSchedule.Url" style="--station-feed-accent: @feedAccent;">
                    <i class="bi bi-soundwave card-station-feed-watermark" aria-hidden="true"></i>
                    @if (!string.IsNullOrEmpty(feedData.ImageUrl))
                    {
                        <img src="@feedData.ImageUrl" class="card-station-feed-cover" alt="" />
                    }
                    else
                    {
                        <div class="card-station-feed-cover d-flex align-items-center justify-content-center fw-bold" aria-hidden="true">@((feedData.Title.Length > 0 ? feedData.Title[0].ToString() : "?").ToUpper())</div>
                    }
                    <div class="card-station-feed-body">
                        <!-- Row 1: Feed Title (Top) -->
                        <div class="card-station-feed-title-row">
                            <span class="card-station-feed-dot" aria-hidden="true"></span>
                            <strong class="card-station-feed-title" title="@feedData.Title">@feedData.Title</strong>
                        </div>

                        <!-- Row 2: Playback order, span input, actions menu (Middle) -->
                        <div class="card-station-feed-controls">
                            <div class="card-station-feed-controls-left">
                                <!-- 3-State Sliding Playback Order Toggle Control -->
                                <div class="playback-order-toggle-container">
                                    <div class="playback-order-toggle" id="sliderTrack-@currentFeedIndex" role="slider"
                                         aria-label="Playback order" aria-valuemin="0" aria-valuemax="2" aria-valuenow="@activeValue">
                                        <span class="slider-thumb-container" aria-hidden="true">
                                            <i class="bi @(activeValue == 1 ? "bi-sort-down" : (activeValue == 2 ? "bi-shuffle" : "bi-sort-up"))"></i>
                                        </span>
                                        <button type="button" onclick="window.setPlaybackOrder('@currentFeedIndex', 1)" class="playback-node-btn" title="Backwards: Newest to Oldest" data-bs-toggle="tooltip">
                                            <i class="bi bi-sort-down"></i>
                                        </button>
                                        <button type="button" onclick="window.setPlaybackOrder('@currentFeedIndex', 2)" class="playback-node-btn" title="Random" data-bs-toggle="tooltip">
                                            <i class="bi bi-shuffle"></i>
                                        </button>
                                        <button type="button" onclick="window.setPlaybackOrder('@currentFeedIndex', 0)" class="playback-node-btn" title="Forwards: Oldest to Newest" data-bs-toggle="tooltip">
                                            <i class="bi bi-sort-up"></i>
                                        </button>
                                    </div>

                                    <!-- Hidden value input -->
                                    <input type="hidden" class="playback-order-value" value="@activeValue" />
                                </div>

                                <!-- Span input group -->
                                <label class="card-station-feed-span">
                                    <span>
                                        Span
                                        <i class="bi bi-question-circle" data-bs-toggle="tooltip" data-bs-placement="top" title="How many unplayed episodes this feed contributes on its turn before rotating to the next."></i>:
                                    </span>
                                    <input type="number" class="form-control form-control-sm episodes-input" min="1" max="99" value="@(feedSchedule.EpisodesToPlay < 1 ? 1 : feedSchedule.EpisodesToPlay)" />
                                </label>
                            </div>

                            <!-- Three-dot feed actions menu -->
                            <div class="dropdown">
                                <button type="button" class="btn btn-link card-station-feed-menu feed-actions-menu" data-bs-toggle="dropdown" aria-expanded="false" title="Feed options">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><button type="button" class="dropdown-item move-feed"><i class="bi bi-arrow-left-right me-2"></i>Move to another station</button></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><button type="button" class="dropdown-item text-danger remove-feed"><i class="bi bi-trash3-fill me-2"></i>Delete feed</button></li>
                                </ul>
                            </div>
                        </div>

                        <!-- Row 3: Feed Details (Bottom) -->
                        <div class="card-station-feed-meta">Episodes: @feedData.EpisodeCount | Last Updated: @feedData.LastUpdated</div>
                    </div>
                </div>
            }
        }
        
        
        <div class="mt-4 d-flex align-items-center justify-content-center" style="gap: 12px;">
            Add more to Station:
        </div>
        <div class="mt-1 mb-4 d-flex align-items-center justify-content-center flex-wrap" style="gap: 12px;">
            <a href="/Discover" class="btn btn-primary d-inline-flex align-items-center">
                <i class="bi bi-compass me-2"></i>Discover
            </a>
            <div class="dropdown">
                <button type="button" class="btn btn-outline-secondary d-inline-flex align-items-center" id="stationMoreMenuBtn" data-bs-toggle="dropdown" aria-expanded="false" aria-haspopup="true">
                    <i class="bi bi-three-dots me-2"></i>More
                </button>
                <ul class="dropdown-menu" id="stationMoreMenu" aria-labelledby="stationMoreMenuBtn">
                    <li>
                        <button type="button" class="dropdown-item d-flex align-items-center" id="manualAddBtn">
                            <i class="bi bi-plus-circle me-2"></i>Feed Url
                        </button>
                    </li>
                    <li>
                        <button type="button" class="dropdown-item d-flex align-items-center" id="importOpmlBtn">
                            <i class="bi bi-file-earmark-arrow-up me-2"></i>Import OPML
                        </button>
                    </li>
                </ul>
            </div>
        </div>

        <div class="mt-4 d-flex align-items-center justify-content-center" style="gap: 12px;">
            Share Station:
        </div>
        <div class="mb-4 mx-auto d-flex align-items-center gap-2 border rounded px-3 py-2 bg-body-tertiary" style="max-width: 760px;">
            <i class="bi bi-link-45deg fs-4 text-body-secondary" aria-hidden="true"></i>
            <input type="text" id="shareStationUrl" class="form-control border-0 shadow-none flex-grow-1"
                   readonly value="@Url.Action("Index", "Share", new { code = Model.Station.ShareCode }, Context.Request.Scheme)" aria-label="Station share link" />
            <select id="shareVisibilitySelect" class="form-select" style="width: auto;" aria-label="Station visibility">
                <option value="public" selected="@(Model.Station.IsPublic)">Public</option>
                <option value="private" selected="@(!Model.Station.IsPublic)">Private</option>
            </select>
            <button type="button" class="btn btn-outline-secondary text-nowrap" id="copyShareLinkBtn">
                <i class="bi bi-clipboard me-1"></i>Copy
            </button>
        </div>
        
    </div>
    
  </div>
  <div class="tab-pane fade col-12 col-lg-6" id="resolved" role="tabpanel">
    @if (ViewBag.Playlist != null)
    {
        var playlist = (List<Ohrbob.Server.Shared.Requests.EpisodePlayStateDto>)ViewBag.Playlist;
        <div class="mt-3">
            <h4 class="mb-3">Upcoming Playlist & Playhead</h4>
            <ul class="list-group" id="resolvedList">
                @foreach (var item in playlist)
                {
                    var feedColor = Model.Station.Schedule.Feeds.FirstOrDefault(f => f.Url == item.Episode.FeedUrl)?.Color ?? "#ccc";
                    var episodeTitle = HtmlText.ToDisplayText(item.Episode.Title);
                    <li class="card-episode resolved-item mb-2 @(item.IsActive ? "is-playing" : "") @(item.IsCompleted ? "is-played" : "")"
                        data-episode-id="@item.Episode.Id"
                        data-feed-color="@(feedColor)"
                        style="@(item.IsCompleted ? "" : $"--card-episode-accent: {feedColor};")">

                        <!-- Feed badge (left) -->
                        <span class="card-episode-badge" aria-hidden="true"><i class="bi bi-mic"></i></span>

                        <!-- Metadata (Middle) -->
                        <div class="card-episode-body">
                            <div class="card-episode-kicker">
                                <i class="bi bi-mic" aria-hidden="true"></i> Episode
                                @if (item.IsActive)
                                {
                                    <span class="badge bg-primary ms-1">Playing</span>
                                }
                            </div>
                            <h3 class="card-episode-title" title="@episodeTitle"><strong>@episodeTitle</strong></h3>
                            <p class="card-episode-meta episode-description">@HtmlText.ToDisplayText(item.Episode.PlainDescription)</p>
                            <div class="d-flex align-items-center flex-wrap" style="gap: 6px;">
                                <small class="card-episode-meta">
                                    Position: <span class="episode-position">@(item.PositionSeconds)</span>s / Published: @(item.Episode.PublishedAt?.ToString("g"))
                                </small>
                                <div class="d-inline-flex align-items-center" style="gap: 2px;">
                                    <button type="button" class="btn btn-link p-0 px-1 reset-playhead-btn" title="Reset playhead to 0" style="font-size: 0.75rem; line-height: 1;" data-station-id="@Model.Station.Id" data-episode-id="@item.Episode.Id" data-position="@item.PositionSeconds">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>
                                    <button type="button" class="btn btn-link p-0 px-1 set-playhead-btn" title="Set playhead position" style="font-size: 0.75rem; line-height: 1;" data-station-id="@Model.Station.Id" data-episode-id="@item.Episode.Id" data-position="@item.PositionSeconds">
                                        <i class="bi bi-sliders"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Play + Action Controls (Right) -->
                        <div class="d-flex flex-column align-items-end justify-content-center flex-shrink-0" style="gap: 6px;">
                            <button type="button" class="card-episode-play continue-episode-btn" title="Continue playing from @(item.PositionSeconds)s" aria-label="Play @episodeTitle from @(item.PositionSeconds) seconds" data-station-id="@Model.Station.Id" data-episode-id="@item.Episode.Id" data-position="@item.PositionSeconds">
                                <i class="bi bi-play-fill" aria-hidden="true"></i>
                            </button>
                                <div class="button-container d-flex flex-column gap-1 w-100">
                                    @if (item.IsCompleted)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger w-100 py-1 clear-completed-btn" title="Clear completed state" style="font-size: 0.75rem; padding: 2px 4px;">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary w-100 py-1 clear-completed-until-btn" title="Clear everything until here" style="font-size: 0.75rem; padding: 2px 4px;">
                                            <span class="d-inline-flex position-relative align-items-center" style="width: 18px; height: 12px; vertical-align: middle;">
                                                <i class="bi bi-arrow-counterclockwise" style="position: absolute; left: 0px; top: -2px; opacity: 0.6; font-size: 0.7rem;"></i>
                                                <i class="bi bi-arrow-counterclockwise" style="position: absolute; left: 4px; top: 0px; opacity: 0.8; font-size: 0.7rem;"></i>
                                                <i class="bi bi-arrow-counterclockwise" style="position: absolute; left: 8px; top: 2px; font-size: 0.7rem;"></i>
                                            </span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success w-100 py-1 mark-completed-btn" title="Mark Completed" style="font-size: 0.75rem; padding: 2px 4px;">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-warning w-100 py-1 mark-completed-until-btn" title="Mark All Until Here Completed" style="font-size: 0.75rem; padding: 2px 4px;">
                                            <span class="d-inline-flex position-relative align-items-center" style="width: 18px; height: 12px; vertical-align: middle;">
                                                <i class="bi bi-check" style="position: absolute; left: 0px; top: -3px; opacity: 0.6; font-size: 0.7rem;"></i>
                                                <i class="bi bi-check" style="position: absolute; left: 4px; top: -1px; opacity: 0.8; font-size: 0.7rem;"></i>
                                                <i class="bi bi-check-lg" style="position: absolute; left: 8px; top: 1px; font-size: 0.7rem;"></i>
                                            </span>
                                        </button>
                                    }
                            </div>
                        </div>
                    </li>
                }
                @if (!playlist.Any())
                {
                    <li class="list-group-item text-muted text-center py-4">No episodes found.</li>
                }
            </ul>
        </div>
    }
  </div>
</div>

<!-- Rename Station Modal (now Settings Modal) -->
<div class="modal fade" id="renameStationModal" tabindex="-1" aria-labelledby="renameStationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="renameStationModalLabel">Station Settings</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-body">
                <div class="mb-3">
                    <label for="newStationNameInput" class="form-label">Station Name</label>
                    <input type="text" class="form-control" id="newStationNameInput" placeholder="Enter station name" required />
                    <div class="invalid-feedback d-none" id="renameErrorMsg">
                        Station name cannot be empty.
                    </div>
                </div>
                <div class="form-check form-switch mt-3">
                    <input class="form-check-input" type="checkbox" role="switch" id="isAgingInput" @(Model.Station.IsAging ? "checked" : "")>
                    <label class="form-check-label text-body" for="isAgingInput">Enable Aging Content (Only keep the newest episode unplayed)</label>
                </div>
                <div class="form-check form-switch mt-3">
                    <input class="form-check-input" type="checkbox" role="switch" id="endlessSpinInput" @(Model.Station.EndlessSpin ? "checked" : "")>
                    <label class="form-check-label text-body" for="endlessSpinInput">Endless Spin &mdash; start over at the first episode after the last one, forever</label>
                </div>
                <div class="form-check form-switch mt-3">
                    <input class="form-check-input" type="checkbox" role="switch" id="isPublicInput" @(Model.Station.IsPublic ? "checked" : "")>
                    <label class="form-check-label text-body" for="isPublicInput">Public station &mdash; anyone with the link can view and subscribe</label>
                </div>
                @{
                    var ownerProfiles = ViewBag.Profiles as List<Ohrbob.Server.Shared.Data.Profile> ?? new();
                }
                <div class="form-check form-switch mt-3">
                    <input class="form-check-input" type="checkbox" role="switch" id="hostPaceInput" @(Model.Station.HostPaceEnabled ? "checked" : "")>
                    <label class="form-check-label text-body" for="hostPaceInput">Host Pace &mdash; subscribers can only play episodes the host has completed</label>
                </div>
                <div class="mt-2 ms-4 ps-3 border-start @(Model.Station.HostPaceEnabled ? "" : "d-none")" id="hostProfileContainer">
                    <label class="form-label" for="hostProfileSelect">Host profile</label>
                    <select class="form-select" id="hostProfileSelect">
                        @foreach (var profile in ownerProfiles)
                        {
                            <option value="@profile.Id" selected="@(profile.Id == Model.Station.HostProfileId)">@profile.Name</option>
                        }
                    </select>
                    <div class="form-text">Host Pace uses this profile's completed episodes. Your other profiles are also limited to those episodes.</div>
                </div>
            </div>
            <div class="modal-footer">
                <form asp-action="Delete" asp-route-id="@Model.Station.Id" method="post" hx-target="#main-content" hx-swap="innerHTML" hx-push-url="/Stations" id="delete-station-form-edit" class="me-auto">
                    <button type="button" class="btn btn-outline-danger" id="deleteStationBtn">
                        <i class="bi bi-trash3-fill me-1"></i>Delete
                    </button>
                </form>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveStationNameBtn">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Confirm Remove Feed Modal -->
<div class="modal" id="confirmRemoveFeedModal" tabindex="-1" aria-labelledby="confirmRemoveFeedModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmRemoveFeedModalLabel">Confirm Removal</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-body">
                Are you sure you want to remove this feed?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmRemoveFeedBtn">Remove</button>
            </div>
        </div>
    </div>
</div>

<!-- Manual Add Feed Modal -->
<div class="modal fade" id="manualAddFeedModal" tabindex="-1" aria-labelledby="manualAddFeedModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="manualAddFeedModalLabel">Manual Add Feed</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-body">
                <div class="mb-3">
                    <label for="newFeedUrl" class="form-label">Feed RSS URL</label>
                    <input type="url" class="form-control" id="newFeedUrl" placeholder="https://..." required />
                    <div class="invalid-feedback d-none" id="manualAddErrorMsg">
                        Please enter a valid RSS feed URL.
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="submitManualAddBtn">Add Feed</button>
            </div>
        </div>
    </div>
</div>

<!-- Import OPML Modal -->
<div class="modal fade" id="importOpmlModal" tabindex="-1" aria-labelledby="importOpmlModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="importOpmlModalLabel">Import OPML</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-body">
                <div class="mb-3">
                    <label for="opmlFileInput" class="form-label">OPML file</label>
                    <input type="file" class="form-control" id="opmlFileInput" accept=".opml,.xml,text/xml,application/xml" />
                    <div class="invalid-feedback" id="opmlErrorMsg">Please choose an OPML file.</div>
                </div>
                <p class="text-muted small mb-0">
                    Every feed in the file is added to this station, up to your plan's feed limit.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="submitOpmlBtn">Import</button>
            </div>
        </div>
    </div>
</div>

<!-- Move Feed Modal -->
<div class="modal fade" id="moveFeedModal" tabindex="-1" aria-labelledby="moveFeedModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="moveFeedModalLabel">Move feed to another station</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-body">
        <input type="hidden" id="moveFeedUrl" />
        <p class="text-muted small mb-2">Where should <strong id="moveFeedTitle"></strong> live?</p>
        <div id="moveFeedStationList">
          @foreach (var s in (ViewBag.OtherStations as List<Ohrbob.Server.Shared.Requests.StationWithFeedsDto> ?? new()))
          {
            <div class="form-check">
              <input class="form-check-input" type="radio" name="moveTarget" id="moveTarget-@s.Station.Id" value="@s.Station.Id">
              <label class="form-check-label" for="moveTarget-@s.Station.Id">@s.Station.Name</label>
            </div>
          }
          <div class="form-check mt-2">
            <input class="form-check-input" type="radio" name="moveTarget" id="moveTargetNew" value="__new__" onclick="document.getElementById('moveNewStationNameContainer').style.display='block'">
            <label class="form-check-label" for="moveTargetNew">Create a new station for this feed</label>
          </div>
          <div id="moveNewStationNameContainer" style="display:none">
            <input type="text" class="form-control mt-2" id="moveNewStationName" placeholder="New station name">
          </div>
