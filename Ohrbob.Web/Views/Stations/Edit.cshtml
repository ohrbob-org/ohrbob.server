@model Ohrbob.Server.Shared.Requests.StationWithFeedsDto

@{
    ViewData["Title"] = "Edit Station";
}

<h1 class="d-flex align-items-center">
    <span>Edit Station - </span>
    <span id="stationNameDisplay" class="ms-1">@Model.Station.Name</span>
    <button type="button" class="btn btn-link text-decoration-none p-0 ms-2 lh-1" id="renameStationBtn" title="Rename Station" style="font-size: 1.5rem; color: #6c757d;">
        <i class="bi bi-pencil-square"></i>
    </button>
</h1>

<style>
.pill-nav {
    display: flex;
    background: #e9ecef;
    border-radius: 50px;
    padding: 5px;
    margin-bottom: 20px;
}
.pill-nav .nav-item {
    flex: 1;
    text-align: center;
}
.pill-nav .nav-link {
    border-radius: 50px;
    color: #495057;
    font-weight: 500;
}
.pill-nav .nav-link.active {
    background: #cce5ff;
    color: #004085;
}

@@media (min-width: 992px) {
    #stationTabs {
        display: none !important;
    }
    #stationTabsContent {
        display: flex !important;
        flex-wrap: wrap !important;
    }
    #stationTabsContent .tab-pane {
        display: block !important;
        opacity: 1 !important;
        flex: 0 0 50% !important;
        max-width: 50% !important;
    }
}
</style>

<ul class="nav pill-nav d-lg-none" id="stationTabs" role="tablist">
  <li class="nav-item">
    <a class="nav-link active" id="rotation-tab" data-bs-toggle="tab" href="#rotation" role="tab">Rotation & Feeds</a>
  </li>
  <li class="nav-item">
    <a class="nav-link" id="resolved-tab" data-bs-toggle="tab" href="#resolved" role="tab">Resolved Episodes</a>
  </li>
</ul>

<div class="tab-content row" id="stationTabsContent">
  <div class="tab-pane fade show active col-12 col-lg-6" id="rotation" role="tabpanel">
    <h3>Rotation & Feeds</h3>
    <div class="list-group py-3" id="rotationContainer" style="max-width: 100%;">
        @{ var feedScheduleIndex = 0; }
        @foreach(var feedSchedule in Model.Station.Schedule.Feeds)
        {
            var feedData = Model.Feeds.FirstOrDefault(f => f.Url == feedSchedule.Url);
            if (feedData != null)
            {
                var currentFeedIndex = feedScheduleIndex++;
                <div class="list-group-item rotation-item border rounded mb-2 d-flex align-items-stretch" draggable="true" data-url="@feedSchedule.Url" style="cursor: grab; border-left: 4px solid @(string.IsNullOrEmpty(feedSchedule.Color) ? "#ccc" : feedSchedule.Color) !important; background-color: @(string.IsNullOrEmpty(feedSchedule.Color) ? "#fff" : feedSchedule.Color + "26") !important; padding: 0; overflow: hidden; height: 90px; max-height: 90px;">
                    <img src="@feedData.ImageUrl" style="width: 90px; height: 90px; object-fit: cover; flex-shrink: 0;" />
                    <div class="d-flex flex-column justify-content-between flex-grow-1 py-2 px-3" style="min-height: 90px; max-height: 90px; overflow: hidden;">
                        <!-- Row 1: Feed Title (Top) -->
                        <div class="d-flex align-items-center">
                            <strong class="text-dark text-truncate" style="font-size: 1rem; max-width: 320px;" title="@feedData.Title">@feedData.Title</strong>
                        </div>

                        <!-- Row 2: Playback order, span input, trash icon (Middle) -->
                        <div class="d-flex align-items-center justify-content-between" style="line-height: 1;">
                            <div class="d-flex align-items-center" style="gap: 15px;">
                                <!-- 3-State Sliding Playback Order Toggle Control -->
                                @{
                                    var activeValue = (int)feedSchedule.SortOrder;
                                    var thumbLeft = activeValue == 1 ? "3px" : (activeValue == 2 ? "50%" : "calc(100% - 3px)");
                                    var thumbTransform = activeValue == 1 ? "translateX(0)" : (activeValue == 2 ? "translateX(-50%)" : "translateX(-100%)");
                                }
                                <div class="playback-order-toggle-container d-inline-flex flex-column align-items-center" style="width: 140px;">
                                     <div class="position-relative bg-light border rounded-pill d-flex align-items-center justify-content-between user-select-none"
                                          style="width: 100%; height: 26px; padding: 2px; background-color:#e8ebee !important; border: 1px solid #ced4da; cursor: pointer;"
                                          id="sliderTrack-@currentFeedIndex" role="slider" aria-valuemin="0" aria-valuemax="2" aria-valuenow="@activeValue">
                                          
                                          <div class="slider-thumb-container bg-primary rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                                               style="position: absolute; top: 2px; left: @thumbLeft; width: 20px; height: 20px; border: 1px solid rgba(255, 255, 255, 0.3); pointer-events: none; z-index: 20; transform: @thumbTransform; transition: left 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);">
                                               <i class="bi @(activeValue == 1 ? "bi-sort-down" : (activeValue == 2 ? "bi-shuffle" : "bi-sort-up")) text-white" style="font-size: 0.75rem;"></i>
                                          </div>

                                          <button type="button" onclick="window.setPlaybackOrder('@currentFeedIndex', 1)" class="playback-node-btn position-relative" style="z-index: 10; width: 33.333%; height: 100%; border: none; background: none; color: #6c757d;" title="Backwards: Newest to Oldest" data-bs-toggle="tooltip">
                                              <i class="bi bi-sort-down" style="position: absolute; left: 1px; top: 0; width: 20px; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem;"></i>
                                          </button>
                                          <button type="button" onclick="window.setPlaybackOrder('@currentFeedIndex', 2)" class="playback-node-btn position-relative" style="z-index: 10; width: 33.333%; height: 100%; border: none; background: none; color: #6c757d; display: flex; align-items: center; justify-content: center;" title="Random" data-bs-toggle="tooltip">
                                              <i class="bi bi-shuffle" style="font-size: 0.75rem;"></i>
                                          </button>
                                          <button type="button" onclick="window.setPlaybackOrder('@currentFeedIndex', 0)" class="playback-node-btn position-relative" style="z-index: 10; width: 33.333%; height: 100%; border: none; background: none; color: #6c757d;" title="Forwards: Oldest to Newest" data-bs-toggle="tooltip">
                                              <i class="bi bi-sort-up" style="position: absolute; right: 1px; top: 0; width: 20px; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 0.75rem;"></i>
                                          </button>
                                     </div>

                                     <!-- Hidden value input -->
                                     <input type="hidden" class="playback-order-value" value="@activeValue" />
                                 </div>

                                 <!-- Span input group -->
                                 <div class="d-flex align-items-center" style="width: 80px; flex-shrink: 0;">
                                     <span class="small text-muted me-1" style="font-size: 11px; white-space: nowrap;">
                                         Span
                                         <i class="bi bi-question-circle ms-1" data-bs-toggle="tooltip" data-bs-placement="top" title="How many unplayed episodes this feed contributes on its turn before rotating to the next." style="cursor: help; font-size: 0.85rem;"></i>:
                                     </span>
                                     <input type="number" class="form-control form-control-sm episodes-input" min="1" max="99" value="@(feedSchedule.EpisodesToPlay < 1 ? 1 : feedSchedule.EpisodesToPlay)" style="width: 40px; height: 24px; padding: 2px;" />
                                 </div>
                             </div>

                             <!-- Trash button (all the way to the right) -->
                             <button type="button" class="btn btn-link text-danger remove-feed p-0" title="Remove Feed" style="font-size: 1.25rem; line-height: 1;">
                                 <i class="bi bi-trash3-fill"></i>
                             </button>
                         </div>

                         <!-- Row 3: Feed Details (Bottom) -->
                         <div class="text-muted" style="font-size: 10px; line-height: 1; margin-top: 1px;">
                             Episodes: @feedData.EpisodeCount | Last Updated: @feedData.LastUpdated
                         </div>
                    </div>
                </div>
            }
        }
    </div>
    <div class="mt-4 d-flex align-items-center justify-content-center" style="gap: 12px;">
        <a href="/Discover" class="btn btn-primary d-inline-flex align-items-center">
            <i class="bi bi-compass me-2"></i>Discover
        </a>
        <button type="button" class="btn btn-outline-secondary d-inline-flex align-items-center" id="manualAddBtn">
            <i class="bi bi-plus-circle me-2"></i>Manual Add
        </button>
    </div>
  </div>
  <div class="tab-pane fade col-12 col-lg-6" id="resolved" role="tabpanel">
    @if (ViewBag.Playlist != null)
    {
        var playlist = (List<Ohrbob.Server.Shared.Requests.EpisodePlayStateDto>)ViewBag.Playlist;
        <div class="mt-3">
            <h4>Upcoming Playlist (Active Profile)</h4>
            <ul class="list-group" id="resolvedList">
                @foreach (var item in playlist)
                {
                    var activeClass = item.IsActive ? "list-group-item-primary" : "";
                    var feedColor = Model.Station.Schedule.Feeds.FirstOrDefault(f => f.Url == item.Episode.FeedUrl)?.Color ?? "#ccc";
                    <li class="list-group-item @activeClass d-flex justify-content-between align-items-center resolved-item" data-episode-id="@item.Episode.Id" style="border-left: 4px solid @(feedColor) !important; background-color: @(feedColor + "26") !important;">
                        <div>
                            <strong>@item.Episode.Title</strong><br/>
                            <small>
                                @if(item.IsActive) {
                                    <span class="badge bg-primary">Playing</span>
                                }
                                Position: @(item.PositionSeconds)s / Published: @(item.Episode.PublishedAt?.ToString("g"))
                            </small>
                        </div>
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-success mark-completed-btn" title="Mark Completed">
                                <i class="bi bi-check-lg"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-warning mark-completed-until-btn" title="Mark All Until Here Completed">
                                <span class="d-inline-flex position-relative align-items-center" style="width: 28px; height: 18px; vertical-align: middle;">
                                    <i class="bi bi-check" style="position: absolute; left: 0px; top: -4px; opacity: 0.6; font-size: 1.1rem;"></i>
                                    <i class="bi bi-check" style="position: absolute; left: 5px; top: -1px; opacity: 0.8; font-size: 1.1rem;"></i>
                                    <i class="bi bi-check-lg" style="position: absolute; left: 10px; top: 2px; font-size: 1.1rem;"></i>
                                </span>
                            </button>
                        </div>
                    </li>
                }

                @if (!playlist.Any())
                {
                    <li class="list-group-item text-muted">No unplayed episodes found.</li>
                }
            </ul>
        </div>
    }
  </div>
</div>

<!-- Rename Station Modal -->
<div class="modal fade" id="renameStationModal" tabindex="-1" aria-labelledby="renameStationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="renameStationModalLabel">Rename Station</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-dark">
                <div class="mb-3">
                    <label for="newStationNameInput" class="form-label">New Station Name</label>
                    <input type="text" class="form-control" id="newStationNameInput" placeholder="Enter station name" required />
                    <div class="invalid-feedback d-none" id="renameErrorMsg">
                        Station name cannot be empty.
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="saveStationNameBtn">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Confirm Remove Feed Modal -->
<div class="modal fade" id="confirmRemoveFeedModal" tabindex="-1" aria-labelledby="confirmRemoveFeedModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmRemoveFeedModalLabel">Confirm Removal</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-dark">
                Are you sure you want to remove this feed?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmRemoveFeedBtn">Remove</button>
            </div>
        </div>
    </div>
</div>

<!-- Manual Add Feed Modal -->
<div class="modal fade" id="manualAddFeedModal" tabindex="-1" aria-labelledby="manualAddFeedModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="manualAddFeedModalLabel">Manual Add Feed</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-dark">
                <div class="mb-3">
                    <label for="newFeedUrl" class="form-label">Feed RSS URL</label>
                    <input type="url" class="form-control" id="newFeedUrl" placeholder="https://..." required />
                    <div class="invalid-feedback d-none" id="manualAddErrorMsg">
                        Please enter a valid RSS feed URL.
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="submitManualAddBtn">Add Feed</button>
            </div>
        </div>
    </div>
</div>

<!-- Confirm Mark All Until Here Completed Modal -->
<div class="modal fade" id="confirmMarkCompletedUntilModal" tabindex="-1" aria-labelledby="confirmMarkCompletedUntilModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmMarkCompletedUntilModalLabel">Confirm Completing Episodes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-dark">
                <p>Are you sure you want to mark the following episodes as completed?</p>
                <div style="max-height: 250px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 4px;">
                    <ul class="list-group list-group-flush" id="episodesToMarkList">
                        <!-- Populated dynamically via JS -->
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="confirmMarkCompletedUntilBtn">Mark Completed</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

<script>
        (function () {
            console.log("IIFE EXECUTED");
            const getVerificationToken = () => document.querySelector('input[name="__RequestVerificationToken"]').value;

            let activeTooltips = [];
            function initTooltips() {
                activeTooltips.forEach(t => { if (typeof t.dispose === 'function') t.dispose(); });
                activeTooltips = [];

                const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                activeTooltips = tooltipTriggerList.map(function (tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl);
                });
            }

            function updateSchedule(shouldReload = false) {
                console.log("UPDATE SCHEDULE CALLED");
                const rotationItems = document.querySelectorAll('#rotationContainer .rotation-item');
                const feeds = Array.from(rotationItems).map(item => {
                    const url = item.getAttribute('data-url');
                    const sortOrderStr = item.querySelector('.playback-order-value').value;
                    const epsInput = item.querySelector('.episodes-input');
                    let epsToPlay = 1;
                    if (epsInput) {
                        epsToPlay = parseInt(epsInput.value, 10);
                        if (isNaN(epsToPlay)) epsToPlay = 1;
                        if (epsToPlay < 1) epsToPlay = 1;
                        if (epsToPlay > 99) epsToPlay = 99;
                    }

                    return {
                        Url: url,
                        SortOrder: parseInt(sortOrderStr, 10),
                        EpisodesToPlay: epsToPlay
                    };
                });

                const schedule = {
                    Feeds: feeds
                };

                fetch(`/Stations/UpdateSchedule/${"@Model.Station.Id"}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getVerificationToken()
                    },
                    body: JSON.stringify(schedule)
                })
                .then(response => {
                    if (response.ok) {
                        return fetch(window.location.href, { cache: 'no-store', headers: { 'Pragma': 'no-cache' } });
                    } else {
                        throw new Error('Server returned ' + response.status);
                    }
                })
                .then(res => res.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');

                    const newRotation = doc.getElementById('rotationContainer');
                    if (newRotation) {
                        document.getElementById('rotationContainer').innerHTML = newRotation.innerHTML;
                        bindRotationListeners();
                    }

                    const newResolved = doc.getElementById('resolved');
                    if (newResolved) document.getElementById('resolved').innerHTML = newResolved.innerHTML;
                })
                .catch(err => {
                    console.error('Error:', err);
                    document.body.dispatchEvent(new CustomEvent('showToast', {
                        detail: { message: 'Error updating schedule.', type: 'danger' }
                    }));
                });
            }

            let itemToRemove = null;

            document.getElementById('rotationContainer').addEventListener('click', function (e) {
                const removeBtn = e.target.closest('.remove-feed');
                if (removeBtn) {
                    itemToRemove = removeBtn.closest('.rotation-item');
                    const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('confirmRemoveFeedModal'));
                    modal.show();
                }
            });

            document.getElementById('confirmRemoveFeedBtn').addEventListener('click', function () {
                if (itemToRemove) {
                    itemToRemove.remove();
                    itemToRemove = null;
                    updateSchedule();
                }
                const modal = bootstrap.Modal.getInstance(document.getElementById('confirmRemoveFeedModal'));
                if (modal) {
                    modal.hide();
                }
            });

            document.getElementById('manualAddBtn').addEventListener('click', function () {
                const input = document.getElementById('newFeedUrl');
                if (input) {
                    input.value = '';
                    input.classList.remove('is-invalid');
                }
                const errorMsg = document.getElementById('manualAddErrorMsg');
                if (errorMsg) {
                    errorMsg.classList.add('d-none');
                }
                const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('manualAddFeedModal'));
                modal.show();
            });

            document.getElementById('submitManualAddBtn').addEventListener('click', function () {
                const input = document.getElementById('newFeedUrl');
                const errorMsg = document.getElementById('manualAddErrorMsg');
                const url = input ? input.value.trim() : '';
                
                if (!url) {
                    if (input) input.classList.add('is-invalid');
                    if (errorMsg) errorMsg.classList.remove('d-none');
                    return;
                }
                if (input) input.classList.remove('is-invalid');
                if (errorMsg) errorMsg.classList.add('d-none');

                const container = document.getElementById('rotationContainer');
                const newItem = document.createElement('div');
                newItem.className = 'list-group-item rotation-item border rounded p-3 mb-2';
                newItem.setAttribute('data-url', url);
                newItem.innerHTML = `
                    <input type="hidden" class="playback-order-value" value="0" />
                    <input type="number" class="episodes-input" value="1" style="display:none;" />
                `;
                container.appendChild(newItem);
                
                const modal = bootstrap.Modal.getInstance(document.getElementById('manualAddFeedModal'));
                if (modal) {
                    modal.hide();
                }
                updateSchedule();
            });

            function handleEpisodesChange(e) {
                if (e.target.classList.contains('episodes-input')) {
                    let val = parseInt(e.target.value, 10);
                    if (isNaN(val)) val = 1;
                    if (val < 1) val = 1;
                    if (val > 99) val = 99;
                    e.target.value = val;
                    updateSchedule();
                }
            }

            function bindRotationListeners() {
                const container = document.getElementById('rotationContainer');
                if (container) {
                    container.removeEventListener('change', handleEpisodesChange);
                    container.addEventListener('change', handleEpisodesChange);
                }
                initTooltips();
            }

            // Rotation Drag & Drop Logic
            const rotationContainer = document.getElementById('rotationContainer');
            if (rotationContainer) {
                let draggedItem = null;

                rotationContainer.addEventListener('dragstart', function (e) {
                    const item = e.target.closest('.rotation-item');
                    if (item) {
                        draggedItem = item;
                        e.dataTransfer.effectAllowed = 'move';
                        setTimeout(() => item.style.opacity = '0.5', 0);
                    }
                });

                rotationContainer.addEventListener('dragend', function (e) {
                    const item = e.target.closest('.rotation-item');
                    if (item) {
                        item.style.opacity = '1';
                        draggedItem = null;
                        
                        updateSchedule();
                    }
                });

                rotationContainer.addEventListener('dragover', function (e) {
                    e.preventDefault();
                    e.dataTransfer.dropEffect = 'move';
                    const targetItem = e.target.closest('.rotation-item');
                    
                    if (targetItem && targetItem !== draggedItem && draggedItem) {
                        const bounding = targetItem.getBoundingClientRect();
                        const offset = bounding.y + (bounding.height / 2);
                        
                        if (e.clientY - offset > 0) {
                            targetItem.after(draggedItem);
                        } else {
                            targetItem.before(draggedItem);
                        }
                    }
                });
            }
            
            // Resolved List Buttons
            const resolvedTabPane = document.getElementById('resolved');
            if (resolvedTabPane) {
                resolvedTabPane.addEventListener('click', function(e) {
                    const btnCompleted = e.target.closest('.mark-completed-btn');
                    const btnUntil = e.target.closest('.mark-completed-until-btn');
                    
                    if (btnCompleted || btnUntil) {
                        const li = e.target.closest('.resolved-item');
                        console.log("MARK COMPLETED CLICKED", li);
                        if (!li) return;
                        const episodeId = li.getAttribute('data-episode-id');
                        
                        if (btnCompleted) {
                            if (confirm('Mark this episode as completed?')) {
                                fetch(`/Stations/MarkCompleted?id=${"@Model.Station.Id"}&episodeId=${episodeId}`, {
                                    method: 'POST',
                                    headers: {
                                        'RequestVerificationToken': getVerificationToken()
                                    }
                                })
                                .then(res => {
                                    if (res.ok || res.redirected) {
                                        console.log("MARK COMPLETED SUCCESS", li);
                                        li.remove();
                                    } else {
                                        alert('Error marking completed');
                                    }
                                })
                                .catch(err => alert('Error marking completed'));
                            }
                        } else if (btnUntil) {
                            // Find all preceding items and the clicked item
                            const itemsToMark = [];
                            let currentItem = li;
                            while (currentItem) {
                                itemsToMark.unshift(currentItem);
                                currentItem = currentItem.previousElementSibling;
                            }
                            
                            // Populate list inside modal
                            const listContainer = document.getElementById('episodesToMarkList');
                            listContainer.innerHTML = '';
                            itemsToMark.forEach(item => {
                                const titleEl = item.querySelector('strong');
                                const title = titleEl ? titleEl.textContent : 'Episode';
                                const liEl = document.createElement('li');
                                liEl.className = 'list-group-item py-1 text-truncate';
                                liEl.textContent = title;
                                listContainer.appendChild(liEl);
                            });
                            
                            // Save references on the modal confirm button
                            const confirmBtn = document.getElementById('confirmMarkCompletedUntilBtn');
                            confirmBtn.onclick = function() {
                                // Hide the modal first
                                const modalEl = document.getElementById('confirmMarkCompletedUntilModal');
                                const modalInstance = bootstrap.Modal.getInstance(modalEl);
                                if (modalInstance) {
                                    modalInstance.hide();
                                }
                                
                                fetch(`/Stations/MarkCompletedUntil?id=${"@Model.Station.Id"}&episodeId=${episodeId}`, {
                                    method: 'POST',
                                    headers: {
                                        'RequestVerificationToken': getVerificationToken()
                                    }
                                })
                                .then(res => {
                                    if (res.ok || res.redirected) {
                                        let current = li;
                                        while(current) {
                                            const prev = current.previousElementSibling;
                                            current.remove();
                                            current = prev;
                                        }
                                    } else {
                                        alert('Error marking completed');
                                    }
                                })
                                .catch(err => alert('Error marking completed'));
                            };
                            
                            // Show the modal
                            const confirmModal = new bootstrap.Modal(document.getElementById('confirmMarkCompletedUntilModal'));
                            confirmModal.show();
                        }
                    }
                });
            }
            window.setPlaybackOrder = function (hashId, value) {
                const track = document.getElementById(`sliderTrack-${hashId}`);
                if (!track) return;

                const container = track.closest('.playback-order-toggle-container');
                const thumb = container.querySelector('.slider-thumb-container');
                const input = container.querySelector('.playback-order-value');
                const icon = thumb.querySelector('i');

                // Update value
                input.value = value;
                track.setAttribute('aria-valuenow', value);

                // Update thumb position and transform dynamically
                const left = value === 1 ? '3px' : (value === 2 ? '50%' : 'calc(100% - 3px)');
                const transform = value === 1 ? 'translateX(0)' : (value === 2 ? 'translateX(-50%)' : 'translateX(-100%)');
                thumb.style.left = left;
                thumb.style.transform = transform;

                // Update icon
                icon.className = `bi ${value === 1 ? 'bi-sort-down' : (value === 2 ? 'bi-shuffle' : 'bi-sort-up')} text-white`;

                // Trigger saving the schedule change asynchronously
                updateSchedule();
            };

            bindRotationListeners();
            initTooltips();

            // Initialize rename station functionality
            window.initRenameStation("@Model.Station.Id");
        })();
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
