@Html.AntiForgeryToken()

<script>
        (function () {
            console.log("IIFE EXECUTED");
            const getVerificationToken = () => document.querySelector('input[name="__RequestVerificationToken"]').value;

            function reloadPlaylist() {
                return fetch(window.location.href, { cache: 'no-store', headers: { 'Pragma': 'no-cache' } })
                .then(res => res.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    const newResolved = doc.getElementById('resolved');
                    if (newResolved) {
                        document.getElementById('resolved').innerHTML = newResolved.innerHTML;
                    }
                    initTooltips();
                    document.body.dispatchEvent(new CustomEvent('playerSync'));
                    scrollToActiveEpisode();
                })
                .catch(err => {
                    console.error('Error reloading playlist:', err);
                });
            }

            function scrollToActiveEpisode() {
                const container = document.getElementById('resolvedList');
                if (!container) return;
                const activeItem = container.querySelector('.resolved-item.is-playing');
                if (activeItem) {
                    if (window.innerWidth < 992) {
                        // On mobile: scroll the whole window so activeItem is near top (below layout header and sticky tabs card)
                        const itemRect = activeItem.getBoundingClientRect();
                        const scrollTarget = window.scrollY + itemRect.top - 220;
                        window.scrollTo({
                            top: scrollTarget,
                            behavior: 'smooth'
                        });
                    } else {
                        // On desktop: scroll the individually scrollable container
                        const relativeTop = activeItem.getBoundingClientRect().top - container.getBoundingClientRect().top + container.scrollTop;
                        container.scrollTo({
                            top: relativeTop - 10,
                            behavior: 'smooth'
                        });
                    }
                }
            }

            let activeTooltips = [];
            function initTooltips() {
                activeTooltips.forEach(t => { if (typeof t.dispose === 'function') t.dispose(); });
                activeTooltips = [];

                const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                activeTooltips = tooltipTriggerList.map(function (tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl);
                });
            }

            window.refreshStationEdit = function () {
                return fetch(window.location.href, { cache: 'no-store', headers: { 'Pragma': 'no-cache' } })
                    .then(res => res.text())
                    .then(html => {
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');

                        const newRotation = doc.getElementById('rotationContainer');
                        if (newRotation) {
                            document.getElementById('rotationContainer').innerHTML = newRotation.innerHTML;
                            bindRotationListeners();
                            if (typeof window.initFeedMenus === 'function') {
                                window.initFeedMenus();
                            }
                        }

                        const newResolved = doc.getElementById('resolved');
                        if (newResolved) {
                            document.getElementById('resolved').innerHTML = newResolved.innerHTML;
                            scrollToActiveEpisode();
                        }

                        // Keep the move modal's destination list in sync (it is rendered
                        // once from ViewBag.OtherStations and would otherwise go stale).
                        const newMoveList = doc.getElementById('moveFeedStationList');
                        if (newMoveList && document.getElementById('moveFeedStationList')) {
                            document.getElementById('moveFeedStationList').innerHTML = newMoveList.innerHTML;
                        }

                        // The schedule (feed set / per-feed playback order / spans) just changed
                        // server-side. Tell the audio widget to re-read /stream/status so its
                        // "up next"/"previous" reflect the new order without interrupting playback.
                        document.body.dispatchEvent(new CustomEvent('playerSync'));
                    });
            };

            function updateSchedule(shouldReload = false) {
                console.log("UPDATE SCHEDULE CALLED");
                const rotationItems = document.querySelectorAll('#rotationContainer .rotation-item');
                const feeds = Array.from(rotationItems).map(item => {
                    const url = item.getAttribute('data-url');
                    const sortOrderStr = item.querySelector('.playback-order-value').value;
                    const epsInput = item.querySelector('.episodes-input');
                    let epsToPlay = 1;
                    if (epsInput) {
                        epsToPlay = parseInt(epsInput.value, 10);
                        if (isNaN(epsToPlay)) epsToPlay = 1;
                        if (epsToPlay < 1) epsToPlay = 1;
                        if (epsToPlay > 99) epsToPlay = 99;
                    }

                    return {
                        Url: url,
                        SortOrder: parseInt(sortOrderStr, 10),
                        EpisodesToPlay: epsToPlay
                    };
                });

                const schedule = {
                    Feeds: feeds
                };

                fetch(`/Stations/UpdateSchedule/${"@Model.Station.Id"}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getVerificationToken()
                    },
                    body: JSON.stringify(schedule)
                })
                .then(response => {
                    if (response.ok) {
                        return window.refreshStationEdit();
                    } else {
                        throw new Error('Server returned ' + response.status);
                    }
                })
                .catch(err => {
                    console.error('Error:', err);
                    document.body.dispatchEvent(new CustomEvent('showToast', {
                        detail: { message: 'Error updating schedule.', type: 'danger' }
                    }));
                });
            }

            let itemToRemove = null;

            document.getElementById('rotationContainer').addEventListener('click', function (e) {
                const removeBtn = e.target.closest('.remove-feed');
                if (removeBtn) {
                    itemToRemove = removeBtn.closest('.rotation-item');
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('confirmRemoveFeedModal')).show();
                }
            });

            document.getElementById('confirmRemoveFeedBtn').addEventListener('click', function () {
                if (itemToRemove) {
                    itemToRemove.remove();
                    itemToRemove = null;
                    updateSchedule();
                }
                const modal = bootstrap.Modal.getInstance(document.getElementById('confirmRemoveFeedModal'));
                if (modal) {
                    modal.hide();
                }
            });

            document.getElementById('manualAddBtn').addEventListener('click', function () {
                const input = document.getElementById('newFeedUrl');
                if (input) {
                    input.value = '';
                    input.classList.remove('is-invalid');
                }
                const errorMsg = document.getElementById('manualAddErrorMsg');
                if (errorMsg) {
                    errorMsg.classList.add('d-none');
                }
                const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('manualAddFeedModal'));
                modal.show();
            });

            document.getElementById('submitManualAddBtn').addEventListener('click', function () {
                const input = document.getElementById('newFeedUrl');
                const errorMsg = document.getElementById('manualAddErrorMsg');
                const url = input ? input.value.trim() : '';
                
                if (!url) {
                    if (input) input.classList.add('is-invalid');
                    if (errorMsg) errorMsg.classList.remove('d-none');
                    return;
                }
                if (input) input.classList.remove('is-invalid');
                if (errorMsg) errorMsg.classList.add('d-none');

                const container = document.getElementById('rotationContainer');
                const newItem = document.createElement('div');
                newItem.className = 'list-group-item rotation-item border rounded p-3 mb-2';
                newItem.setAttribute('data-url', url);
                newItem.innerHTML = `
                    <input type="hidden" class="playback-order-value" value="0" />
                    <input type="number" class="episodes-input" value="1" style="display:none;" />
                `;
                container.appendChild(newItem);
                
                const modal = bootstrap.Modal.getInstance(document.getElementById('manualAddFeedModal'));
                if (modal) {
                    modal.hide();
                }
                updateSchedule();
            });

            function handleEpisodesChange(e) {
                if (e.target.classList.contains('episodes-input')) {
                    let val = parseInt(e.target.value, 10);
                    if (isNaN(val)) val = 1;
                    if (val < 1) val = 1;
                    if (val > 99) val = 99;
                    e.target.value = val;
                    updateSchedule();
                }
            }

            function bindRotationListeners() {
                const container = document.getElementById('rotationContainer');
                if (container) {
                    container.removeEventListener('change', handleEpisodesChange);
                    container.addEventListener('change', handleEpisodesChange);
                }
                initTooltips();
            }

            // Rotation Drag & Drop Logic
            const rotationContainer = document.getElementById('rotationContainer');
            if (rotationContainer) {
                let draggedItem = null;

                rotationContainer.addEventListener('dragstart', function (e) {
                    const item = e.target.closest('.rotation-item');
                    if (item) {
                        draggedItem = item;
                        e.dataTransfer.effectAllowed = 'move';
                        setTimeout(() => item.style.opacity = '0.5', 0);
                    }
                });

                rotationContainer.addEventListener('dragend', function (e) {
                    const item = e.target.closest('.rotation-item');
                    if (item) {
                        item.style.opacity = '1';
                        draggedItem = null;
                        
                        updateSchedule();
                    }
                });

                rotationContainer.addEventListener('dragover', function (e) {
                    e.preventDefault();
                    e.dataTransfer.dropEffect = 'move';
                    const targetItem = e.target.closest('.rotation-item');
                    
                    if (targetItem && targetItem !== draggedItem && draggedItem) {
                        const bounding = targetItem.getBoundingClientRect();
                        const offset = bounding.y + (bounding.height / 2);
                        
                        if (e.clientY - offset > 0) {
                            targetItem.after(draggedItem);
                        } else {
                            targetItem.before(draggedItem);
                        }
                    }
                });
            }
            
            function setEpisodeCompletedState(li, isCompleted) {
                if (!li) return;

                li.classList.toggle('is-played', isCompleted);

                // Show/hide overlay
                const overlay = li.querySelector('.completed-overlay');
                if (overlay) {
                    if (isCompleted) {
                        overlay.classList.remove('d-none');
                    } else {
                        overlay.classList.add('d-none');
                    }
                }
                
                // Swap buttons
                const btnContainer = li.querySelector('.button-container');
                if (btnContainer) {
                    if (isCompleted) {
                        btnContainer.innerHTML = `
                            <button type="button" class="btn btn-sm btn-outline-danger w-100 py-1 clear-completed-btn" title="Clear completed state" style="font-size: 0.75rem; padding: 2px 4px;">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary w-100 py-1 clear-completed-until-btn" title="Clear everything until here" style="font-size: 0.75rem; padding: 2px 4px;">
                                <span class="d-inline-flex position-relative align-items-center" style="width: 18px; height: 12px; vertical-align: middle;">
                                    <i class="bi bi-arrow-counterclockwise" style="position: absolute; left: 0px; top: -2px; opacity: 0.6; font-size: 0.7rem;"></i>
                                    <i class="bi bi-arrow-counterclockwise" style="position: absolute; left: 4px; top: 0px; opacity: 0.8; font-size: 0.7rem;"></i>
                                    <i class="bi bi-arrow-counterclockwise" style="position: absolute; left: 8px; top: 2px; font-size: 0.7rem;"></i>
                                </span>
                            </button>
                        `;
                    } else {
                        btnContainer.innerHTML = `
                            <button type="button" class="btn btn-sm btn-outline-success w-100 py-1 mark-completed-btn" title="Mark Completed" style="font-size: 0.75rem; padding: 2px 4px;">
                                <i class="bi bi-check-lg"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-warning w-100 py-1 mark-completed-until-btn" title="Mark All Until Here Completed" style="font-size: 0.75rem; padding: 2px 4px;">
                                <span class="d-inline-flex position-relative align-items-center" style="width: 18px; height: 12px; vertical-align: middle;">
                                    <i class="bi bi-check" style="position: absolute; left: 0px; top: -3px; opacity: 0.6; font-size: 0.7rem;"></i>
                                    <i class="bi bi-check" style="position: absolute; left: 4px; top: -1px; opacity: 0.8; font-size: 0.7rem;"></i>
                                    <i class="bi bi-check-lg" style="position: absolute; left: 8px; top: 1px; font-size: 0.7rem;"></i>
                                </span>
                            </button>
                        `;
                    }
                }
            }

            // Resolved List Buttons
            const resolvedTabPane = document.getElementById('resolved');
            if (resolvedTabPane) {
                resolvedTabPane.addEventListener('click', function(e) {
                    const btnCompleted = e.target.closest('.mark-completed-btn');
                    const btnUntil = e.target.closest('.mark-completed-until-btn');
                    const btnClear = e.target.closest('.clear-completed-btn');
                    const btnClearUntil = e.target.closest('.clear-completed-until-btn');
                    
                    if (!btnCompleted && !btnUntil && !btnClear && !btnClearUntil) return;
                    
                    const li = e.target.closest('.resolved-item');
                    if (!li) return;
                    const episodeId = li.getAttribute('data-episode-id');
                    
                    if (btnCompleted) {
                        fetch(`/Stations/MarkCompleted?id=${"@Model.Station.Id"}&episodeId=${episodeId}`, {
                            method: 'POST',
                            headers: {
                                'RequestVerificationToken': getVerificationToken()
                            }
                        })
                        .then(res => {
                            if (res.ok || res.redirected) {
                                reloadPlaylist();
                            } else {
                                alert('Error marking completed');
                            }
                        })
                        .catch(err => alert('Error marking completed'));
                        
                    } else if (btnUntil) {
                        // Find all preceding items and the clicked item
                        const itemsToMark = [];
                        let currentItem = li;
                        while (currentItem) {
                            if (currentItem.classList.contains('resolved-item')) {
                                itemsToMark.unshift(currentItem);
                            }
                            currentItem = currentItem.previousElementSibling;
                        }
                        
                        // Populate list inside modal
                        const listContainer = document.getElementById('episodesToMarkList');
                        listContainer.innerHTML = '';
                        itemsToMark.forEach(item => {
                            const titleEl = item.querySelector('strong');
                            const title = titleEl ? titleEl.textContent : 'Episode';
                            const liEl = document.createElement('li');
                            liEl.className = 'list-group-item py-1 text-truncate';
                            liEl.textContent = title;
                            listContainer.appendChild(liEl);
                        });
                        
                        const confirmBtn = document.getElementById('confirmMarkCompletedUntilBtn');
                        confirmBtn.onclick = function() {
                            const modalEl = document.getElementById('confirmMarkCompletedUntilModal');
                            const modalInstance = bootstrap.Modal.getInstance(modalEl);
                            if (modalInstance) modalInstance.hide();
                            
                            fetch(`/Stations/MarkCompletedUntil?id=${"@Model.Station.Id"}&episodeId=${episodeId}`, {
                                method: 'POST',
                                headers: {
                                    'RequestVerificationToken': getVerificationToken()
                                }
                            })
                            .then(res => {
                                if (res.ok || res.redirected) {
                                    reloadPlaylist();
                                } else {
                                    alert('Error marking completed until here');
                                }
                            })
                            .catch(err => alert('Error marking completed until here'));
                        };
                        
                        const confirmModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('confirmMarkCompletedUntilModal'));
                        confirmModal.show();
                        
                    } else if (btnClear) {
                        // Single clear completed (with confirmation modal)
                        const confirmBtn = document.getElementById('confirmClearCompletedBtn');
                        confirmBtn.onclick = function() {
                            const modalEl = document.getElementById('confirmClearCompletedModal');
                            const modalInstance = bootstrap.Modal.getInstance(modalEl);
                            if (modalInstance) modalInstance.hide();
                            
                            fetch(`/Stations/ClearCompleted?id=${"@Model.Station.Id"}&episodeId=${episodeId}`, {
                                method: 'POST',
                                headers: {
                                    'RequestVerificationToken': getVerificationToken()
                                }
                            })
                            .then(res => {
                                if (res.ok || res.redirected) {
                                    reloadPlaylist();
                                } else {
                                    alert('Error clearing completed state');
                                }
                            })
                            .catch(err => alert('Error clearing completed state'));
                        };
                        
                        const confirmModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('confirmClearCompletedModal'));
                        confirmModal.show();
                        
                    } else if (btnClearUntil) {
                        // Find all preceding items and the clicked item
                        const itemsToClear = [];
                        let currentItem = li;
                        while (currentItem) {
                            if (currentItem.classList.contains('resolved-item')) {
                                itemsToClear.unshift(currentItem);
                            }
                            currentItem = currentItem.previousElementSibling;
                        }
                        
                        // Populate list inside modal
                        const listContainer = document.getElementById('episodesToClearList');
                        listContainer.innerHTML = '';
                        itemsToClear.forEach(item => {
                            const titleEl = item.querySelector('strong');
                            const title = titleEl ? titleEl.textContent : 'Episode';
                            const liEl = document.createElement('li');
                            liEl.className = 'list-group-item py-1 text-truncate';
                            liEl.textContent = title;
                            listContainer.appendChild(liEl);
                        });
                        
                        const confirmBtn = document.getElementById('confirmClearCompletedUntilBtn');
                        confirmBtn.onclick = function() {
                            const modalEl = document.getElementById('confirmClearCompletedUntilModal');
                            const modalInstance = bootstrap.Modal.getInstance(modalEl);
                            if (modalInstance) modalInstance.hide();
                            
                            fetch(`/Stations/ClearCompletedUntil?id=${"@Model.Station.Id"}&episodeId=${episodeId}`, {
                                method: 'POST',
                                headers: {
                                    'RequestVerificationToken': getVerificationToken()
                                }
                            })
                            .then(res => {
                                if (res.ok || res.redirected) {
                                    reloadPlaylist();
                                } else {
                                    alert('Error clearing completed state until here');
                                }
                            })
                            .catch(err => alert('Error clearing completed state until here'));
                        };
                        
                        const confirmModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('confirmClearCompletedUntilModal'));
                        confirmModal.show();
                    }
                });
            }
            window.setPlaybackOrder = function (hashId, value) {
                const track = document.getElementById(`sliderTrack-${hashId}`);
                if (!track) return;

                const container = track.closest('.playback-order-toggle-container');
                const thumb = container.querySelector('.slider-thumb-container');
                const input = container.querySelector('.playback-order-value');
                const icon = thumb.querySelector('i');

                // Update value
                input.value = value;
                track.setAttribute('aria-valuenow', value);

                // Update thumb position and transform dynamically
                const left = value === 1 ? '3px' : (value === 2 ? '50%' : 'calc(100% - 3px)');
                const transform = value === 1 ? 'translateX(0)' : (value === 2 ? 'translateX(-50%)' : 'translateX(-100%)');
                thumb.style.left = left;
                thumb.style.transform = transform;

                // Update icon
                icon.className = `bi ${value === 1 ? 'bi-sort-down' : (value === 2 ? 'bi-shuffle' : 'bi-sort-up')} text-white`;

                // Trigger saving the schedule change asynchronously
                updateSchedule();
            };

            // Track the active episode ID to prevent redundant reloads
            let currentActiveEpisodeId = null;

            document.body.addEventListener('ohrbob:statechange', function(e) {
                const state = e.detail && e.detail.state;
                if (!state || state.isCompiling || state.isEmpty) return;
                
                const activeEpisode = state.current;
                const newEpisodeId = activeEpisode ? activeEpisode.episodeId : null;
                
                if (newEpisodeId !== currentActiveEpisodeId) {
                    currentActiveEpisodeId = newEpisodeId;
                    reloadPlaylist().then(() => {
                        scrollToActiveEpisode();
                    });
                }
            });

            function initPage() {
                bindRotationListeners();
                initTooltips();
                scrollToActiveEpisode();

                // Initialize dockable header IntersectionObserver for sticky docking
                const sentinel = document.getElementById('dock-sentinel');
                const dockable = document.getElementById('dockable-header');
                if (sentinel && dockable) {
                    let dockTimeout = null;
                    const observer = new IntersectionObserver((entries) => {
                        entries.forEach(entry => {
                            const shouldDock = !entry.isIntersecting;
                            
                            if (dockTimeout) {
                                clearTimeout(dockTimeout);
                                dockTimeout = null;
                            }
                            
                            if (shouldDock) {
                                // Delay docking to ensure it's not a transient scroll/layout shift
                                dockTimeout = setTimeout(() => {
                                    dockable.classList.add('docked');
                                }, 250); // 250ms delay
                            } else {
                                // Undocking can happen immediately for responsiveness
                                dockable.classList.remove('docked');
                            }
                        });
                    }, {
                        rootMargin: '-73px 0px 0px 0px'
                    });
                    observer.observe(sentinel);
                }

                // Listen for mobile tab switches to auto-scroll when upcoming playlist becomes visible
                document.querySelectorAll('#stationTabs a[data-bs-toggle="tab"]').forEach(tab => {
                    tab.addEventListener('shown.bs.tab', function (e) {
                        if (e.target.id === 'resolved-tab') {
                            setTimeout(scrollToActiveEpisode, 150);
                        }
                    });
                });

                // Initialize rename station functionality (revamped as Station Settings)
                window.initRenameStation("@Model.Station.Id", @(Model.Station.IsAging ? "true" : "false"), @(Model.Station.EndlessSpin ? "true" : "false"));
                window.initShareBar("@Model.Station.Id");

                // Initialize move-feed functionality
                window.initMoveFeed("@Model.Station.Id");

                // Initialize OPML import
                window.initOpmlImport("@Model.Station.Id");
            }

            if (typeof bootstrap !== 'undefined') {
                initPage();
            } else {
                document.addEventListener('DOMContentLoaded', initPage);
            }
        })();
</script>

