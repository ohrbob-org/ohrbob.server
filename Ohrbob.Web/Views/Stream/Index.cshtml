@model Ohrbob.Web.Models.StreamViewModel
@{
    ViewData["Title"] = "Stream";
}

<div class="stream-page">
    <div class="page-head">
        <div class="page-head__text">
            <p class="metro-kicker" aria-hidden="true">listen anywhere</p>
            <h1 class="metro-title metro-title--compact">stream</h1>
        </div>
    </div>

    @if (!Model.StreamEnabled)
    {
        <div class="metro-warning stream-warning">
            Streaming is a <strong>Morebob</strong> feature. Your current plan does not include stream URLs.
            <a asp-controller="Account" asp-action="Index">Upgrade your account</a> to start streaming.
        </div>
    }
    else
    {
        <p class="stream-lede">
            Use these URLs in an internet radio or streaming client. Treat them like passwords: anyone with a URL can listen.
        </p>
        <p class="stream-lede">
            Morebob accounts can stream to up to <strong>@(Model.MaxConcurrentListeners < 0 ? "unlimited" : Model.MaxConcurrentListeners.ToString()) listeners</strong> at the same time per stream.
        </p>

        @if (Model.Profiles.Count == 0)
        {
            <p class="stream-empty">No profiles yet.</p>
        }

        @foreach (var profile in Model.Profiles)
        {
            <section class="stream-group" aria-label="@profile.ProfileName streams">
                <h2 class="stream-group__title">@profile.ProfileName</h2>

                @if (profile.Stations.Count == 0)
                {
                    <p class="stream-empty">No stations assigned to this profile.</p>
                }
                else
                {
                    <div class="stream-list">
                        @foreach (var station in profile.Stations)
                        {
                            <div class="stream-row">
                                <span class="stream-name" title="@station.StationName">@station.StationName</span>
                                <code class="stream-url">@station.Url</code>
                                <button type="button" class="stream-copy"
                                        onclick="navigator.clipboard.writeText(this.previousElementSibling.textContent)"
                                        title="Copy stream URL" aria-label="Copy stream URL">
                                    <i class="bi bi-clipboard" aria-hidden="true"></i> Copy
                                </button>
                            </div>
                        }
                    </div>
                }
            </section>
        }
    }
</div>
