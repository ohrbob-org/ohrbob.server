@using Ohrbob.Server.Shared.Requests
@model List<Ohrbob.Web.Models.PodcastSearchResult>
@{
    var stations = ViewBag.Stations as List<StationWithFeedsDto> ?? new List<StationWithFeedsDto>();
}

@if (Model == null || !Model.Any())
{
    <div class="col-12 text-center text-muted">
        <p>No podcasts found.</p>
    </div>
}
else
{
    @foreach (var podcast in Model)
    {
        var safeId = Guid.NewGuid().ToString("N");
        <div class="col">
            <div class="card h-100 shadow-sm">
                @if (!string.IsNullOrEmpty(podcast.Image))
                {
                    <img src="@podcast.Image" class="card-img-top" alt="Cover" style="aspect-ratio: 1; object-fit: cover; border-bottom: 1px solid #ddd;">
                }
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-truncate" title="@podcast.Title">@podcast.Title</h5>
                    <p class="card-text text-muted small text-truncate" title="@podcast.Author">@podcast.Author</p>
                    <div class="mt-auto">
                        <button class="btn btn-outline-primary btn-sm w-100" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@safeId" aria-expanded="false" aria-controls="collapse-@safeId">
                            <i class="bi bi-plus-circle"></i> Add to Station
                        </button>
                    </div>
                </div>
                <div class="collapse" id="collapse-@safeId">
                    <div class="card-footer bg-light" id="action-area-@safeId">
                        <form hx-post="/Discover/AddFeed" hx-target="#action-area-@safeId" hx-swap="innerHTML">
                            <input type="hidden" name="feedUrl" value="@podcast.Url" />
                            <input type="hidden" name="feedTitle" value="@podcast.Title" />
                            <div class="mb-2">
                                <select class="form-select form-select-sm" name="stationId" required>
                                    <option value="new">-- Create New Station --</option>
                                    @foreach (var station in stations)
                                    {
                                        <option value="@station.Station.Id">@station.Station.Name</option>
                                    }
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm w-100">Confirm Add</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}