@model List<Ohrbob.Web.Models.PodcastSearchResult>

@if (Model == null || !Model.Any())
{
    <p class="discover-results__empty">No podcasts found.</p>
}
else
{
    <div class="discover-results__head">
        <h2 class="discover-results__title">results</h2>
    </div>
    @foreach (var podcast in Model)
    {
        @await Html.PartialAsync("_PodcastCard", podcast)
    }
}
