@model List<Ohrbob.Web.Models.RecommendationLane>
@{
    ViewData["Title"] = "Discover";
    var query = ViewBag.Query as string;
    var hasQuery = !string.IsNullOrWhiteSpace(query);
    var categoryRoster = ViewBag.CategoryRoster as IReadOnlyList<string> ?? Array.Empty<string>();
    var searchResults = ViewBag.SearchResults as List<Ohrbob.Web.Models.PodcastSearchResult>;
}

<div class="page-head discover-head">
    <div class="page-head__text">
        <p class="metro-kicker" aria-hidden="true">find something new</p>
        <h1 class="metro-title metro-title--compact">discover</h1>
    </div>
</div>

<div class="discover-search">
    <i class="bi bi-search discover-search__icon" aria-hidden="true"></i>
    <label class="visually-hidden" for="discover-search">Search podcasts</label>
    <input type="search"
           id="discover-search"
           class="discover-search__input"
           placeholder="Search podcasts by name, author..."
           name="query"
           value="@query"
           autocomplete="off"
           hx-get="/Discover/Search"
           hx-target="#search-results"
           hx-trigger="keyup changed delay:500ms, search" />
</div>

<div id="recommendation-lanes" class="discover-lanes @(hasQuery ? "d-none" : "")">
    @foreach (var lane in Model.Where(l => l.Podcasts.Any()))
    {
        <section class="discover-lane" aria-label="@lane.Category recommendations">
            <div class="discover-lane__head">
                <h2 class="discover-lane__title">@lane.Category</h2>
            </div>
            <div class="discover-lane-track">
                @foreach (var podcast in lane.Podcasts)
                {
                    @await Html.PartialAsync("_PodcastCard", podcast)
                }
            </div>
        </section>
    }
</div>

@if (categoryRoster.Count > 0)
{
    <section id="category-roster" class="discover-categories">
        <div class="discover-lane__head">
            <h2 class="discover-lane__title">browse categories</h2>
        </div>
        <div class="category-roster-track">
            @foreach (var category in categoryRoster)
            {
                var isActive = hasQuery && query == category;
                <a class="category-chip @(isActive ? "is-active" : "")"
                   href="@Url.Action("Index", "Discover", new { q = category })"
                   aria-current="@(isActive ? "true" : null)">@category</a>
            }
        </div>
    </section>
}

<section class="discover-results" aria-label="Search results">
    <div id="search-results" class="discover-results-grid">
        @if (searchResults is not null)
        {
            @await Html.PartialAsync("_SearchResults", searchResults)
        }
    </div>
</section>

@* Loaded with the view content so htmx re-executes it after a boosted navigation (which drops layout sections). *@
<script src="~/js/discover.js" asp-append-version="true"></script>
