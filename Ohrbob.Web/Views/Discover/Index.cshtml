@{
    ViewData["Title"] = "Discover";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12 col-md-8 mx-auto">
            <h2 class="text-center mb-3">Discover Podcasts</h2>
            <div class="input-group input-group-lg">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="search" 
                       class="form-control" 
                       placeholder="Search podcasts by name, author..." 
                       name="query"
                       hx-get="/Discover/Search"
                       hx-target="#search-results"
                       hx-trigger="keyup changed delay:500ms, search" />
            </div>
        </div>
    </div>
    
    <div id="search-results" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <!-- Results will load here via HTMX -->
    </div>
</div>