@using Ohrbob.Server.Shared.Requests
@using Ohrbob.Server.Shared.Text
@model Ohrbob.Web.Models.PodcastSearchResult
@{
    var stations = ViewBag.Stations as List<StationWithFeedsDto> ?? new List<StationWithFeedsDto>();
    var safeId = Guid.NewGuid().ToString("N");
    var hasStations = stations.Any();
    var description = HtmlText.ToDisplayText(Model.Description);
    if (string.IsNullOrWhiteSpace(description))
    {
        description = "No description available.";
    }
}
<div class="col">
    <div class="card-feed h-100 podcast-card">
        <div class="card-feed-art podcast-card-cover">
            <button type="button"
                    class="podcast-details-toggle"
                    aria-expanded="false"
                    aria-controls="podcast-details-@safeId"
                    aria-label="Show details for @Model.Title">
                <span class="podcast-cover-media">
                    @if (!string.IsNullOrEmpty(Model.Image))
                    {
                        <img src="@Model.Image" class="podcast-card-cover-img" alt="Cover">
                    }
                    else
                    {
                        <div class="card-feed-cover card-feed-cover-empty" role="img" aria-label="No cover art">@((Model.Title.Length > 0 ? Model.Title[0].ToString() : "?").ToUpper())</div>
                    }
                </span>
                <span class="podcast-details-overlay" id="podcast-details-@safeId">
                    <span class="podcast-details-text">@description</span>
                </span>
            </button>
            <span class="card-feed-badge" aria-hidden="true"><i class="bi bi-rss"></i></span>
            <button class="card-feed-add"
                    type="button"
                    data-bs-toggle="modal"
                    data-bs-target="#add-to-station-modal-@safeId"
                    aria-label="Add @Model.Title to a station"
                    title="Add this podcast to a station">
                <i class="bi bi-plus-lg" aria-hidden="true"></i>
            </button>
        </div>
        <div class="card-feed-body">
            <h3 class="card-feed-title" title="@Model.Title">@Model.Title</h3>
            @if (!string.IsNullOrWhiteSpace(Model.Author))
            {
                <p class="card-feed-author" title="@Model.Author">@Model.Author</p>
            }
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="add-to-station-modal-@safeId" tabindex="-1" aria-labelledby="add-to-station-modal-label-@safeId" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-body" id="add-to-station-modal-label-@safeId">Add to Station</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-body text-start">
                    <form id="add-feed-form-@safeId" hx-boost="false" onsubmit="window.submitAddFeedJson(event, '@safeId')">
                        <input type="hidden" name="feedUrl" value="@Model.Url" />
                        <input type="hidden" name="feedTitle" value="@Model.Title" />
                        
                        <!-- Existing Stations Section -->
                        @if (hasStations)
                        {
                            <div class="mb-2 fw-bold small text-muted text-start">Select Stations:</div>
                            <div class="station-list-container mb-3 text-start" style="max-height: 200px; overflow-y: auto;">
                                @foreach (var station in stations)
                                {
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" name="stationIds" value="@station.Station.Id" id="station-@station.Station.Id-@safeId" data-feeds="@string.Join(";", station.Station.Feeds ?? Array.Empty<string>())" onchange="window.validateFormSelection('@safeId')">
                                        <label class="form-check-label" for="station-@station.Station.Id-@safeId">
                                            @station.Station.Name
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                        
                        <!-- Create New Section -->
                        <div class="form-check mb-3 @(hasStations ? "border-bottom pb-2" : "")">
                            <input class="form-check-input" type="checkbox" name="createNewStation" value="true" id="create-new-@safeId" @(!hasStations ? "checked" : "") onchange="window.toggleNewStationInput('@safeId')">
                            <label class="form-check-label fw-bold" for="create-new-@safeId">
                                Create a new station from this feed
                            </label>
                        </div>
                        <div class="mb-3" id="new-station-name-container-@safeId" style="display: @(hasStations ? "none" : "block");">
                            <label class="form-label small text-muted">New Station Name</label>
                            <input type="text" class="form-control form-control-sm" name="newStationName" value="@Model.Title" placeholder="Station Name" />
                        </div>

                        
                        <div class="modal-footer px-0 pb-0">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary" id="confirm-btn-@safeId" @(hasStations ? "disabled" : "")>Confirm Add</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
