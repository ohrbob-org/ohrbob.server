@model string
@{
    ViewData["Title"] = "Opening the Ohrbob App";
}

<div class="card mx-auto mt-4 shadow-sm" style="max-width: 26rem;">
    <div class="card-body p-4 text-center">
        <h1 class="h4 mb-2">Opening the Ohrbob app…</h1>
        <p class="text-muted">Your API key was created. If nothing happens, open the link manually.</p>

        <a id="ohrbob-handoff-link" class="btn btn-primary w-100" href="@Model">Open in the Ohrbob app</a>
    </div>
</div>

@* Kept in the body rather than a layout @section: the form that produces this view lives under
   <body hx-boost="true">, so the submit is an htmx AJAX POST carrying HX-Request. _ViewStart sets
   Layout = null for those, which discards layout sections. An inline script is evaluated by htmx in
   the swapped fragment and also runs on a full-page render. *@
<script>
    window.location.href = @Json.Serialize(Model);
</script>
