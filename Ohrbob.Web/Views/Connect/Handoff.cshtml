@model string
@{
    ViewData["Title"] = "Opening the Ohrbob App";
    ViewData["BodyClass"] = "metro-night";
}

<div class="auth-page metro-night">
    <div class="auth-page__intro">
        <p class="auth-page__kicker">connect</p>
    </div>

    <div class="connect-card">
        <div class="connect-card__accent"></div>
        <div class="connect-card__body text-center">
            <h1 class="connect-card__title">opening the app…</h1>
            <p class="connect-card__hint">Your API key was created. If nothing happens, open the link manually.</p>

            <a id="ohrbob-handoff-link" class="btn btn-primary w-100" href="@Model">Open in the Ohrbob app</a>
        </div>
    </div>
</div>

@* Kept in the body rather than a layout @section: the form that produces this view lives under
   <body hx-boost="true">, so the submit is an htmx AJAX POST carrying HX-Request. _ViewStart sets
   Layout = null for those, which discards layout sections. An inline script is evaluated by htmx in
   the swapped fragment and also runs on a full-page render. *@
<script>
    const widget = document.getElementById('ohrbob-player');
    if (widget && widget.isPlaying) {
        widget.dispatchEvent(new CustomEvent('pause', { bubbles: true }));
    }
    window.location.href = @Json.Serialize(Model);
</script>
