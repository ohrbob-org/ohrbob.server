<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ohrbob @ViewData["Title"]</title>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
</head>
@{
    var bodyClass = ViewData["BodyClass"] as string;
    var isNight = bodyClass?.Contains("metro-night", StringComparison.Ordinal) == true;
}
<body class="metro-app minimal-shell @bodyClass" hx-boost="false">
    <div id="htmx-progress" aria-hidden="true"></div>

    @if (isNight)
    {
        <header class="minimal-brandline">
            <div class="minimal-brandline__inner">
                <a class="minimal-brandline__brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="~/images/ohrbob-logo-white.svg" alt="" />
                    <span class="minimal-brandline__name">ohrbob</span>
                </a>
                <span class="minimal-brandline__kicker">connect</span>
            </div>
        </header>
    }

    <div class="minimal-main" id="main-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="minimal-footer">
        <div class="minimal-footer__inner">
            &copy; 2026 - Ohrbob.Web
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/htmx/htmx.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
