@using Microsoft.Extensions.Options
@using Ohrbob.Web.Configuration
@inject IOptions<LegalOptions> LegalOptions
@inject IOptions<HtmxNavigationOptions> HtmxNavOptions
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    bool IsHtmxEnabled(string controller, string action)
    {
        var path = $"/{controller}";
        if (controller == "Home" && action == "Index") path = "/";
        return HtmxNavOptions.Value.EnabledEndpoints.Any(e => 
            e.Equals(path, StringComparison.OrdinalIgnoreCase) || 
            (path.StartsWith(e, StringComparison.OrdinalIgnoreCase) && e != "/"));
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    @if (!Env.IsDevelopment())
    {
        <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">
    }
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | ohrbob</title>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profiles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/collage.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ohrbob.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body hx-boost="true" hx-target="#main-content" class="@(User.Identity?.IsAuthenticated == true ? "with-player" : "")">
    <header>
        <div class="floating-nav-pill">
            <!-- Left: Logo -->
            <a asp-area="" asp-controller="Home" asp-action="Index" hx-boost="@(IsHtmxEnabled("Home", "Index") ? "true" : "false")" style="display: flex; align-items: center;">
                <div style="font-size: 2rem;    height: 1rem;    position: relative;    top: -.7rem;    left: -0.2rem;">
                    <div class="ohrbob-logo ohrbob-logo-left">
                        <span class="ohrbob-logo-icon">
                            <img src="~/images/ohrbob-logo.svg" alt="Icon">
                        </span>
                        <span class="ohrbob-logo-text">
                            <span class="char-1">o</span><span class="char-2">h</span><span class="char-3">r</span><span class="char-4">b</span><span class="char-5">o</span><span class="char-6">b</span>
                        </span>
                    </div>
                </div>
            </a>
            
            <!-- Center: Links (if auth'd) -->
            <div class="floating-nav-pill-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-area="" asp-controller="Discover" asp-action="Index" hx-boost="@(IsHtmxEnabled("Discover", "Index") ? "true" : "false")">Discover</a>
                    <a asp-area="" asp-controller="Home" asp-action="Index" hx-boost="@(IsHtmxEnabled("Home", "Index") ? "true" : "false")">Listen</a>
                }
            </div>

            <!-- Right: Profile or Login -->
            <div class="d-flex align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button class="btn btn-link text-decoration-none text-body p-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="More Information">
                            <i class="bi bi-three-dots-vertical fs-5"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="Features" hx-boost="@(IsHtmxEnabled("Home", "Features") ? "true" : "false")"><i class="bi bi-star me-2"></i> Features</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="About" hx-boost="@(IsHtmxEnabled("Home", "About") ? "true" : "false")"><i class="bi bi-book me-2"></i> Our Story</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="SelfHost" hx-boost="@(IsHtmxEnabled("Home", "SelfHost") ? "true" : "false")"><i class="bi bi-server me-2"></i> Self-Hosting</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="Faq" hx-boost="@(IsHtmxEnabled("Home", "Faq") ? "true" : "false")"><i class="bi bi-question-circle me-2"></i> FAQ</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="Status" hx-boost="@(IsHtmxEnabled("Home", "Status") ? "true" : "false")"><i class="bi bi-activity me-2"></i> Status</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="Privacy" hx-boost="@(IsHtmxEnabled("Home", "Privacy") ? "true" : "false")"><i class="bi bi-shield-lock me-2"></i> Privacy Policy</a></li>
                            @if (LegalOptions.Value.IsConfigured)
                            {
                                <li><a class="dropdown-item py-2" asp-controller="Home" asp-action="Legal" hx-boost="@(IsHtmxEnabled("Home", "Legal") ? "true" : "false")"><i class="bi bi-shield-check me-2"></i> Legal</a></li>
                            }
                            <li><a class="dropdown-item py-2" href="https://github.com/ohrbob-org/ohrbob.server" target="_blank" rel="noopener"><i class="bi bi-github me-2"></i> Source Code</a></li>
                        </ul>
                    </div>
                    @await Component.InvokeAsync("ProfileSelector")
                }
                else
                {
                    <a asp-controller="Home" asp-action="Login" class="btn btn-primary rounded-pill" hx-boost="false">Login</a>
                }
            </div>
        </div>
    </header>
    <div class="container" id="main-content" hx-history-elt>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (User.Identity?.IsAuthenticated != true)
    {
        <footer class="border-top footer text-muted py-5 bg-body-tertiary">
            <div class="container">
                <div class="row gy-4">
                    <div class="col-lg-4 col-md-6">
                        <div style="font-size: 1.5rem; margin-bottom: 1rem;">
                            <div class="ohrbob-logo">
                                <span class="ohrbob-logo-text">
                                    <span class="char-1">o</span><span class="char-2">h</span><span class="char-3">r</span><span class="char-4">b</span><span class="char-5">o</span><span class="char-6">b</span>
                                </span>
                            </div>
                        </div>
                        <p class="small text-muted">
                            The multi-platform, open-source podcast sync server and player. Organize your podcasts into stations and keep your listening state consistent everywhere.
                        </p>
                    </div>
                    
                    <div class="col-lg-2 col-md-3 col-6">
                        <h5 class="text-body mb-3">Product</h5>
                        <ul class="list-unstyled small mb-0">
                            <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="Features" class="text-muted text-decoration-none">Features</a></li>
                            <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="About" class="text-muted text-decoration-none">About</a></li>
                        </ul>
                    </div>

                    <div class="col-lg-2 col-md-3 col-6">
                        <h5 class="text-body mb-3">Resources</h5>
                        <ul class="list-unstyled small mb-0">
                            <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="SelfHost" class="text-muted text-decoration-none">Self-Hosting</a></li>
                            <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="Faq" class="text-muted text-decoration-none">FAQ</a></li>
                            <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="Status" class="text-muted text-decoration-none">Status</a></li>
                            <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-muted text-decoration-none">Privacy Policy</a></li>
                            <li class="mb-2"><a href="https://github.com/ohrbob-org/ohrbob.server" target="_blank" rel="noopener" class="text-muted text-decoration-none">Source Code</a></li>
                        </ul>
                    </div>

                    <div class="col-lg-4 col-md-12">
                        <h5 class="text-body mb-3">Community & Legal</h5>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <a href="https://github.com/ohrbob-org/" target="_blank" rel="noopener" class="text-muted text-decoration-none" title="ohrbob on GitHub">
                                <i class="bi bi-github" style="font-size: 1.5rem;"></i>
                            </a>
                        </div>
                        <ul class="list-unstyled small mb-0">
                            @if (LegalOptions.Value.IsConfigured)
                            {
                                <li class="mb-2"><a asp-area="" asp-controller="Home" asp-action="Legal" class="text-muted text-decoration-none">Legal & Privacy</a></li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </footer>
    }
    @if (User.Identity?.IsAuthenticated == true)
    {
        @await Component.InvokeAsync("PlayerWidget")
    }
    
    @await Component.InvokeAsync("ChangelogPopup")

    <!-- Reusable Confirmation Modal -->
    <div class="modal fade" id="confirmationModal" tabindex="-1" aria-labelledby="confirmationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmationModalLabel">Confirm Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-body" id="confirmationModalBody">
                    Are you sure?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="confirmationModalCancelBtn">Cancel</button>
                    <button type="button" class="btn btn-primary" id="confirmationModalConfirmBtn">OK</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Container for HTMX notifications -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
        <div id="liveToast" class="toast align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="toast-body-text">
                    Error message
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/station-opml-import.js" asp-append-version="true"></script>
    <script src="~/js/station-playhead.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
