<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ohrbob @ViewData["Title"]</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profiles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/collage.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ohrbob.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body hx-boost="true" hx-target="#main-content">
    <header style="z-index: 1040; position: relative;">
        <div class="floating-nav-pill">
            <!-- Left: Logo -->
            <a asp-area="" asp-controller="Home" asp-action="Index" style="display: flex; align-items: center;">
                <img src="~/images/ohrbob-logo.svg" alt="Ohrbob Logo" height="28" />
            </a>
            
            <!-- Center: Links (if auth'd) -->
            <div class="floating-nav-pill-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-area="" asp-controller="Discover" asp-action="Index">Discover</a>
                    <a asp-area="" asp-controller="Home" asp-action="Index">Listen</a>
                }
            </div>

            <!-- Right: Profile or Login -->
            <div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @await Component.InvokeAsync("ProfileSelector")
                }
                else
                {
                    <a asp-controller="Home" asp-action="Login" asp-route-provider="Nextcloud" class="btn btn-sm btn-outline-primary rounded-pill">Login</a>
                }
            </div>
        </div>
    </header>
    <div class="container" id="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted" style="@(User.Identity?.IsAuthenticated == true ? "margin-bottom: 100px;" : "")">
        <div class="container">
            &copy; 2026 - Ohrbob.Web
        </div>
    </footer>
    @if (User.Identity?.IsAuthenticated == true)
    {
        @await Component.InvokeAsync("PlayerWidget")
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
