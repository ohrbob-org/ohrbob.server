@using Microsoft.Extensions.Options
@using Ohrbob.Web.Configuration
@inject IOptions<LegalOptions> LegalOptions
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content="upgrade-insecure-requests">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | ohrbob</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profiles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/collage.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ohrbob.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body hx-boost="true" hx-target="#main-content" hx-history-elt="#main-content" class="@(User.Identity?.IsAuthenticated == true ? "with-player" : "")">
    <header>
        <div class="floating-nav-pill">
            <!-- Left: Logo -->
            <a asp-area="" asp-controller="Home" asp-action="Index" hx-boost="false" style="display: flex; align-items: center;">
                <div style="font-size: 2rem;    height: 1rem;    position: relative;    top: -.7rem;    left: -0.2rem;">
                    <div class="ohrbob-logo ohrbob-logo-left">
                        <span class="ohrbob-logo-icon">
                            <img src="~/images/ohrbob-logo.svg" alt="Icon">
                        </span>
                        <span class="ohrbob-logo-text">
                            <span class="char-1">o</span><span class="char-2">h</span><span class="char-3">r</span><span class="char-4">b</span><span class="char-5">o</span><span class="char-6">b</span>
                        </span>
                    </div>
                </div>
            </a>
            
            <!-- Center: Links (if auth'd) -->
            <div class="floating-nav-pill-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-area="" asp-controller="Discover" asp-action="Index">Discover</a>
                    <a asp-area="" asp-controller="Home" asp-action="Index">Listen</a>
                }
            </div>

            <!-- Right: Profile or Login -->
            <div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @await Component.InvokeAsync("ProfileSelector")
                }
                else
                {
                    <a asp-controller="Home" asp-action="Login" class="btn btn-primary rounded-pill" hx-boost="false">Login</a>
                }
            </div>
        </div>
    </header>
    <div class="container" id="main-content">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container d-flex justify-content-between align-items-center">
            
            <div style="font-size: 1rem;">
                <div class="ohrbob-logo">
                    <span class="ohrbob-logo-text">
                        <span class="char-1">o</span><span class="char-2">h</span><span class="char-3">r</span><span class="char-4">b</span><span class="char-5">o</span><span class="char-6">b</span>
                    </span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3">
                @if (LegalOptions.Value.IsConfigured)
                {
                    <a asp-area="" asp-controller="Home" asp-action="Legal" class="text-muted text-decoration-none small">Legal</a>
                }
                <a href="https://github.com/ohrbob-org/" target="_blank" rel="noopener" class="text-muted text-decoration-none" title="ohrbob on GitHub">
                    <i class="bi bi-github" style="font-size: 1.25rem;"></i>
                </a>
            </div>
        </div>
    </footer>
    @if (User.Identity?.IsAuthenticated == true)
    {
        @await Component.InvokeAsync("PlayerWidget")
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
