# Authentication - Google OIDC (OpenID Connect)
# Required if you want users to be able to log in with Google.
Oidc__Google__Authority=https://accounts.google.com
Oidc__Google__ClientId=your_google_client_id_here
Oidc__Google__ClientSecret=your_google_client_secret_here

# Authentication - Nextcloud OIDC
# Required if you want users to be able to log in via a Nextcloud instance.
Oidc__Nextcloud__Authority=https://your-nextcloud-instance.com
Oidc__Nextcloud__ClientId=your_nextcloud_client_id_here
Oidc__Nextcloud__ClientSecret=your_nextcloud_client_secret_here

# API Connection
# The base URL to the Ohrbob API. 
# If running via docker-compose (internal network), use: http://ohrbob.api:8080/api
# If running locally directly on the host, use: http://localhost:5001/api
OhrbobApi__BaseUrl=http://localhost:5001/api

# The API key required to authenticate with the API 
# This MUST match the 'ApiKeys__0__Key' value defined in Ohrbob.Api/.env
OhrbobApi__ApiKey=your_secret_api_key_hereOhrbobApi__PlayerApiUrl=http://localhost:5241


# Podcast Index Api Key for discovery
PodcastIndex__ApiKey=your_secret_api_key
PodcastIndex__ApiSecret=your_secret_api_secret