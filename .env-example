# Ohrbob — top-level environment template.
# Copy to `.env` and adjust values, then run `docker compose up --build`.
#   cp .env-example .env
# Docker Compose automatically loads the top-level `.env` for variable
# interpolation, and each service also gets it via `env_file` + explicit
# `environment` mappings in docker-compose.yml.
#
# NOTE for local `dotnet run` (without Docker): override the Docker-internal
# hostnames below with localhost equivalents, e.g.
#   MongoDbData__ConnectionString=mongodb://localhost:27017/OhrbobData
#   MongoDbLogs__ConnectionString=mongodb://localhost:27017/OhrbobLogs
#   OhrbobApi__BaseUrl=http://localhost:5001/api
#   OhrbobApi__PlayerApiUrl=http://localhost:5002
# You can export them in your shell or use a per-project `.env` loader.

# ---------------------------------------------------------------------------
# Compose / build knobs
# ---------------------------------------------------------------------------
# Optional registry prefix for built images (e.g. ghcr.io/myorg/).
DOCKER_REGISTRY=
GIT_COMMIT=dev-local
RELEASE_TAG=beta

# Host ports (host:container). Container ports are always 27017 (mongo) / 8080 (apps).
MONGO_PORT=27019
API_PORT=5001
PLAYER_PORT=5002
WEB_PORT=5003

# ASP.NET Core environment inside containers.
ASPNETCORE_ENVIRONMENT=Development

# ---------------------------------------------------------------------------
# MongoDB (shared by Api + Player; used for interpolation in compose)
# ---------------------------------------------------------------------------
MongoDbData__ConnectionString=mongodb://mongodb:27017/OhrbobData
MongoDbData__DatabaseName=OhrbobData
MongoDbLogs__ConnectionString=mongodb://mongodb:27017/OhrbobLogs
MongoDbLogs__DatabaseName=OhrbobLogs

# ---------------------------------------------------------------------------
# Ohrbob.Api — API key auth (consumed by Api, key copied to Web below)
# ---------------------------------------------------------------------------
# Define keys allowed to access the API. The Web project needs the matching key.
ApiKeys__0__Key=your_secret_api_key_here
ApiKeys__0__Name=web
ApiKeys__0__Scopes__0=all

# ---------------------------------------------------------------------------
# Ohrbob.Web — API connection (consumed by Web)
# ---------------------------------------------------------------------------
# Internal compose-network URL (services talk to each other by service name).
# For local `dotnet run` on the host, use: http://localhost:5001/api
OhrbobApi__BaseUrl=http://ohrbob.api:8080/api
# MUST match ApiKeys__0__Key above.
OhrbobApi__ApiKey=your_secret_api_key_here
# Internal compose-network URL of the Player service.
# For local `dotnet run` on the host, use: http://localhost:5002
OhrbobApi__PlayerApiUrl=http://ohrbob.player:8080

# ---------------------------------------------------------------------------
# Ohrbob.Web — Authentication: Google OIDC (consumed by Web)
# ---------------------------------------------------------------------------
# Required if users should log in with Google.
Oidc__Google__Authority=https://accounts.google.com
Oidc__Google__ClientId=your_google_client_id_here
Oidc__Google__ClientSecret=your_google_client_secret_here

# ---------------------------------------------------------------------------
# Ohrbob.Web — Authentication: Nextcloud OIDC (consumed by Web)
# ---------------------------------------------------------------------------
# Required if users should log in via a Nextcloud instance.
Oidc__Nextcloud__Authority=https://your-nextcloud-instance.com
Oidc__Nextcloud__ClientId=your_nextcloud_client_id_here
Oidc__Nextcloud__ClientSecret=your_nextcloud_client_secret_here

# ---------------------------------------------------------------------------
# Ohrbob.Web — Authentication: GitHub OAuth (consumed by Web)
# ---------------------------------------------------------------------------
# Required if users should log in with GitHub.
# Create a GitHub OAuth App (https://github.com/settings/developers) and set
# the Authorization callback URL to https://<your-host>/signin-github
Oidc__GitHub__ClientId=your_github_client_id_here
Oidc__GitHub__ClientSecret=your_github_client_secret_here

# ---------------------------------------------------------------------------
# Ohrbob.Web — Legal notice (Impressum) & Terms (consumed by Web)
# ---------------------------------------------------------------------------
# The legal page (/Home/Legal) and footer link are only shown when Legal__Show=true.
Legal__Show=false
Legal__Name=your_full_name_here
Legal__Address=your_street_and_city_here
Legal__Email=your_email_here

# ---------------------------------------------------------------------------
# Ohrbob.Web — PodcastIndex discovery (consumed by Web)
# ---------------------------------------------------------------------------
PodcastIndex__ApiKey=your_podcastindex_key_here
PodcastIndex__ApiSecret=your_podcastindex_secret_here
