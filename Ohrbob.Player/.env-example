# MongoDB Configuration for Application Data
# The connection string to your MongoDB instance (use localhost:27017 for local development, or mongodb:27017 in Docker)
MongoDbData__ConnectionString=mongodb://localhost:27017/OhrbobData
MongoDbData__DatabaseName=OhrbobData

# MongoDB Configuration for Logs
# The connection string to your MongoDB instance for Serilog logs
MongoDbLogs__ConnectionString=mongodb://localhost:27017/OhrbobLogs
MongoDbLogs__DatabaseName=OhrbobLogs